---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import BarraApp from '../components/BarraApp.astro';
import { config } from '../config';

interface Props {
  title: string;
  description: string;
  schema?: object[];
  crumbs?: [string, string][]; // [nome, url]
  noindex?: boolean; // páginas que não devem ir para o Google (404, rascunhos)
}
const { title, description, schema = [], crumbs = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const site = Astro.site!.href.replace(/\/$/, '');

const ld: object[] = [...schema];
if (crumbs.length) {
  ld.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [['Início', '/'], ...crumbs].map(([name, url], i) => ({
      '@type': 'ListItem', position: i + 1, name, item: site + url,
    })),
  });
}
---
<!doctype html>
<html lang="pt-BR" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <script is:inline>try{var t=localStorage.getItem("tema");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="MKT Center" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:image" content={site + "/og.png"} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="MKT Center, agência de marketing digital" />
  <meta name="theme-color" content="#090a0c" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content={config.nome} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={site + "/og.png"} />
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- fontes sem bloquear a renderização -->
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=DM+Sans:wght@400;600;700&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=DM+Sans:wght@400;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=DM+Sans:wght@400;600;700&display=swap" rel="stylesheet" /></noscript>
  {ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <!-- Google Analytics 4 (G-WHXPL9H3WL): carrega depois da página para não pesar no carregamento -->
  <script is:inline>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
    gtag('js',new Date());gtag('config','G-WHXPL9H3WL');
    addEventListener('load',function(){setTimeout(function(){var s=document.createElement('script');s.async=true;s.src='https://www.googletagmanager.com/gtag/js?id=G-WHXPL9H3WL';document.head.appendChild(s)},1500)});
    // contatos: clique no WhatsApp, telefone e e-mail viram eventos (para marcar como conversão no GA4)
    addEventListener('click',function(e){var a=e.target.closest&&e.target.closest('a[href]');if(!a)return;var h=a.href;
      if(h.indexOf('wa.me/')>-1)gtag('event','clique_whatsapp',{pagina:location.pathname});
      else if(h.indexOf('tel:')===0)gtag('event','clique_telefone',{pagina:location.pathname});
      else if(h.indexOf('mailto:')===0)gtag('event','clique_email',{pagina:location.pathname});});
  </script>
</head>
<body>
  <div class="fundo-site" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <Header />
  <main>
    {crumbs.length > 0 && (
      <div class="wrap" style="padding-top:28px">
        <nav class="breadcrumb" aria-label="Você está em">
          <a href="/">Início</a>{crumbs.map(([n, u]) => <> › <a href={u}>{n}</a></>)}
        </nav>
      </div>
    )}
    <slot />
  </main>
  <Footer />
  <BotaoWhatsApp />
  <BarraApp />
  <script>
    // luz que segue o mouse nos cards (efeito do tema claro)
    if (matchMedia('(hover:hover)').matches) addEventListener('pointermove', (e) => {
      const c = (e.target as Element)?.closest?.('.card,.st-card,.pf,.pr-card,.pq-card,.dp-item,.ap-preco') as HTMLElement | null;
      if (!c) return;
      const r = c.getBoundingClientRect();
      c.style.setProperty('--mx', `${e.clientX - r.left}px`);
      c.style.setProperty('--my', `${e.clientY - r.top}px`);
    }, { passive: true });
  </script>
</body>
</html>
