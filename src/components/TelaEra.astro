  .h-graf i{flex:1;border-radius:0.46cqw 0.46cqw 0 0;background:linear-gradient(180deg,#ffb35c,#ff6900);box-shadow:0 0 1.37cqw rgba(255,105,0,.5)}
  .clive{background:#000;color:#fff;font-family:var(--ff-txt);font-size:4.4cqw}
