  .h-kpis b{font-family:var(--ff-tit);font-size:2.96cqw}
  .h-ia{display:flex;gap:1.14cqw;align-items:center;padding:1.37cqw;border-radius:1.14cqw;background:linear-gradient(90deg,rgba(255,105,0,.18),rgba(255,105,0,.04));border:1px solid rgba(255,138,36,.4)}
  .h-bot{flex:none;display:grid;place-items:center;width:3.88cqw;height:3.88cqw;border-radius:50%;background:#ff6900;color:#141006;font-weight:800;font-size:1.48cqw}
  .h-dig{margin:0;overflow:hidden;white-space:nowrap;border-right:2px solid #ff8a24;max-width:0}
  .h-dig{animation:ev-dig 2.4s steps(42) .9s forwards}
  @keyframes ev-dig{to{max-width:100%}}
