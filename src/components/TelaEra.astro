  .o-menu{display:flex;gap:3.00cqw;padding:0.90cqw 2.40cqw;background:#dcdcdc;border-bottom:1px solid #999}
  .o-menu a{color:#00c;text-decoration:underline}
  .o-marq{overflow:hidden;white-space:nowrap;background:#ffff99;color:#c00;font-weight:bold;padding:0.60cqw 0}
  .o-marq span{display:inline-block;padding-left:100%;animation:ev-marq 8s linear infinite}
  @keyframes ev-marq{to{transform:translateX(-100%)}}
  .o-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.80cqw;padding:2.10cqw 2.40cqw;flex:1;min-height:0}
  .o-grid div{display:flex;flex-direction:column;gap:0.60cqw;padding:0.90cqw;background:#fff;border:1px solid #bbb;min-height:0}
  .o-grid img{flex:1;min-height:0;border:1px solid #999}
  .o-grid a{color:#00c;text-decoration:underline}
  .o-grid b{color:#c00}
  .o-grid u{text-decoration:none;text-align:center;background:linear-gradient(#ffb347,#e67e00);border:1px outset #f90;color:#fff;font-weight:bold}
  .o-rod{padding:0.75cqw 2.40cqw;font-size:1.80cqw;color:#666;background:#dcdcdc}
