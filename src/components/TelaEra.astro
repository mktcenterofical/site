  .l-ao{background:#e53935;padding:.4em .9em;border-radius:.4em;font-weight:800;animation:l-pis 1.2s steps(1) infinite}
  @keyframes l-pis{50%{opacity:.55}}
  .l-vis{background:rgba(0,0,0,.5);padding:.4em .9em;border-radius:.4em}
  .l-chat{position:absolute;left:4cqw;bottom:22cqw;right:28cqw;height:40cqw;overflow:hidden;mask-image:linear-gradient(transparent,#000 40%);-webkit-mask-image:linear-gradient(transparent,#000 40%)}
  .l-chat p{margin:0 0 1.6cqw;padding:.3em .7em;border-radius:1em;background:rgba(0,0,0,.45);width:fit-content;animation:l-sobe 6s linear infinite}
  .l-chat p:nth-child(2){animation-delay:-1.5s}.l-chat p:nth-child(3){animation-delay:-3s}.l-chat p:nth-child(4){animation-delay:-4.5s}
  @keyframes l-sobe{0%{transform:translateY(40cqw);opacity:0}15%{opacity:1}100%{transform:translateY(-10cqw);opacity:0}}
  .l-cor{position:absolute;right:6cqw;bottom:22cqw;width:12cqw;height:60cqw}
  .l-cor i{position:absolute;bottom:0;left:30%;font-style:normal;color:#ff6900;font-size:7cqw;animation:l-cor 3s ease-out infinite}
  .l-cor i:nth-child(2){animation-delay:-.75s;color:#ff3d7f}.l-cor i:nth-child(3){animation-delay:-1.5s}.l-cor i:nth-child(4){animation-delay:-2.25s;color:#ffb35c}
  @keyframes l-cor{0%{transform:translate(0,0) scale(.6);opacity:0}20%{opacity:1}100%{transform:translate(-4cqw,-55cqw) scale(1.2);opacity:0}}
  .l-bt{position:absolute;left:4cqw;right:4cqw;bottom:5cqw;text-align:center;padding:.7em;border-radius:99px;background:#ff6900;color:#141006;font-weight:800}
</style>
