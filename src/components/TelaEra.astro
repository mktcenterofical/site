  .f-nav{display:flex;align-items:center;gap:3.00cqw;padding:1.75cqw 3.00cqw}
  .f-nav b{margin-right:auto;font-size:2.75cqw;color:#e17055}
  .f-hero{position:relative;height:52%;flex:none}
  .f-hero div{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1.75cqw;background:rgba(0,0,0,.42);color:#fff}
  .f-hero strong{font-size:4.50cqw;font-weight:300;letter-spacing:.05em}
  .f-hero em{font-style:normal;padding:1.00cqw 3.25cqw;background:#e17055;font-size:1.88cqw;text-transform:uppercase;letter-spacing:.1em}
