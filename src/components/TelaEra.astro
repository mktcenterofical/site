<style is:global>
  .ev-c{position:absolute;inset:0;display:flex;flex-direction:column;text-align:left;overflow:hidden}
  .ev-c img{display:block;width:100%;height:100%;object-fit:cover}
  .c2013{background:#f2f2f2;font-family:Verdana,Tahoma,sans-serif;font-size:2.33cqw;color:#222}
  .o-top{display:flex;justify-content:space-between;align-items:center;padding:1.50cqw 2.40cqw;background:linear-gradient(180deg,#4f7fc0,#1f4f96);color:#fff}
