  .f-cols div{display:flex;flex-direction:column;align-items:center;gap:1.00cqw}
  .f-cols i{width:6.25cqw;height:6.25cqw;border-radius:50%;background:#e17055}
  .f-cols span{height:1.13cqw;width:80%;background:#dfe6e9}
  .c2019{background:#fff;color:#262626;font-family:var(--ff-txt);font-size:7.13cqw}
  .s-top{display:flex;justify-content:space-between;padding:12.40cqw 8.06cqw 4.96cqw;font-size:8.06cqw}
  .s-stories{display:flex;gap:4.96cqw;padding:0 8.06cqw 6.20cqw;border-bottom:1px solid #eee}
