---
// Hero cinematográfico: textos animados à esquerda e, à direita, um aparelho 3D que vira desktop,
// notebook, tablet e celular. Em cada aparelho um projeto (site, loja, sistema, app) é "construído"
// peça por peça, simulando a criação. Nomes de clientes são fictícios — ver CLAUDE.md.
import { waLink } from '../config';
import Icon from './Icon.astro';
const dispositivos = [
  { id: 'desktop', nome: 'Desktop', projeto: 'Site institucional', icone: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>' },
  { id: 'notebook', nome: 'Notebook', projeto: 'Loja virtual', icone: '<rect x="4" y="4" width="16" height="11" rx="2"/><path d="M2 19h20"/>' },
  { id: 'tablet', nome: 'Tablet', projeto: 'Sistema de agendamento', icone: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/>' },
  { id: 'celular', nome: 'Celular', projeto: 'Aplicativo de delivery', icone: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>' },
];
const dias = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex'];
const agenda: [number, number, number, string][] = [
  [0, 1, 2, 'Corte'], [1, 0, 1, 'Barba'], [1, 3, 2, 'Coloração'], [2, 2, 1, 'Corte'],
  [3, 0, 2, 'Escova'], [3, 4, 1, 'Corte'], [4, 1, 1, 'Barba'], [4, 3, 2, 'Manicure'], [0, 4, 1, 'Corte'],
];
---
<section class="hc" id="hero" data-dispositivos={JSON.stringify(dispositivos.map((d) => [d.id, d.nome, d.projeto]))}>
  <div class="hc-glow" aria-hidden="true"></div>
  <div class="hc-grid" aria-hidden="true"></div>
  <div class="hc-lines" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="wrap hc-in">
    <div class="hc-txt">
      <span class="eyebrow hc-r">Agência de marketing digital</span>
      <h1 class="hc-h1">
        <span class="hc-line"><span class="hc-w">Seu</span> <span class="hc-w">negócio</span></span>
        <span class="hc-line"><span class="hc-w">com</span> <span class="hc-w">tecnologia</span></span>
        <span class="hc-line"><span class="hc-w hc-or">avançada</span></span>
      </h1>
      <p class="hc-lead hc-r">Criamos sites, apps, lojas virtuais e campanhas que trazem clientes para o seu WhatsApp. Cada contato medido, cada resultado na tela.</p>
      <div class="acoes hc-r">
        <a class="btn btn-primary" href={waLink()} target="_blank" rel="noopener">Quero meu orçamento</a>
        <a class="btn hc-ghost" href="#servicos">Ver serviços</a>
      </div>
      <ul class="hc-stats hc-r">
        <li><b><span class="hc-n" data-to="180">0</span>+</b><small>projetos entregues</small></li>
        <li><b><span class="hc-n" data-to="98">0</span>%</b><small>clientes satisfeitos</small></li>
        <li><b><span class="hc-n" data-to="2">0</span>h</b><small>para responder</small></li>
      </ul>
    </div>

    <div class="hc-stage" data-mode="desktop">
      <div class="hc-pc">
        <div class="hc-dev">
          <div class="hc-bezel">
            <div class="hc-screen" aria-hidden="true">
              <div class="hc-glare"></div>
              <div class="hc-island"></div>

              <!-- Desktop: site institucional -->
              <div class="pj pj-site" data-p="desktop">
                <div class="bar"><i></i><i></i><i></i><span>padariapaodourado.com.br</span></div>
                <div class="pg">
                  <div class="nav b"><span class="lg">Pão Dourado</span><span class="mn">Início</span><span class="mn">Cardápio</span><span class="mn">Contato</span><span class="bt">Pedir</span></div>
                  <div class="sh">
                    <div class="sh-t">
                      <small class="b ey">Padaria artesanal desde 1998</small>
                      <p class="b ttl ty">Pão quentinho todo dia</p>
                      <p class="b tx">Fornadas às 6h, 11h e 17h. Peça pelo WhatsApp e retire sem fila.</p>
                      <span class="b bt">Pedir no WhatsApp</span>
                    </div>
                    <div class="b ph"><img src="/mock/padaria.webp" alt="" width="640" height="400" loading="lazy" decoding="async" /></div>
                  </div>
                  <div class="cards">
                    {[['pao', 'Pães artesanais'], ['croissant', 'Croissants'], ['bolo', 'Bolos e tortas']].map(([img, t]) => (
                      <div class="b cd"><div class="ph"><img src={`/mock/${img}.webp`} alt="" width="320" height="220" loading="lazy" decoding="async" /></div><b>{t}</b></div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Notebook: loja virtual -->
              <div class="pj pj-loja" data-p="notebook">
                <div class="bar"><i></i><i></i><i></i><span>rsmodafitness.com.br</span></div>
                <div class="pg">
                  <div class="nav b"><span class="lg">RS Moda</span><span class="mn">Feminino</span><span class="mn">Masculino</span><span class="cart"><Icon name="cart" size={12} /> 2</span></div>
                  <div class="b banner">
                    <img src="/mock/fitness1.webp" alt="" width="640" height="260" loading="lazy" decoding="async" />
                    <div><small>Coleção nova</small><p class="ty">20% off no Pix</p></div>
                  </div>
                  <div class="prods">
                    {[['moletom', 'Moletom Basic', 'R$ 129,90'], ['fitness2', 'Calça Jogger', 'R$ 89,90'], ['modelo', 'Casaco Inverno', 'R$ 199,90']].map(([img, n, p]) => (
                      <div class="b pd"><div class="ph"><img src={`/mock/${img}.webp`} alt="" width="320" height="360" loading="lazy" decoding="async" /></div><span>{n}</span><b>{p}</b></div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Tablet: sistema de agendamento -->
              <div class="pj pj-sis" data-p="tablet">
                <div class="pg">
                  <div class="b sis-top"><span class="lg">Studio Bella</span><span class="bt">+ Agendar</span></div>
                  <div class="b sis-cover"><img src="/mock/salao.webp" alt="" width="480" height="220" loading="lazy" decoding="async" /><p class="ty">Agenda da semana</p></div>
                  <div class="b sis-next">
                    <img class="av" src="/mock/pessoa1.webp" alt="" width="96" height="96" loading="lazy" decoding="async" />
                    <div><small>Próximo atendimento · 14h</small><b>Ana Paula · Coloração</b></div>
                  </div>
                  <div class="b sis-next">
                    <img class="av" src="/mock/pessoa2.webp" alt="" width="96" height="96" loading="lazy" decoding="async" />
                    <div><small>15h30</small><b>Marcos · Corte e barba</b></div>
                  </div>
                  <div class="cal">
                    {dias.map((d) => <span class="dia">{d}</span>)}
                    {agenda.map(([c, r, h, t]) => (
                      <div class="b ev" style={`grid-column:${c + 1};grid-row:${r + 2} / span ${h}`}>{t}</div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Celular: app de delivery -->
              <div class="pj pj-app" data-p="celular">
                <div class="pg">
                  <div class="b app-top"><small>Entregar em</small><b>Rua das Flores, 120</b></div>
                  <div class="b promo"><img src="/mock/cafe.webp" alt="" width="480" height="240" loading="lazy" decoding="async" /><p class="ty">Café da manhã -20%</p></div>
                  <div class="chips"><span class="b on">Lanches</span><span class="b">Pizza</span><span class="b">Bowls</span></div>
                  {[['burger', 'Burger da Casa', 'R$ 32,90'], ['pizza', 'Pizza Calabresa', 'R$ 54,90'], ['acai', 'Poke Bowl', 'R$ 38,90']].map(([img, n, p]) => (
                    <div class="b item"><img src={`/mock/${img}.webp`} alt="" width="160" height="160" loading="lazy" decoding="async" /><div><b>{n}</b><small>{p}</small></div><span class="add">+</span></div>
                  ))}
                  <div class="b tabbar"><i></i><i class="on"></i><i></i><i></i></div>
                </div>
              </div>

              <span class="hc-cursor"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 2l16 9-7 2-3 7z" fill="#fff" stroke="#141006" stroke-width="1.5" stroke-linejoin="round" /></svg></span>
              <div class="hc-status"><span class="hc-st-txt">Criando site…</span><span class="hc-st-pct">0%</span><i class="hc-st-bar"></i></div>
            </div>
          </div>
        </div>
        <div class="hc-neck" aria-hidden="true"></div>
        <div class="hc-base" aria-hidden="true"></div>
        <div class="hc-kb" aria-hidden="true"></div>

        <div class="hc-badge hc-b1"><span class="hc-bi"><Icon name="message" size={18} /></span><div><b>Novo contato</b><em>via WhatsApp · agora</em></div></div>
        <div class="hc-badge hc-b2"><span class="hc-bi hc-bi-g"><Icon name="check" size={18} /></span><div><b id="hc-dev-nome">Site institucional</b><em id="hc-dev-sub">Desktop · layout adaptado</em></div></div>
      </div>
      <div class="hc-modes" role="tablist" aria-label="Dispositivo">
        {dispositivos.map((d, i) => (
          <button type="button" role="tab" class={i === 0 ? 'on' : ''} data-m={i} aria-label={d.nome}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={d.icone} />
            <span>{d.nome}</span>
          </button>
        ))}
      </div>
      <p class="hc-note">Um só projeto, perfeito em todas as telas</p>
    </div>
  </div>
</section>

<style>
  .hc{position:relative;overflow:hidden;background:var(--carbon);color:#fff;padding:56px 0 72px;isolation:isolate}
  @media(min-width:1024px){.hc{padding:72px 0 96px;min-height:calc(100vh - 122px);display:flex;align-items:center}}
  .hc-glow{position:absolute;inset:-20%;z-index:-1;background:radial-gradient(600px 420px at 75% 45%,rgba(255,105,0,.28),transparent 65%),radial-gradient(500px 360px at 10% 90%,rgba(255,138,36,.12),transparent 70%)}
  .hc-grid{position:absolute;inset:0;z-index:-1;background-size:56px 56px;background-image:linear-gradient(to right,rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,.05) 1px,transparent 1px);mask-image:radial-gradient(ellipse at 60% 50%,#000 0%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse at 60% 50%,#000 0%,transparent 70%)}
  .hc-lines{position:absolute;inset:0;z-index:-1;pointer-events:none}
  .hc-lines i{position:absolute;height:2px;width:220px;background:linear-gradient(90deg,transparent,#ff6900,transparent);transform:skewX(-30deg);opacity:.5;animation:hc-speed 5s linear infinite}
  .hc-lines i:nth-child(1){top:18%;animation-delay:0s}
  .hc-lines i:nth-child(2){top:62%;animation-delay:1.7s;width:160px}
  .hc-lines i:nth-child(3){top:84%;animation-delay:3.2s}
  @keyframes hc-speed{from{left:-20%}to{left:110%}}

  .hc-in{display:grid;gap:48px;align-items:center;width:100%}
  @media(min-width:1024px){.hc-in{grid-template-columns:1fr 1.1fr;gap:32px}}

  .hc .eyebrow{color:var(--orange-hot)}
  .hc-h1{font-size:clamp(46px,5.6vw,76px);line-height:.9;letter-spacing:-.02em;display:flex;flex-direction:column}
  .hc-line{display:block;overflow:hidden;padding-bottom:.04em}
  .hc-w{display:inline-block}
  .hc-or{background:linear-gradient(180deg,#ff8a24,#ff6900);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;filter:drop-shadow(0 8px 24px rgba(255,105,0,.35))}
  .hc-lead{color:#aeb4bd;font-size:18px;line-height:28px;max-width:52ch;margin-top:24px}
  .hc-ghost{border-color:#5b616b;color:#fff}
  .hc-ghost:hover{border-color:#fff}
  .hc-stats{list-style:none;display:flex;gap:28px;margin-top:40px;flex-wrap:wrap}
  .hc-stats b{display:block;font-family:var(--ff-tit);font-weight:800;font-size:40px;line-height:1}
  .hc-stats small{color:#aeb4bd;font-size:14px}

  /* ---------- aparelho que muda de forma ---------- */
  .hc-stage{position:relative;margin-top:32px;perspective:1600px;display:flex;flex-direction:column;align-items:center}
  @media(min-width:1024px){.hc-stage{margin-top:0}}
  .hc-pc{position:relative;width:min(100%,600px);aspect-ratio:5/4;transform-style:preserve-3d;transform:rotateY(-12deg) rotateX(5deg);will-change:transform}
  .hc-dev{--ease:cubic-bezier(.7,0,.2,1);position:absolute;left:50%;transform:translateX(-50%);bottom:var(--b);width:var(--w);height:var(--h);transition:width .9s var(--ease),height .9s var(--ease),bottom .9s var(--ease)}
  .hc-bezel{position:absolute;inset:0;padding:var(--p);border-radius:var(--r);background:linear-gradient(160deg,#3a3d44,#16181c 40%,#0c0d10);box-shadow:0 60px 120px -30px rgba(0,0,0,.9),0 0 0 1px rgba(255,255,255,.08),inset 0 1px 1px rgba(255,255,255,.18),40px 30px 80px -40px rgba(255,105,0,.45);transition:padding .9s var(--ease),border-radius .9s var(--ease)}
  .hc-screen{position:relative;width:100%;height:100%;border-radius:calc(var(--r) - var(--p) + 2px);overflow:hidden;background:#f6f4f1;container-type:size;transition:border-radius .9s var(--ease)}
  .hc-glare{position:absolute;inset:0;z-index:8;pointer-events:none;background:linear-gradient(115deg,rgba(255,255,255,.16) 0%,rgba(255,255,255,0) 40%)}
  .hc-island{position:absolute;z-index:9;top:6px;left:50%;width:34%;height:16px;border-radius:99px;background:#000;transform:translateX(-50%) scale(var(--isl,0));transition:transform .6s}
  .hc-neck,.hc-base,.hc-kb{position:absolute;left:50%;transform:translateX(-50%);opacity:0;transition:opacity .4s}
  .hc-neck{bottom:3%;width:14%;height:16%;background:linear-gradient(90deg,#1b1d22,#4a4e57 50%,#1b1d22);clip-path:polygon(12% 0,88% 0,100% 100%,0 100%)}
  .hc-base{bottom:1%;width:36%;height:2.5%;border-radius:8px 8px 14px 14px;background:linear-gradient(180deg,#4a4e57,#17191d);box-shadow:0 30px 40px -10px rgba(0,0,0,.9)}
  .hc-kb{bottom:9%;width:100%;height:4%;border-radius:2px 2px 16px 16px;background:linear-gradient(180deg,#5a5e67,#1c1e23);box-shadow:0 30px 40px -10px rgba(0,0,0,.9)}
  .hc-kb::after{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:16%;height:40%;border-radius:0 0 8px 8px;background:#2a2d33}

  .hc-stage[data-mode="desktop"]{--w:100%;--h:78%;--b:18%;--p:10px;--r:16px}
  .hc-stage[data-mode="desktop"] .hc-neck,.hc-stage[data-mode="desktop"] .hc-base{opacity:1;transition-delay:.6s}
  .hc-stage[data-mode="notebook"]{--w:84%;--h:67%;--b:13%;--p:10px;--r:14px}
  .hc-stage[data-mode="notebook"] .hc-kb{opacity:1;transition-delay:.6s}
  .hc-stage[data-mode="tablet"]{--w:52%;--h:88%;--b:6%;--p:14px;--r:28px}
  .hc-stage[data-mode="celular"]{--w:32%;--h:86%;--b:7%;--p:8px;--r:34px;--isl:1}

  .hc-modes{display:flex;gap:6px;margin-top:20px;padding:5px;border-radius:999px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08)}
  .hc-modes button{display:flex;align-items:center;gap:6px;min-height:40px;padding:0 14px;border:0;border-radius:999px;background:none;color:#aeb4bd;font:inherit;font-size:13px;font-weight:700;cursor:pointer;transition:background .3s,color .3s}
  .hc-modes button.on{background:#ff6900;color:#141006}
  @media(max-width:520px){.hc-modes button span{display:none}.hc-modes button.on span{display:inline}}
  .hc-note{margin-top:14px;font-size:13px;color:#aeb4bd}

  /* ---------- projetos dentro da tela ---------- */
  .pj{position:absolute;inset:0;display:none;flex-direction:column;color:#1b1d22;font-size:clamp(7px,2.1cqw,12px);line-height:1.25}
  .hc-stage[data-mode="desktop"] .pj-site,.hc-stage[data-mode="notebook"] .pj-loja,
  .hc-stage[data-mode="tablet"] .pj-sis,.hc-stage[data-mode="celular"] .pj-app{display:flex}
  .pj img{display:block;width:100%;height:100%;object-fit:cover}
  .bar{display:flex;align-items:center;gap:.5em;padding:.6em .9em;background:#e7e4e0;border-bottom:1px solid #d8d4cf}
  .bar i{width:.7em;height:.7em;border-radius:50%;background:#c9c4be}
  .bar i:first-child{background:#ff6b5e}
  .bar span{margin-left:.6em;flex:1;max-width:60%;padding:.25em .9em;border-radius:99px;background:#fff;color:#6b6f76;font-size:.85em}
  .pg{flex:1;min-height:0;padding:3cqh 4cqw 9cqh;display:flex;flex-direction:column;gap:2.6cqh;overflow:hidden}
  .nav{display:flex;align-items:center;gap:1.4em;padding:.3em 0}
  .mn{color:#55585f;font-weight:600;font-size:.9em}
  .lg{font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:1.3em;margin-right:auto;color:#141006}
  .bt{display:inline-block;background:#ff6900;color:#141006;font-weight:800;border-radius:99px;padding:.45em 1em;font-size:.9em;white-space:nowrap}
  .ph{border-radius:8px;overflow:hidden;background:#e4e0db}

  .sh{display:grid;grid-template-columns:1fr 1.05fr;grid-template-rows:minmax(0,1fr);gap:4cqw;flex:1;min-height:0}
  .sh-t{display:flex;flex-direction:column;justify-content:center;gap:1.6cqh;align-items:flex-start;min-height:0}
  .ey{color:#a84300;font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-size:.75em}
  .ttl{font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:2.3em;line-height:.95;color:#141006;min-height:1.9em}
  .tx{color:#55585f;font-size:.9em;max-width:26ch}
  .sh .ph{min-height:0}
  .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:3cqw;height:22cqh;flex:none}
  .cd{background:#fff;border-radius:10px;padding:.45em;display:flex;flex-direction:column;gap:.4em;box-shadow:0 4px 14px rgba(0,0,0,.08)}
  .cd .ph{flex:1;min-height:0}
  .cd b{font-weight:800;font-size:.9em}

  .cart{display:inline-flex;align-items:center;gap:.3em;font-weight:800;background:#141006;color:#fff;border-radius:99px;padding:.3em .8em}
  .banner{position:relative;border-radius:10px;overflow:hidden;height:26cqh;flex:none;background:#141006}
  .banner img{position:absolute;inset:0;opacity:.75}
  .banner div{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;padding:0 5%;background:linear-gradient(90deg,rgba(20,16,6,.9),rgba(20,16,6,0) 70%)}
  .banner small{color:#ff8a24;font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-size:.8em}
  .banner p{font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:2.2em;color:#fff;line-height:1;min-height:1em}
  .prods{display:grid;grid-template-columns:repeat(3,1fr);gap:2.5cqw;flex:1;min-height:0}
  .pd{background:#fff;border-radius:10px;padding:.45em;display:flex;flex-direction:column;gap:.3em;box-shadow:0 4px 14px rgba(0,0,0,.08);min-height:0}
  .pd .ph{flex:1;min-height:0}
  .pd span{font-weight:600;font-size:.9em}
  .pd b{font-weight:800;color:#a84300}

  .pj-sis .pg{padding-top:7cqh;gap:2cqh}
  .sis-top{display:flex;align-items:center;justify-content:space-between}
  .sis-cover{position:relative;height:16cqh;flex:none;border-radius:12px;overflow:hidden;background:#e4e0db}
  .sis-cover p{position:absolute;left:0;right:0;bottom:0;padding:1.2em .8em .5em;background:linear-gradient(transparent,rgba(0,0,0,.7));color:#fff;font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:1.5em;min-height:2.6em}
  .sis-next{display:flex;align-items:center;gap:.7em;background:#fff;border-radius:12px;padding:.5em .7em;box-shadow:0 4px 14px rgba(0,0,0,.08)}
  .av{width:2.8em !important;height:2.8em !important;border-radius:50%;flex:none}
  .sis-next small{display:block;color:#a84300;font-weight:700;font-size:.85em}
  .sis-next b{font-weight:800}
  .cal{flex:1;min-height:0;display:grid;grid-template-columns:repeat(5,1fr);grid-template-rows:auto repeat(5,1fr);gap:1.4cqw;background:#fff;border-radius:12px;padding:3cqw;box-shadow:0 4px 14px rgba(0,0,0,.08)}
  .dia{text-align:center;font-weight:800;color:#6b6f76;font-size:.85em}
  .ev{border-radius:6px;background:#fff1e6;box-shadow:inset 3px 0 #ff6900;color:#a84300;font-weight:700;font-size:.75em;padding:.3em .4em;overflow:hidden}
  .ev:nth-child(3n){background:#e8f7ef;box-shadow:inset 3px 0 #0b7544;color:#0b7544}

  .pj-app{font-size:clamp(8px,6cqw,12px)}
  .pj-app .pg{padding:9cqh 5cqw 0;gap:1.8cqh}
  .app-top small{display:block;color:#6b6f76;font-size:.85em}
  .app-top b{font-weight:800}
  .promo{position:relative;height:15cqh;flex:none;border-radius:12px;overflow:hidden;background:#e4e0db}
  .promo p{position:absolute;inset:auto 0 0 0;padding:1.4em .8em .5em;background:linear-gradient(transparent,rgba(0,0,0,.75));color:#fff;font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:1.35em;min-height:2.6em}
  .chips{display:flex;gap:.5em}
  .chips span{border-radius:99px;padding:.4em .9em;background:#fff;font-weight:700;font-size:.9em;box-shadow:0 2px 8px rgba(0,0,0,.06)}
  .chips span.on{background:#ff6900;color:#141006}
  .item{display:flex;gap:.7em;align-items:center;background:#fff;border-radius:12px;padding:.45em;box-shadow:0 4px 14px rgba(0,0,0,.08)}
  .item img{width:3.6em;height:3.6em;flex:none;border-radius:9px}
  .item div{flex:1}
  .item b{display:block;font-weight:800}
  .item small{color:#a84300;font-weight:800}
  .add{width:1.7em;height:1.7em;border-radius:50%;display:grid;place-items:center;background:#ff6900;color:#141006;font-weight:800}
  .tabbar{margin-top:auto;margin-inline:-5cqw;display:flex;justify-content:space-around;padding:1em 0 1.4em;background:#fff;border-top:1px solid #eee}
  .tabbar i{width:1.4em;height:1.4em;border-radius:6px;background:#d9d5d0}
  .tabbar i.on{background:#ff6900}

  /* peça em construção: só o contorno tracejado */
  .b{transition:background-color .4s,box-shadow .4s,opacity .4s}
  .b.wire{background:transparent !important;box-shadow:none !important;outline:1.5px dashed #ff8a24;outline-offset:-1px;color:transparent !important}
  .b.wire *{opacity:0}
  .b.skel{position:relative;overflow:hidden;color:transparent !important;background:#e4e0db !important;box-shadow:none !important}
  .b.skel *{opacity:0}
  .b.skel::after{content:'';position:absolute;inset:0;background:linear-gradient(100deg,transparent 20%,rgba(255,255,255,.75) 50%,transparent 80%);animation:hc-shim .7s linear infinite}
  @keyframes hc-shim{from{transform:translateX(-100%)}to{transform:translateX(100%)}}

  .hc-cursor{position:absolute;z-index:7;left:50%;top:50%;pointer-events:none;filter:drop-shadow(0 2px 4px rgba(0,0,0,.4));opacity:0}
  .hc-status{position:absolute;z-index:7;left:50%;bottom:3cqh;transform:translateX(-50%);display:flex;align-items:center;gap:.6em;white-space:nowrap;padding:.45em .9em .55em;border-radius:99px;background:#141006;color:#fff;font-size:clamp(8px,2.2cqw,12px);font-weight:700;overflow:hidden;box-shadow:0 8px 20px rgba(0,0,0,.35)}
  .hc-st-pct{color:#ff8a24}
  .hc-st-bar{position:absolute;left:0;bottom:0;height:3px;width:0;background:#ff6900}
  .hc-status.ok{background:#0b7544}
  .hc-status.ok .hc-st-pct{color:#fff}

  /* ---------- selos ---------- */
  .hc-badge{position:absolute;display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:14px;color:#fff;background:linear-gradient(135deg,rgba(38,40,46,.96),rgba(14,15,18,.96));backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 0 0 1px rgba(255,255,255,.14),0 25px 50px -12px rgba(0,0,0,.8);transform:translateZ(80px)}
  .hc-badge b{display:block;font-size:13px;line-height:1.2}
  .hc-badge em{display:block;font-style:normal;font-size:11px;color:#c3c8cf}
  .hc-bi{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:#ff8a24;background:rgba(255,105,0,.15);border:1px solid rgba(255,105,0,.35)}
  .hc-bi-g{color:#3ddc97;background:rgba(61,220,151,.12);border-color:rgba(61,220,151,.35)}
  .hc-b1{bottom:26%;left:-4%}
  .hc-b2{top:4%;right:-3%}
  @media(max-width:600px){.hc-b1{display:none}.hc-b2{right:-2%;top:0}}

  @media (prefers-reduced-motion: reduce){
    .hc-lines{display:none}
    .hc-dev,.hc-bezel,.hc-screen,.hc-island,.hc-neck,.hc-base,.hc-kb{transition:none !important}
  }
  @container (max-width:300px){.sh{grid-template-columns:1fr}.sh .ph{display:none}.prods{grid-template-columns:1fr 1fr}.pd:nth-child(3){display:none}.mn{display:none}}
</style>

<script>
  import { gsap } from 'gsap';
  const root = document.getElementById('hero')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
  const contar = (el: Element, to: number, dur = 1.6) =>
    reduce ? (el.textContent = String(to)) : gsap.to({ v: Number(el.textContent) || 0 }, { v: to, duration: dur, ease: 'expo.out', onUpdate() { el.textContent = String(Math.round(this.targets()[0].v)); } });

  // ---- construção do projeto: cada peça surge do contorno tracejado, com o cursor "montando" ----
  const screen = $<HTMLElement>('.hc-screen');
  const cursor = $<HTMLElement>('.hc-cursor');
  const status = $<HTMLElement>('.hc-status');
  const stTxt = $('.hc-st-txt'), stPct = $('.hc-st-pct'), stBar = $<HTMLElement>('.hc-st-bar');
  let build: gsap.core.Timeline | undefined;

  // etapa final de cada peça: a foto sai do borrado/cinza para nítida e os títulos são digitados
  function revelar(p: HTMLElement) {
    p.classList.remove('skel');
    p.querySelectorAll('img').forEach((img) =>
      gsap.fromTo(img, { filter: 'blur(10px) grayscale(1)', scale: 1.15, opacity: .4 }, { filter: 'blur(0px) grayscale(0)', scale: 1, opacity: 1, duration: .9, ease: 'power2.out' }));
    const alvos = p.classList.contains('ty') ? [p] : Array.from(p.querySelectorAll<HTMLElement>('.ty'));
    alvos.forEach((t) => {
      const txt = t.dataset.txt ?? (t.dataset.txt = t.textContent || '');
      gsap.to({ n: 0 }, { n: txt.length, duration: Math.min(1.1, txt.length * .045), ease: 'none', onUpdate() { t.textContent = txt.slice(0, Math.round(this.targets()[0].n)); } });
    });
  }

  function construir(id: string, projeto: string) {
    build?.kill();
    const pecas = Array.from(root.querySelectorAll<HTMLElement>(`.pj[data-p="${id}"] .b`));
    const verbo = projeto.startsWith('Aplicativo') || projeto.startsWith('Sistema') ? 'Desenvolvendo' : 'Criando';
    status.classList.remove('ok');
    stTxt.textContent = `${verbo} ${projeto.toLowerCase()}…`;
    if (reduce) {
      pecas.forEach((p) => p.classList.remove('wire', 'skel'));
      status.classList.add('ok'); stTxt.textContent = `${projeto} publicado`; stPct.textContent = '100%'; stBar.style.width = '100%';
      return;
    }
    pecas.forEach((p) => { p.classList.remove('skel'); p.classList.add('wire'); gsap.set(p.querySelectorAll('img'), { clearProps: 'all' }); });
    stPct.textContent = '0%'; stBar.style.width = '0%';
    const tela = screen.getBoundingClientRect();
    build = gsap.timeline({ delay: .5 });
    build.to(cursor, { opacity: 1, duration: .2 });
    pecas.forEach((p, i) => {
      const r = p.getBoundingClientRect();
      const x = ((r.left + r.width * .6 - tela.left) / tela.width) * 100;
      const y = ((r.top + r.height * .6 - tela.top) / tela.height) * 100;
      const pct = Math.round(((i + 1) / pecas.length) * 100);
      build!
        .to(cursor, { left: `${x}%`, top: `${y}%`, duration: .32, ease: 'power2.inOut' })
        .add(() => { p.classList.replace('wire', 'skel'); stPct.textContent = `${pct}%`; stBar.style.width = `${pct}%`; })
        .fromTo(p, { scale: .92 }, { scale: 1, duration: .35, ease: 'back.out(2)' }, '<')
        .add(() => revelar(p), '+=.18');
    });
    build
      .to(cursor, { opacity: 0, duration: .3 }, '+=.2')
      .add(() => { status.classList.add('ok'); stTxt.textContent = `${projeto} publicado`; stPct.textContent = '100%'; })
      .fromTo(status, { scale: .9 }, { scale: 1, duration: .5, ease: 'back.out(3)' }, '<');
  }

  // ---- troca de aparelho: desktop -> notebook -> tablet -> celular ----
  const stage = $<HTMLElement>('.hc-stage');
  const modos: [string, string, string][] = JSON.parse(root.dataset.dispositivos!);
  const modoBtns = root.querySelectorAll<HTMLButtonElement>('.hc-modes button');
  const devNome = $('#hc-dev-nome'), devSub = $('#hc-dev-sub');
  let modo = 0;
  function mudarModo(i: number) {
    modo = i;
    const [id, nome, projeto] = modos[i];
    stage.dataset.mode = id;
    modoBtns.forEach((b, j) => { b.classList.toggle('on', j === i); b.setAttribute('aria-selected', String(j === i)); });
    devNome.textContent = projeto;
    devSub.textContent = `${nome} · layout adaptado`;
    if (!reduce) gsap.fromTo('.hc-b2', { scale: .85, opacity: .4 }, { scale: 1, opacity: 1, duration: .6, ease: 'back.out(2)' });
    if (reduce) construir(id, projeto);
    else gsap.delayedCall(.9, () => construir(id, projeto)); // espera o aparelho terminar de mudar de forma
  }
  let ciclo: number | undefined;
  const reiniciarCiclo = () => { clearInterval(ciclo); if (!reduce) ciclo = window.setInterval(() => mudarModo((modo + 1) % modos.length), 8500); };
  modoBtns.forEach((b) => b.addEventListener('click', () => { mudarModo(Number(b.dataset.m)); reiniciarCiclo(); }));

  // ?dispositivo=celular abre o hero direto num aparelho (útil para apresentar)
  const inicial = Math.max(0, modos.findIndex(([id]) => id === new URLSearchParams(location.search).get('dispositivo')));

  // ---- entrada ----
  if (reduce) {
    mudarModo(inicial);
    root.querySelectorAll('.hc-n').forEach((n) => (n.textContent = (n as HTMLElement).dataset.to!));
  } else {
    root.querySelectorAll('.pj .b').forEach((p) => p.classList.add('wire'));
    const tl = gsap.timeline({ delay: .2 });
    tl.from('.hc-w', { yPercent: 110, rotationX: -60, opacity: 0, filter: 'blur(12px)', duration: 1.2, stagger: .08, ease: 'expo.out' })
      .from('.hc-r', { y: 30, opacity: 0, filter: 'blur(10px)', duration: .9, stagger: .12, ease: 'power3.out' }, '-=.8')
      .from('.hc-pc', { opacity: 0, rotationY: -55, rotationX: 20, z: -400, y: 80, duration: 1.8, ease: 'expo.out', onComplete: () => { mudarModo(inicial); reiniciarCiclo(); } }, .3)
      .from('.hc-badge', { opacity: 0, scale: .6, y: 40, duration: 1, stagger: .25, ease: 'back.out(1.6)' }, '-=.6')
      .add(() => root.querySelectorAll<HTMLElement>('.hc-n').forEach((n) => contar(n, Number(n.dataset.to), 2)), '-=1.2');

    gsap.to('.hc-b1', { y: -10, duration: 2.4, yoyo: true, repeat: -1, ease: 'sine.inOut' });
    gsap.to('.hc-b2', { y: 10, duration: 2.8, yoyo: true, repeat: -1, ease: 'sine.inOut' });

    // inclinação 3D seguindo o mouse
    const pc = $<HTMLElement>('.hc-pc');
    root.addEventListener('mousemove', (e) => {
      const r = root.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      gsap.to(pc, { rotationY: -12 + x * 14, rotationX: 5 - y * 10, duration: 1.2, ease: 'power3.out' });
    });
    root.addEventListener('mouseleave', () => gsap.to(pc, { rotationY: -12, rotationX: 5, duration: 1.4, ease: 'power3.out' }));
  }
</script>
