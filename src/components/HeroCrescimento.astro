---
// Hero cinematográfico: textos animados à esquerda e, à direita, os 4 aparelhos (desktop, notebook,
// tablet e celular) juntos mostrando a mesma loja, cada um com layout próprio. Um destaque passa de
// aparelho em aparelho e faz produtos saltarem da tela em 3D; uma compra no celular aparece em todas
// as telas ao mesmo tempo. Loja, produtos e preços são fictícios — ver CLAUDE.md.
import { waLink } from '../config';
import Loja from './Loja.astro';
const dispositivos = [
  { id: 'desk', nome: 'Desktop', icone: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>' },
  { id: 'lap', nome: 'Notebook', icone: '<rect x="4" y="4" width="16" height="11" rx="2"/><path d="M2 19h20"/>' },
  { id: 'tab', nome: 'Tablet', icone: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/>' },
  { id: 'cel', nome: 'Celular', icone: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>' },
];
// produtos que saltam da tela de cada aparelho quando ele está em destaque
const saltos: Record<string, [string, string, string][]> = {
  desk: [['jaqueta', 'Jaqueta Couro', 'R$ 349,90'], ['bone', 'Boné Trucker', 'R$ 79,90']],
  lap: [['moletom', 'Moletom Basic', 'R$ 129,90'], ['relogio', 'Relógio Smart', 'R$ 259,90']],
  tab: [['modelo', 'Casaco Inverno', 'R$ 199,90'], ['fitness2', 'Calça Jogger', 'R$ 89,90']],
  cel: [['camiseta', 'Camiseta Premium', 'R$ 69,90'], ['bone', 'Boné Trucker', 'R$ 79,90']],
};
---
<section class="hc" id="hero" data-saltos={JSON.stringify(saltos)}>
  <div class="hc-glow" aria-hidden="true"></div>
  <div class="hc-grid" aria-hidden="true"></div>
  <div class="hc-lines" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="wrap hc-in">
    <div class="hc-txt">
      <span class="eyebrow hc-r">Agência de marketing digital</span>
      <h1 class="hc-h1">
        <span class="hc-line"><span class="hc-w">Seu</span> <span class="hc-w">negócio</span></span>
        <span class="hc-line"><span class="hc-w">com</span> <span class="hc-w">tecnologia</span></span>
        <span class="hc-line"><span class="hc-w hc-or">avançada</span></span>
      </h1>
      <p class="hc-lead hc-r">Criamos sites, apps, lojas virtuais e campanhas que trazem clientes para o seu WhatsApp. Cada contato medido, cada resultado na tela.</p>
      <div class="acoes hc-r">
        <a class="btn btn-primary" href={waLink()} target="_blank" rel="noopener">Quero meu orçamento</a>
        <a class="btn hc-ghost" href="#servicos">Ver serviços</a>
      </div>
      <ul class="hc-stats hc-r">
        <li><b><span class="hc-n" data-to="180">0</span>+</b><small>projetos entregues</small></li>
        <li><b><span class="hc-n" data-to="98">0</span>%</b><small>clientes satisfeitos</small></li>
        <li><b><span class="hc-n" data-to="2">0</span>h</b><small>para responder</small></li>
      </ul>
    </div>

    <div class="sv">
      <div class="sv-scene" aria-hidden="true">
        <div class="sv-aura"></div>

        <div class="dv dv-desk" data-d="desk">
          <div class="dv-frame"><div class="dv-scr"><Loja tipo="desk" /><i class="dv-on"></i></div></div>
          <div class="dv-neck"></div><div class="dv-foot"></div>
        </div>
        <div class="dv dv-lap" data-d="lap">
          <div class="dv-frame"><div class="dv-scr"><Loja tipo="lap" /><i class="dv-on"></i></div></div>
          <div class="dv-deck"></div>
        </div>
        <div class="dv dv-tab" data-d="tab">
          <div class="dv-frame"><div class="dv-scr"><Loja tipo="tab" /><i class="dv-on"></i></div></div>
        </div>
        <div class="dv dv-cel" data-d="cel">
          <div class="dv-frame"><div class="dv-scr"><Loja tipo="cel" /><i class="dv-on"></i><span class="dv-tap"></span></div></div>
        </div>

        <!-- produtos que saltam da tela do aparelho em destaque -->
        <div class="pop"><div class="pop-img"><img src="/mock/jaqueta.webp" alt="" width="320" height="320" /></div><div><b>Jaqueta Couro</b><small>R$ 349,90</small></div></div>
        <div class="pop"><div class="pop-img"><img src="/mock/bone.webp" alt="" width="320" height="320" /></div><div><b>Boné Trucker</b><small>R$ 79,90</small></div></div>

        <div class="chip chip-a"><span class="chip-ok">✓</span><div><b>Pix aprovado</b><small>Pedido #1024 · R$ 189,90</small></div></div>
        <div class="chip chip-b"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.5 8.5-5-5L2 17"/><path d="M16 7h6v6"/></svg><div><b>+38% em vendas</b><small>depois da loja nova</small></div></div>
      </div>

      <div class="sv-modes" role="tablist" aria-label="Destacar aparelho">
        {dispositivos.map((d, i) => (
          <button type="button" role="tab" data-m={d.id} class={i === 0 ? 'on' : ''} aria-label={d.nome}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={d.icone} />
            <span>{d.nome}</span>
          </button>
        ))}
      </div>
      <p class="sv-note">Uma loja, quatro telas, um só sistema</p>
    </div>
  </div>
</section>

<style>
  .hc{position:relative;overflow:hidden;background:var(--carbon);color:#fff;padding:56px 0 72px;isolation:isolate}
  @media(min-width:1024px){.hc{min-height:calc(100vh - 114px);display:flex;align-items:center}}
  .hc-glow{position:absolute;inset:-20%;z-index:-1;background:radial-gradient(600px 420px at 75% 45%,rgba(255,105,0,.22),transparent 65%),radial-gradient(500px 360px at 10% 90%,rgba(255,138,36,.1),transparent 70%)}
  .hc-grid{position:absolute;inset:0;z-index:-1;background-size:56px 56px;background-image:linear-gradient(to right,rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,.05) 1px,transparent 1px);mask-image:radial-gradient(ellipse at 60% 50%,#000 0%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse at 60% 50%,#000 0%,transparent 70%)}
  .hc-lines{position:absolute;inset:0;z-index:-1;pointer-events:none}
  .hc-lines i{position:absolute;height:2px;width:220px;background:linear-gradient(90deg,transparent,#ff6900,transparent);transform:skewX(-30deg);opacity:.5;animation:hc-speed 5s linear infinite}
  .hc-lines i:nth-child(1){top:18%;animation-delay:0s}
  .hc-lines i:nth-child(2){top:62%;animation-delay:1.7s;width:160px}
  .hc-lines i:nth-child(3){top:84%;animation-delay:3.2s}
  @keyframes hc-speed{from{left:-20%}to{left:110%}}

  .hc-in{display:grid;gap:40px;align-items:center;width:100%}
  @media(min-width:1024px){.hc-in{grid-template-columns:1fr 1.15fr;gap:32px}}
  .hc .eyebrow{color:var(--orange-hot)}
  .hc-h1{font-size:clamp(46px,5.6vw,76px);line-height:.9;letter-spacing:-.02em;display:flex;flex-direction:column}
  .hc-line{display:block;overflow:hidden;padding-bottom:.04em}
  .hc-w{display:inline-block}
  .hc-or{background:linear-gradient(180deg,#ff8a24,#ff6900);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .hc-lead{color:#aeb4bd;font-size:18px;line-height:28px;max-width:52ch;margin-top:24px}
  .hc-ghost{border-color:#5b616b;color:#fff}
  .hc-ghost:hover{border-color:#fff}
  .hc-stats{list-style:none;display:flex;gap:28px;margin-top:40px;flex-wrap:wrap}
  .hc-stats b{display:block;font-family:var(--ff-tit);font-weight:800;font-size:40px;line-height:1}
  .hc-stats small{color:#aeb4bd;font-size:14px}

  /* ---------- vitrine com os 4 aparelhos (tudo medido em cqw da cena) ---------- */
  .sv{display:flex;flex-direction:column;align-items:center;perspective:1600px}
  .sv-scene{position:relative;width:min(100%,640px);aspect-ratio:100/76;container-type:inline-size;transform-style:preserve-3d;transform:rotateX(4deg) rotateY(-6deg);text-align:left}
  .sv-aura{position:absolute;left:12cqw;top:6cqw;width:76cqw;height:62cqw;border-radius:50%;background:radial-gradient(closest-side,rgba(255,120,30,.32),rgba(255,105,0,.08) 60%,transparent);filter:blur(2cqw);pointer-events:none}

  .dv{position:absolute;transform-style:preserve-3d;will-change:transform}
  .dv-frame{position:relative;background:linear-gradient(155deg,#3b3e45,#1a1c20 38%,#0e0f12);box-shadow:0 0 0 1px rgba(255,255,255,.07),inset 0 1px 0 rgba(255,255,255,.14),0 3cqw 6cqw -2cqw rgba(0,0,0,.85);transition:box-shadow .5s}
  .dv-scr{position:relative;overflow:hidden;container-type:inline-size;background:#f7f5f2}
  .dv-on{position:absolute;inset:0;z-index:6;background:#050506;pointer-events:none}
  .dv-scr::after{content:'';position:absolute;inset:0;z-index:7;pointer-events:none;background:linear-gradient(115deg,rgba(255,255,255,.14),rgba(255,255,255,0) 38%)}
  .dv.ativo .dv-frame{box-shadow:0 0 0 1px rgba(255,138,36,.7),0 0 4cqw -.5cqw rgba(255,105,0,.65),inset 0 1px 0 rgba(255,255,255,.2),0 4cqw 7cqw -2cqw rgba(0,0,0,.9)}

  .dv-desk{left:19cqw;top:0;width:64cqw}
  .dv-desk .dv-frame{padding:.8cqw;border-radius:1.4cqw}
  .dv-desk .dv-scr{aspect-ratio:16/10;border-radius:.6cqw}
  .dv-neck{width:9cqw;height:7cqw;margin:0 auto;background:linear-gradient(90deg,#16171a,#4a4d55 50%,#16171a);clip-path:polygon(18% 0,82% 0,100% 100%,0 100%)}
  .dv-foot{width:24cqw;height:1.2cqw;margin:0 auto;border-radius:.6cqw .6cqw 1cqw 1cqw;background:linear-gradient(180deg,#4a4d55,#16171a)}

  .dv-lap{left:0;top:29cqw;width:48cqw}
  .dv-lap .dv-frame{padding:.8cqw .8cqw 1.1cqw;border-radius:1.4cqw 1.4cqw .4cqw .4cqw}
  .dv-lap .dv-scr{aspect-ratio:16/10;border-radius:.5cqw}
  .dv-deck{position:relative;width:112%;margin-left:-6%;height:2cqw;border-radius:.3cqw .3cqw 1.6cqw 1.6cqw;background:linear-gradient(180deg,#55585f,#1b1c20);box-shadow:0 2cqw 3cqw -1cqw rgba(0,0,0,.9)}
  .dv-deck::after{content:'';position:absolute;left:50%;top:0;transform:translateX(-50%);width:16%;height:45%;border-radius:0 0 .8cqw .8cqw;background:#2a2c31}

  .dv-tab{left:72cqw;top:24cqw;width:27cqw}
  .dv-tab .dv-frame{padding:1.1cqw;border-radius:2.4cqw}
  .dv-tab .dv-scr{aspect-ratio:3/4.1;border-radius:1.3cqw}

  .dv-cel{left:53cqw;top:38cqw;width:15cqw}
  .dv-cel .dv-frame{padding:.6cqw;border-radius:2.6cqw}
  .dv-cel .dv-scr{aspect-ratio:9/19;border-radius:2cqw}
  .dv-tap{position:absolute;z-index:8;left:24%;top:31%;width:5cqw;height:5cqw;margin:-2.5cqw 0 0 -2.5cqw;border-radius:50%;border:.35cqw solid #ff6900;opacity:0;pointer-events:none}

  /* produtos que saltam */
  .pop{position:absolute;left:0;top:0;z-index:20;display:flex;align-items:center;gap:1cqw;width:21cqw;padding:.8cqw;border-radius:1.6cqw;background:rgba(255,255,255,.97);color:#17181c;box-shadow:0 3cqw 5cqw -1.5cqw rgba(0,0,0,.85),0 0 0 1px rgba(255,255,255,.8) inset;opacity:0;pointer-events:none;will-change:transform}
  .pop-img{width:7.5cqw;height:7.5cqw;flex:none;border-radius:1.1cqw;overflow:hidden;background:#eee}
  .pop img{display:block;width:100%;height:100%;object-fit:cover}
  .pop b{display:block;font-size:1.7cqw;font-weight:800;line-height:1.15}
  .pop small{display:block;font-size:1.6cqw;font-weight:800;color:#a84300;margin-top:.3cqw}

  /* selos discretos */
  .chip{position:absolute;z-index:15;display:flex;align-items:center;gap:1cqw;padding:.9cqw 1.6cqw .9cqw .9cqw;border-radius:1.4cqw;background:rgba(20,21,25,.92);border:1px solid rgba(255,255,255,.1);box-shadow:0 2cqw 4cqw -1cqw rgba(0,0,0,.8);color:#fff;white-space:nowrap}
  .chip b{display:block;font-size:1.65cqw;line-height:1.2}
  .chip small{display:block;font-size:1.3cqw;color:#aeb4bd}
  .chip-ok{display:grid;place-items:center;width:3.2cqw;height:3.2cqw;border-radius:50%;background:#0b7544;font-size:1.5cqw;font-weight:800}
  .chip svg{width:3.2cqw;height:3.2cqw;padding:.7cqw;border-radius:50%;background:rgba(255,105,0,.18);color:#ff8a24}
  .chip-a{left:3cqw;top:66cqw}
  .chip-b{right:0;top:12cqw}

  .sv-modes{display:flex;gap:6px;margin-top:14px;padding:5px;border-radius:999px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08)}
  .sv-modes button{display:flex;align-items:center;gap:6px;min-height:38px;padding:0 13px;border:0;border-radius:999px;background:none;color:#aeb4bd;font:inherit;font-size:13px;font-weight:700;cursor:pointer;transition:background .3s,color .3s}
  .sv-modes button.on{background:#ff6900;color:#141006}
  @media(max-width:520px){.sv-modes button span{display:none}.sv-modes button.on span{display:inline}}
  .sv-note{margin-top:10px;font-size:13px;color:#aeb4bd}

  /* ----- hero por dispositivo ----- */
  @media(max-width:767px){
    .hc{padding:28px 0 32px;text-align:center}
    .hc-txt{display:flex;flex-direction:column;align-items:center}
    .hc-h1{font-size:46px;align-items:center}
    .hc-lead{font-size:16px;line-height:26px;margin-top:16px}
    .hc-stats{width:100%;gap:0;justify-content:space-between;margin-top:28px;padding-top:20px;border-top:1px solid #23252b}
    .hc-stats li{flex:1;text-align:center}
    .hc-stats b{font-size:32px}
    .hc-stats small{font-size:12px}
    .sv-scene{transform:none}
  }
  @media(min-width:768px) and (max-width:1023px){
    .hc{padding:56px 0 64px;text-align:center}
    .hc-txt{display:flex;flex-direction:column;align-items:center}
    .hc-h1{font-size:68px;align-items:center}
    .hc-lead{margin-inline:auto}
    .hc .acoes,.hc-stats{justify-content:center}
  }
  @media(min-width:1440px){
    .hc-in{grid-template-columns:1fr 1.2fr;gap:48px}
    .hc-h1{font-size:80px}
    .hc-lead{font-size:20px;line-height:31px}
    .hc-stats b{font-size:48px}
    .sv-scene{width:min(100%,700px)}
  }
  @media (prefers-reduced-motion: reduce){.hc-lines{display:none}.dv-on{display:none}}
</style>

<script>
  import { gsap } from 'gsap';
  const root = document.getElementById('hero')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scene = root.querySelector<HTMLElement>('.sv-scene')!;
  const aparelhos = Array.from(root.querySelectorAll<HTMLElement>('.dv'));
  const botoes = Array.from(root.querySelectorAll<HTMLButtonElement>('.sv-modes button'));
  const pops = Array.from(root.querySelectorAll<HTMLElement>('.pop'));
  const toasts = root.querySelectorAll<HTMLElement>('.lj-toast');
  const saltos: Record<string, [string, string, string][]> = JSON.parse(root.dataset.saltos!);
  const ordem = ['desk', 'lap', 'tab', 'cel'];
  let qtd = 2;
  gsap.set(toasts, { xPercent: -50, yPercent: -220 });

  const contar = (el: Element, to: number, dur = 1.6) =>
    reduce ? (el.textContent = String(to)) : gsap.to({ v: 0 }, { v: to, duration: dur, ease: 'expo.out', onUpdate() { el.textContent = String(Math.round(this.targets()[0].v)); } });

  function marcar(id: string) {
    aparelhos.forEach((d) => d.classList.toggle('ativo', d.dataset.d === id));
    botoes.forEach((b) => { const on = b.dataset.m === id; b.classList.toggle('on', on); b.setAttribute('aria-selected', String(on)); });
  }

  // centro da tela de um aparelho, em px relativos à cena
  function centroTela(d: HTMLElement) {
    const s = scene.getBoundingClientRect(), r = d.querySelector('.dv-scr')!.getBoundingClientRect();
    return { x: r.left - s.left + r.width / 2, y: r.top - s.top + r.height / 2, w: s.width };
  }

  // compra no celular -> aviso e carrinho atualizados em todas as telas ao mesmo tempo
  function compra() {
    const tap = root.querySelector<HTMLElement>('.dv-tap')!;
    return gsap.timeline()
      .fromTo(tap, { scale: .3, opacity: 1 }, { scale: 1.6, opacity: 0, duration: .6, ease: 'power2.out' })
      .add(() => {
        qtd = qtd >= 9 ? 1 : qtd + 1;
        root.querySelectorAll('.lj-qtd').forEach((q) => (q.textContent = String(qtd)));
        gsap.fromTo(root.querySelectorAll('.lj-qtd'), { scale: 1.9 }, { scale: 1, duration: .5, ease: 'back.out(3)' });
      }, .15)
      .to(toasts, { yPercent: 0, duration: .5, stagger: .07, ease: 'back.out(1.6)' }, .2)
      .to(toasts, { yPercent: -220, duration: .4, stagger: .05, ease: 'power2.in' }, '+=1.5');
  }

  // destaque de um aparelho: ele sobe, brilha e dois produtos saltam da tela dele
  function destacar(id: string) {
    marcar(id);
    const d = aparelhos.find((a) => a.dataset.d === id)!;
    const c = centroTela(d);
    const t = gsap.timeline();
    t.to(aparelhos, { z: (_i: number, el: HTMLElement) => (el === d ? 50 : 0), y: (_i: number, el: HTMLElement) => (el === d ? -c.w * .012 : 0), duration: .8, ease: 'power3.out' }, 0);
    pops.forEach((p, i) => {
      const [img, nome, preco] = saltos[id][i];
      p.querySelector('img')!.src = `/mock/${img}.webp`;
      p.querySelector('b')!.textContent = nome;
      p.querySelector('small')!.textContent = preco;
      const lado = i === 0 ? -1 : 1;
      const ox = c.x - p.offsetWidth / 2, oy = c.y - p.offsetHeight / 2;
      const dx = Math.min(Math.max(ox + lado * c.w * .17, 0), c.w - p.offsetWidth);
      const dy = Math.max(oy - c.w * (.1 - i * .15), 0);
      t.fromTo(p, { x: ox, y: oy, z: 0, scale: .25, opacity: 0, rotationY: lado * 30 },
        { x: dx, y: dy, z: 140 + i * 40, scale: 1, opacity: 1, rotationY: lado * -8, duration: 1, ease: 'expo.out' }, .35 + i * .15)
        .to(p, { y: dy - c.w * .012, duration: 1.4, ease: 'sine.inOut', yoyo: true, repeat: 1 }, 1.4)
        .to(p, { x: ox, y: oy, z: 0, scale: .25, opacity: 0, rotationY: 0, duration: .6, ease: 'power3.in' }, 4.3 + i * .08);
    });
    if (id === 'cel') t.add(compra(), 1.2);
    return t;
  }

  let indice = 0, loop: gsap.core.Timeline | undefined;
  function proximo() {
    loop = destacar(ordem[indice]);
    loop.eventCallback('onComplete', () => { indice = (indice + 1) % ordem.length; proximo(); });
  }

  if (reduce) {
    marcar('desk');
    root.querySelectorAll('.hc-n').forEach((n) => (n.textContent = (n as HTMLElement).dataset.to!));
    botoes.forEach((b) => b.addEventListener('click', () => marcar(b.dataset.m!)));
  } else {
    botoes.forEach((b) => b.addEventListener('click', () => {
      loop?.kill(); gsap.set(pops, { opacity: 0 });
      indice = ordem.indexOf(b.dataset.m!);
      proximo();
    }));

    gsap.timeline({ delay: .2 })
      .from('.hc-w', { yPercent: 110, rotationX: -60, opacity: 0, filter: 'blur(12px)', duration: 1.2, stagger: .08, ease: 'expo.out' })
      .from('.hc-r', { y: 30, opacity: 0, filter: 'blur(10px)', duration: .9, stagger: .12, ease: 'power3.out' }, '-=.8')
      .from(['.dv-desk', '.dv-lap', '.dv-tab', '.dv-cel'], { y: 80, z: -300, opacity: 0, filter: 'blur(10px)', duration: 1.3, stagger: .14, ease: 'expo.out', clearProps: 'filter' }, .3)
      .to('.dv-on', { opacity: 0, duration: .5, stagger: .14, ease: 'power2.out' }, 1.1)
      .from('.chip', { opacity: 0, scale: .7, y: 20, duration: .8, stagger: .2, ease: 'back.out(1.8)' }, 1.6)
      .from('.sv-aura', { opacity: 0, scale: .6, duration: 1.8, ease: 'power2.out' }, .4)
      .add(() => root.querySelectorAll<HTMLElement>('.hc-n').forEach((n) => contar(n, Number(n.dataset.to), 2)), 1.2)
      .add(proximo, 2);

    gsap.to('.chip-a', { y: -8, duration: 2.6, yoyo: true, repeat: -1, ease: 'sine.inOut' });
    gsap.to('.chip-b', { y: 8, duration: 3, yoyo: true, repeat: -1, ease: 'sine.inOut' });

    // a cena acompanha o mouse
    root.addEventListener('mousemove', (e) => {
      const r = root.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      gsap.to(scene, { rotationY: -6 + x * 12, rotationX: 4 - y * 8, duration: 1.2, ease: 'power3.out' });
    });
    root.addEventListener('mouseleave', () => gsap.to(scene, { rotationY: -6, rotationX: 4, duration: 1.4, ease: 'power3.out' }));
  }
</script>
