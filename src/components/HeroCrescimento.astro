---
// Hero cinematográfico: textos animados à esquerda e, à direita, um celular com uma loja virtual de onde
// os produtos e cards "saltam" da tela em 3D e ficam flutuando (inspirado em animação de referência
// enviada pelo cliente, recriada em código). Produtos, preços e loja são fictícios — ver CLAUDE.md.
import { waLink } from '../config';
import Icon from './Icon.astro';
const dispositivos = [
  { id: 'desktop', nome: 'Desktop', icone: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>' },
  { id: 'notebook', nome: 'Notebook', icone: '<rect x="4" y="4" width="16" height="11" rx="2"/><path d="M2 19h20"/>' },
  { id: 'tablet', nome: 'Tablet', icone: '<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/>' },
  { id: 'celular', nome: 'Celular', icone: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>' },
];
---
<section class="hc" id="hero" data-dispositivos={JSON.stringify(dispositivos.map((d) => d.id))}>
  <div class="hc-glow" aria-hidden="true"></div>
  <div class="hc-grid" aria-hidden="true"></div>
  <div class="hc-lines" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="wrap hc-in">
    <div class="hc-txt">
      <span class="eyebrow hc-r">Agência de marketing digital</span>
      <h1 class="hc-h1">
        <span class="hc-line"><span class="hc-w">Seu</span> <span class="hc-w">negócio</span></span>
        <span class="hc-line"><span class="hc-w">com</span> <span class="hc-w">tecnologia</span></span>
        <span class="hc-line"><span class="hc-w hc-or">avançada</span></span>
      </h1>
      <p class="hc-lead hc-r">Criamos sites, apps, lojas virtuais e campanhas que trazem clientes para o seu WhatsApp. Cada contato medido, cada resultado na tela.</p>
      <div class="acoes hc-r">
        <a class="btn btn-primary" href={waLink()} target="_blank" rel="noopener">Quero meu orçamento</a>
        <a class="btn hc-ghost" href="#servicos">Ver serviços</a>
      </div>
      <ul class="hc-stats hc-r">
        <li><b><span class="hc-n" data-to="180">0</span>+</b><small>projetos entregues</small></li>
        <li><b><span class="hc-n" data-to="98">0</span>%</b><small>clientes satisfeitos</small></li>
        <li><b><span class="hc-n" data-to="2">0</span>h</b><small>para responder</small></li>
      </ul>
    </div>

    <div class="ex" data-mode="celular">
      <div class="ex-scene" aria-hidden="true">
        <div class="ex-luz"></div>
        <div class="ex-chao"></div>

        <!-- aparelho que muda de forma: desktop, notebook, tablet e celular -->
        <div class="ex-stand" aria-hidden="true"></div>
        <div class="ex-kb" aria-hidden="true"></div>
        <div class="ex-phone">
          <div class="ex-screen">
            <div class="ex-status"><b>9:41</b><span class="ex-notch"></span><span class="ex-url">rsmoda.com.br</span><i></i></div>
            <div class="ex-app">
              <div class="ex-head"><span class="ex-logo">RS Moda</span><span class="ex-cart"><Icon name="cart" size={12} /><em>3</em></span></div>
              <div class="ex-busca">Buscar produtos</div>
              <div class="ex-dest">
                <img src="/mock/camiseta.webp" alt="" width="480" height="560" />
                <div><small>Nova coleção</small><b>Básicos premium</b></div>
              </div>
              <div class="ex-mini">
                <div><img src="/mock/moletom.webp" alt="" width="320" height="360" /><span>R$ 129,90</span></div>
                <div><img src="/mock/fitness2.webp" alt="" width="320" height="360" /><span>R$ 89,90</span></div>
              </div>
              <div class="ex-nav"><i class="on"></i><i></i><i></i><i></i></div>
            </div>
          </div>
        </div>

        <!-- elementos que saltam da tela -->
        <div class="ex-f f-bone" data-z="140"><img src="/mock/bone.webp" alt="" width="320" height="320" /></div>
        <div class="ex-f f-jaq ex-card" data-z="90"><img src="/mock/jaqueta.webp" alt="" width="320" height="320" /><b>Jaqueta Couro</b><small>R$ 349,90</small></div>
        <div class="ex-f f-add ex-card" data-z="120">
          <div class="ex-add-top"><span class="ex-ok"><Icon name="check" size={12} /></span><b>Adicionado ao carrinho</b></div>
          <div class="ex-add-row"><img src="/mock/modelo.webp" alt="" width="320" height="360" /><div><b>Casaco Inverno</b><small>R$ 199,90</small><em>Tam. M · 1 un.</em></div></div>
        </div>
        <div class="ex-f f-rel ex-card" data-z="70"><img src="/mock/relogio.webp" alt="" width="240" height="240" /><small>R$ 259,90</small></div>
        <div class="ex-f f-mol ex-card" data-z="60"><img src="/mock/moletom.webp" alt="" width="320" height="360" /></div>
        <div class="ex-f f-pix ex-pill" data-z="110"><span class="ex-ok"><Icon name="check" size={12} /></span>Pix aprovado · R$ 189,90</div>
        <div class="ex-f f-bot ex-card" data-z="50"><img src="/mock/fitness2.webp" alt="" width="320" height="360" /><img src="/mock/camiseta.webp" alt="" width="480" height="560" /></div>
      </div>
      <div class="ex-modes" role="tablist" aria-label="Aparelho">
        {dispositivos.map((d) => (
          <button type="button" role="tab" data-m={d.id} aria-label={d.nome}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={d.icone} />
            <span>{d.nome}</span>
          </button>
        ))}
      </div>
      <p class="ex-note">A mesma loja, perfeita em todas as telas</p>
    </div>
  </div>
</section>

<style>
  .hc{position:relative;overflow:hidden;background:var(--carbon);color:#fff;padding:56px 0 72px;isolation:isolate}
  @media(min-width:1024px){.hc{padding:56px 0 72px;min-height:calc(100vh - 114px);display:flex;align-items:center}}
  .hc-glow{position:absolute;inset:-20%;z-index:-1;background:radial-gradient(600px 420px at 75% 45%,rgba(255,105,0,.28),transparent 65%),radial-gradient(500px 360px at 10% 90%,rgba(255,138,36,.12),transparent 70%)}
  .hc-grid{position:absolute;inset:0;z-index:-1;background-size:56px 56px;background-image:linear-gradient(to right,rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,.05) 1px,transparent 1px);mask-image:radial-gradient(ellipse at 60% 50%,#000 0%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse at 60% 50%,#000 0%,transparent 70%)}
  .hc-lines{position:absolute;inset:0;z-index:-1;pointer-events:none}
  .hc-lines i{position:absolute;height:2px;width:220px;background:linear-gradient(90deg,transparent,#ff6900,transparent);transform:skewX(-30deg);opacity:.5;animation:hc-speed 5s linear infinite}
  .hc-lines i:nth-child(1){top:18%;animation-delay:0s}
  .hc-lines i:nth-child(2){top:62%;animation-delay:1.7s;width:160px}
  .hc-lines i:nth-child(3){top:84%;animation-delay:3.2s}
  @keyframes hc-speed{from{left:-20%}to{left:110%}}

  .hc-in{display:grid;gap:40px;align-items:center;width:100%}
  @media(min-width:1024px){.hc-in{grid-template-columns:1fr 1.1fr;gap:32px}}

  .hc .eyebrow{color:var(--orange-hot)}
  .hc-h1{font-size:clamp(46px,5.6vw,76px);line-height:.9;letter-spacing:-.02em;display:flex;flex-direction:column}
  .hc-line{display:block;overflow:hidden;padding-bottom:.04em}
  .hc-w{display:inline-block}
  .hc-or{background:linear-gradient(180deg,#ff8a24,#ff6900);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .hc-lead{color:#aeb4bd;font-size:18px;line-height:28px;max-width:52ch;margin-top:24px}
  .hc-ghost{border-color:#5b616b;color:#fff}
  .hc-ghost:hover{border-color:#fff}
  .hc-stats{list-style:none;display:flex;gap:28px;margin-top:40px;flex-wrap:wrap}
  .hc-stats b{display:block;font-family:var(--ff-tit);font-weight:800;font-size:40px;line-height:1}
  .hc-stats small{color:#aeb4bd;font-size:14px}

  /* ---------- cena 3D: celular com produtos saltando da tela ---------- */
  .ex{position:relative;display:flex;flex-direction:column;align-items:center;perspective:1400px}
  .ex-scene{--s:1;position:relative;width:min(100%,560px);aspect-ratio:1/1.08;text-align:left;transform-style:preserve-3d;transform:rotateY(-14deg) rotateX(6deg);font-size:calc(12px * var(--s))}
  .ex-luz{position:absolute;left:50%;top:50%;width:70%;height:80%;transform:translate(-50%,-50%) translateZ(-60px);border-radius:50%;background:radial-gradient(closest-side,rgba(255,170,90,.55),rgba(255,105,0,.18) 55%,transparent 75%);filter:blur(8px)}
  .ex-chao{position:absolute;left:50%;bottom:1%;width:62%;height:7%;transform:translateX(-50%) rotateX(80deg);border-radius:50%;background:radial-gradient(closest-side,rgba(0,0,0,.65),transparent)}

  .ex-phone{--ease:cubic-bezier(.7,0,.2,1);position:absolute;left:calc((100% - var(--w)) / 2);top:calc(var(--t) - var(--h) / 2);width:var(--w);height:var(--h);border-radius:var(--r);padding:var(--p);container-type:size;transition:width .9s var(--ease),height .9s var(--ease),top .9s var(--ease),left .9s var(--ease),border-radius .9s var(--ease),padding .9s var(--ease);background:linear-gradient(150deg,#ffffff,#e9e6e2 45%,#cfcac4);box-shadow:0 0 0 1px rgba(255,255,255,.6) inset,0 40px 90px -30px rgba(0,0,0,.9),0 0 80px -10px rgba(255,140,60,.45)}
  .ex-screen{position:relative;width:100%;height:100%;border-radius:calc(var(--r) - var(--p));transition:border-radius .9s;overflow:hidden;background:#f6f4f1;color:#1b1d22;text-align:left}
  .ex-status{display:flex;align-items:center;justify-content:space-between;padding:.7em 1.2em .3em;font-size:.8em}
  .ex-notch{width:34%;height:1.5em;border-radius:99px;background:#111}
  .ex-status i{width:1.6em;height:.7em;border-radius:3px;border:1.5px solid #1b1d22}
  .ex-app{display:flex;flex-direction:column;gap:.7em;padding:.4em .9em 0;height:calc(100% - 2.6em)}
  .ex-head{display:flex;align-items:center;justify-content:space-between}
  .ex-logo{font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:1.35em}
  .ex-cart{position:relative;display:grid;place-items:center;width:2.2em;height:2.2em;border-radius:50%;background:#141006;color:#fff}
  .ex-cart em{position:absolute;top:-.3em;right:-.3em;min-width:1.3em;height:1.3em;border-radius:99px;background:#ff6900;color:#141006;font-style:normal;font-weight:800;font-size:.7em;display:grid;place-items:center}
  .ex-busca{background:#fff;border-radius:99px;padding:.6em 1em;color:#9a9ea5;font-size:.85em;box-shadow:0 3px 10px rgba(0,0,0,.06)}
  .ex-dest{position:relative;flex:1;min-height:0;border-radius:1em;overflow:hidden;background:#e4e0db}
  .ex-dest img,.ex-mini img,.ex-f img{display:block;width:100%;height:100%;object-fit:cover}
  .ex-dest div{position:absolute;left:0;right:0;bottom:0;padding:1.6em .9em .7em;background:linear-gradient(transparent,rgba(0,0,0,.65));color:#fff}
  .ex-dest small{display:block;color:#ff8a24;font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-size:.7em}
  .ex-dest b{font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:1.4em;line-height:1}
  .ex-mini{display:grid;grid-template-columns:1fr 1fr;gap:.6em;height:24%}
  .ex-mini div{position:relative;border-radius:.8em;overflow:hidden;background:#fff}
  .ex-mini span{position:absolute;left:.4em;bottom:.4em;background:#fff;border-radius:99px;padding:.15em .55em;font-weight:800;font-size:.75em;color:#a84300}
  .ex-nav{display:flex;justify-content:space-around;padding:.8em 0 1.1em;margin:0 -.9em;background:#fff;border-top:1px solid #eee}
  .ex-nav i{width:1.3em;height:1.3em;border-radius:.4em;background:#d9d5d0}
  .ex-nav i.on{background:#ff6900}

  .ex-url{display:none;flex:1;margin:0 1em;padding:.25em .9em;border-radius:99px;background:#fff;color:#6b6f76;font-size:.9em}
  .ex-stand,.ex-kb{position:absolute;left:50%;transform:translateX(-50%);opacity:0;transition:opacity .4s}
  .ex-stand{top:68%;width:22%;height:22%;background:linear-gradient(90deg,#b9b4ae,#efebe6 50%,#b9b4ae);clip-path:polygon(30% 0,70% 0,100% 86%,100% 100%,0 100%,0 86%)}
  .ex-kb{top:75%;width:104%;height:4%;border-radius:3px 3px 18px 18px;background:linear-gradient(180deg,#f2efeb,#bdb7b0);box-shadow:0 30px 40px -12px rgba(0,0,0,.8)}

  /* formatos do aparelho */
  .ex[data-mode="celular"]{--w:46%;--h:90%;--t:50%;--r:2.6em;--p:.55em}
  .ex[data-mode="tablet"]{--w:70%;--h:86%;--t:50%;--r:1.9em;--p:.9em}
  .ex[data-mode="notebook"]{--w:92%;--h:56%;--t:46%;--r:1em;--p:.6em}
  .ex[data-mode="notebook"] .ex-kb{opacity:1;transition-delay:.6s}
  .ex[data-mode="desktop"]{--w:96%;--h:56%;--t:40%;--r:1em;--p:.6em}
  .ex[data-mode="desktop"] .ex-stand{opacity:1;transition-delay:.6s}

  /* a loja se reorganiza em telas largas (notebook, desktop, tablet deitado) */
  @container (min-width:380px){
    .ex-notch{display:none}
    .ex-url{display:block}
    .ex-app{display:grid;grid-template-columns:1.25fr 1fr;grid-template-rows:auto auto 1fr auto;gap:.7em}
    .ex-head,.ex-busca,.ex-nav{grid-column:1 / -1}
    .ex-dest{grid-row:3}
    .ex-mini{grid-row:3;height:auto;grid-template-columns:1fr;grid-template-rows:1fr 1fr}
    .ex-nav{display:none}
  }
  @container (min-width:300px) and (max-width:379px){.ex-mini{height:30%}}

  .ex-modes{display:flex;gap:6px;margin-top:18px;padding:5px;border-radius:999px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08)}
  .ex-modes button{display:flex;align-items:center;gap:6px;min-height:38px;padding:0 13px;border:0;border-radius:999px;background:none;color:#aeb4bd;font:inherit;font-size:13px;font-weight:700;cursor:pointer;transition:background .3s,color .3s}
  .ex-modes button.on{background:#ff6900;color:#141006}
  @media(max-width:520px){.ex-modes button span{display:none}.ex-modes button.on span{display:inline}}
  .ex-note{margin-top:12px;font-size:13px;color:#aeb4bd}

  /* flutuantes */
  .ex-f{position:absolute;will-change:transform;font-size:.85em}
  .ex-card{background:#fff;border-radius:1em;padding:.45em;color:#1b1d22;text-align:left;box-shadow:0 24px 50px -18px rgba(0,0,0,.75),0 0 0 1px rgba(255,255,255,.7) inset}
  .ex-card img{border-radius:.7em}
  .ex-card b{display:block;font-weight:800;font-size:.9em;margin-top:.35em}
  .ex-card small{display:block;color:#a84300;font-weight:800;font-size:.85em}
  .ex-pill{display:flex;align-items:center;gap:.5em;white-space:nowrap;background:#fff;color:#1b1d22;font-weight:800;font-size:.9em;padding:.55em .9em .55em .55em;border-radius:99px;box-shadow:0 20px 40px -16px rgba(0,0,0,.75)}
  .ex-pill svg{color:#0b7544}
  .ex-ok{display:grid;place-items:center;width:1.7em;height:1.7em;border-radius:50%;background:#0b7544;color:#fff;flex:none}

  .f-bone{left:4%;top:4%;width:25.5%;aspect-ratio:1;border-radius:50%;overflow:hidden;box-shadow:0 30px 60px -20px rgba(0,0,0,.8),0 0 0 4px rgba(255,255,255,.9)}
  .f-jaq{left:0;top:40%;width:20.4%}
  .f-jaq img{aspect-ratio:1;height:auto}
  .f-add{right:0;top:8%;width:30.6%}
  .ex-add-top{display:flex;align-items:center;gap:.4em;padding:.2em .2em .5em}
  .ex-add-top b{margin:0;font-size:.82em}
  .ex-add-row{display:flex;gap:.5em;align-items:center}
  .ex-add-row img{width:3.6em;height:3.6em;flex:none}
  .ex-add-row b{margin:0}
  .ex-add-row em{display:block;font-style:normal;color:#6b6f76;font-size:.75em}
  .f-rel{right:2%;top:50%;width:16.2%}
  .f-rel img{aspect-ratio:1;height:auto}
  .f-mol{left:8%;bottom:4%;width:15.3%}
  .f-mol img{aspect-ratio:1/1.1;height:auto}
  .f-pix{right:6%;bottom:16%}
  .f-bot{right:18%;bottom:1%;width:20.4%;display:grid;grid-template-columns:1fr 1fr;gap:.35em}
  .f-bot img{aspect-ratio:1;height:auto}

  /* ----- hero por dispositivo ----- */
  @media(max-width:767px){
    .hc{padding:28px 0 32px;text-align:center}
    .hc-txt{display:flex;flex-direction:column;align-items:center}
    .hc-h1{font-size:46px;align-items:center}
    .hc-lead{font-size:16px;line-height:26px;margin-top:16px}
    .hc-stats{width:100%;gap:0;justify-content:space-between;margin-top:28px;padding-top:20px;border-top:1px solid #23252b}
    .hc-stats li{flex:1;text-align:center}
    .hc-stats b{font-size:32px}
    .hc-stats small{font-size:12px}
    .ex-scene{--s:.72;width:86%;transform:rotateY(-8deg) rotateX(4deg)}
  }
  @media(min-width:768px) and (max-width:1023px){
    .hc{padding:56px 0 64px;text-align:center}
    .hc-txt{display:flex;flex-direction:column;align-items:center}
    .hc-h1{font-size:68px;align-items:center}
    .hc-lead{margin-inline:auto}
    .hc .acoes,.hc-stats{justify-content:center}
    .ex-scene{width:min(100%,520px);--s:1}
  }
  @media(min-width:1024px) and (max-width:1439px){.ex-scene{--s:.95}}
  @media(min-width:1440px){
    .hc-in{grid-template-columns:1fr 1.15fr;gap:48px}
    .hc-h1{font-size:80px}
    .hc-lead{font-size:20px;line-height:31px}
    .hc-stats b{font-size:48px}
    .ex-scene{width:min(100%,640px);--s:1.12}
  }
  @media (prefers-reduced-motion: reduce){.hc-lines{display:none}.ex-phone,.ex-stand,.ex-kb{transition:none}}
</style>

<script>
  import { gsap } from 'gsap';
  const root = document.getElementById('hero')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const contar = (el: Element, to: number, dur = 1.6) =>
    reduce ? (el.textContent = String(to)) : gsap.to({ v: 0 }, { v: to, duration: dur, ease: 'expo.out', onUpdate() { el.textContent = String(Math.round(this.targets()[0].v)); } });

  const scene = root.querySelector<HTMLElement>('.ex-scene')!;
  const phone = root.querySelector<HTMLElement>('.ex-phone')!;
  const ex = root.querySelector<HTMLElement>('.ex')!;
  const modos: string[] = JSON.parse(root.dataset.dispositivos!);
  const botoes = root.querySelectorAll<HTMLButtonElement>('.ex-modes button');
  // começa pelo aparelho de quem está vendo
  let modo = new URLSearchParams(location.search).get('dispositivo') || (innerWidth < 768 ? 'celular' : innerWidth < 1024 ? 'tablet' : innerWidth < 1440 ? 'notebook' : 'desktop');
  if (!modos.includes(modo)) modo = 'celular';
  let escolhido = false; // se a pessoa clicou num aparelho, o ciclo para de trocar sozinho
  function mudarModo(m: string) {
    modo = m;
    ex.dataset.mode = m;
    botoes.forEach((b) => { const on = b.dataset.m === m; b.classList.toggle('on', on); b.setAttribute('aria-selected', String(on)); });
  }
  mudarModo(modo);
  const itens = Array.from(root.querySelectorAll<HTMLElement>('.ex-f'));
  itens.forEach((el) => gsap.set(el, { z: Number(el.dataset.z || 60) })); // profundidade: quanto maior, mais "fora" da tela

  // distância de cada item até o centro da tela do celular (de onde ele "sai")
  function aoCentro(el: HTMLElement) {
    const s = scene.getBoundingClientRect(), r = el.getBoundingClientRect();
    return { x: s.left + s.width / 2 - (r.left + r.width / 2), y: s.top + s.height / 2 - (r.top + r.height / 2) };
  }

  if (reduce) {
    botoes.forEach((b) => b.addEventListener('click', () => mudarModo(b.dataset.m!)));
    root.querySelectorAll('.hc-n').forEach((n) => (n.textContent = (n as HTMLElement).dataset.to!));
  } else {
    // entrada dos textos
    const tl = gsap.timeline({ delay: .2 });
    tl.from('.hc-w', { yPercent: 110, rotationX: -60, opacity: 0, filter: 'blur(12px)', duration: 1.2, stagger: .08, ease: 'expo.out' })
      .from('.hc-r', { y: 30, opacity: 0, filter: 'blur(10px)', duration: .9, stagger: .12, ease: 'power3.out' }, '-=.8')
      .from(phone, { opacity: 0, y: 80, rotationY: -40, scale: .85, duration: 1.4, ease: 'expo.out' }, .3)
      .from('.ex-luz', { opacity: 0, scale: .6, duration: 1.6, ease: 'power2.out' }, .5)
      .add(() => root.querySelectorAll<HTMLElement>('.hc-n').forEach((n) => contar(n, Number(n.dataset.to), 2)), 1.2)
      .add(() => ciclo(), 1.1);

    // ciclo: produtos saltam da tela, flutuam e voltam para dentro do celular
    const flutuar: gsap.core.Tween[] = [];
    let primeiro = true;
    let atual: gsap.core.Timeline | undefined;
    function ciclo() {
      flutuar.forEach((t) => t.kill()); flutuar.length = 0;
      // a partir do 2º ciclo troca de aparelho e espera ele terminar de mudar de forma
      if (!primeiro && !escolhido) { mudarModo(modos[(modos.indexOf(modo) + 1) % modos.length]); gsap.delayedCall(.95, explodir); }
      else explodir();
      primeiro = false;
    }
    function explodir() {
      const c = gsap.timeline({ onComplete: ciclo });
      atual = c;
      itens.forEach((el, i) => {
        const d = aoCentro(el);
        gsap.set(el, { x: d.x, y: d.y, scale: .2, opacity: 0, rotationY: -25 });
        c.to(el, { x: 0, y: 0, scale: 1, opacity: 1, rotationY: 0, duration: 1.1, ease: 'expo.out' }, i * .12);
      });
      c.add(() => itens.forEach((el, i) => flutuar.push(gsap.to(el, { y: (i % 2 ? 1 : -1) * 10, rotation: (i % 2 ? .8 : -.8), duration: 2.2 + (i % 3) * .4, yoyo: true, repeat: -1, ease: 'sine.inOut' }))))
        .to({}, { duration: 5.5 })
        .add(() => { flutuar.forEach((t) => t.kill()); flutuar.length = 0; })
        .to(itens, { x: (_i: number, el: HTMLElement) => aoCentro(el).x + Number(gsap.getProperty(el, 'x')), y: (_i: number, el: HTMLElement) => aoCentro(el).y + Number(gsap.getProperty(el, 'y')), scale: .2, opacity: 0, rotation: 0, duration: .7, stagger: .05, ease: 'power3.in' })
        .to({}, { duration: .5 });
    }

    botoes.forEach((b) => b.addEventListener('click', () => {
      escolhido = true;
      atual?.kill(); flutuar.forEach((t) => t.kill()); flutuar.length = 0;
      gsap.to(itens, { scale: .2, opacity: 0, duration: .3 });
      mudarModo(b.dataset.m!);
      gsap.delayedCall(.95, explodir);
    }));

    // aparelho "respira" e a cena acompanha o mouse
    gsap.to(phone, { y: -8, duration: 3, yoyo: true, repeat: -1, ease: 'sine.inOut' });
    root.addEventListener('mousemove', (e) => {
      const r = root.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      gsap.to(scene, { rotationY: -14 + x * 18, rotationX: 6 - y * 12, duration: 1.2, ease: 'power3.out' });
    });
    root.addEventListener('mouseleave', () => gsap.to(scene, { rotationY: -14, rotationX: 6, duration: 1.4, ease: 'power3.out' }));
  }
</script>
