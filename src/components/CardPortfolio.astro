---
// Card do portfólio: foto do notebook + celular (public/portfolio/mockup-note-cel.webp) com o print real
// do site encaixado em cada tela por perspectiva (matrix3d). As telas rolam ao passar o mouse.
// Coordenadas dos cantos das telas medidas na foto original (368×288).
import { waLink } from '../config';
type Print = [string, number, number]; // [arquivo, largura, altura]
interface Props { nome: string; tipo: string; descricao: string; url: string; logo?: string; lap: Print; cel: Print }
const { nome, tipo, descricao, url, lap, cel } = Astro.props;
const dominio = url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

type P = [number, number];
// homografia: leva o retângulo w×h para o quadrilátero q (sup-esq, sup-dir, inf-dir, inf-esq)
function matriz(w: number, h: number, q: [P, P, P, P]) {
  const src: P[] = [[0, 0], [w, 0], [w, h], [0, h]];
  const A: number[][] = [], b: number[] = [];
  src.forEach(([x, y], i) => {
    const [u, v] = q[i];
    A.push([x, y, 1, 0, 0, 0, -u * x, -u * y]); b.push(u);
    A.push([0, 0, 0, x, y, 1, -v * x, -v * y]); b.push(v);
  });
  for (let c = 0; c < 8; c++) { // eliminação de Gauss
    let m = c; for (let r = c + 1; r < 8; r++) if (Math.abs(A[r][c]) > Math.abs(A[m][c])) m = r;
    [A[c], A[m]] = [A[m], A[c]]; [b[c], b[m]] = [b[m], b[c]];
    for (let r = 0; r < 8; r++) if (r !== c) {
      const f = A[r][c] / A[c][c];
      for (let k = c; k < 8; k++) A[r][k] -= f * A[c][k];
      b[r] -= f * b[c];
    }
  }
  const [a, bb, c, d, e, f, g, hh] = b.map((v, i) => v / A[i][i]);
  return `matrix3d(${[a, d, 0, g, bb, e, 0, hh, 0, 0, 1, 0, c, f, 0, 1].map((n) => +n.toFixed(8)).join(',')})`;
}
const TL = 720, TH = 450;   // tela do notebook (proporção 16:10)
const CL = 300, CH = 650;   // tela do celular
const mLap = matriz(TL, TH, [[21.4, 26.4], [260.2, 38.8], [267.6, 210.8], [21.9, 223.6]]);
const mCel = matriz(CL, CH, [[278.6, 80.4], [356.8, 79.6], [358, 255.6], [279.6, 256.8]]);
---
<article class="pf">
  <a class="pf-cena" href={url} target="_blank" rel="noopener" aria-label={`Abrir o site ${nome}`}>
    <span class="pf-palco" aria-hidden="true">
      <img class="pf-base" src="/portfolio/mockup-note-cel.webp" alt="" width="736" height="576" loading="lazy" decoding="async" />
      <span class="pf-tela pf-tela--lap" style={`width:${TL}px;height:${TH}px;transform:${mLap}`}>
        <img src={lap[0]} alt="" width={lap[1]} height={lap[2]} loading="lazy" decoding="async" />
      </span>
      <span class="pf-tela pf-tela--cel" style={`width:${CL}px;height:${CH}px;transform:${mCel}`}>
        <img src={cel[0]} alt="" width={cel[1]} height={cel[2]} loading="lazy" decoding="async" />
      </span>
    </span>
  </a>
  <div class="pf-txt">
    <span class="pf-tipo">{tipo}</span>
    <h3>{nome}</h3>
    <p>{descricao}</p>
    <a class="pf-link" href={url} target="_blank" rel="noopener">{dominio} <span aria-hidden="true">↗</span></a>
    <a class="pf-cta" href={waLink(`Olá! Vi o site ${nome} (${dominio}) no portfólio da MKT Center e quero um site nesse modelo.`)} target="_blank" rel="noopener">Quero esse modelo <svg viewBox="0 0 32 32" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.7-.4z" /></svg></a>
  </div>
</article>

<style>
  .pf{display:flex;flex-direction:column;border-radius:16px;border:1px solid rgba(255,255,255,.1);background:rgba(17,19,23,.6);overflow:hidden;transition:border-color .3s,transform .3s}
  .pf:hover{border-color:rgba(255,138,36,.6);transform:translateY(-4px)}

  /* a foto tem 368×288; o palco fica nesse tamanho e é escalado para a largura do card (--k, via script) */
  .pf-cena{position:relative;display:block;aspect-ratio:368/255;overflow:hidden;
    background:radial-gradient(60% 50% at 45% 55%,rgba(255,105,0,.24),transparent 70%),linear-gradient(180deg,#0d0e12,#131519)}
  .pf-palco{position:absolute;left:0;top:0;width:368px;height:288px;transform:scale(calc(var(--k,1) * .9)) translate(17px,-1px);transform-origin:0 0}
  .pf-palco::before{content:"";position:absolute;left:20px;right:2px;top:256px;height:26px;border-radius:50%;background:radial-gradient(closest-side,rgba(0,0,0,.85),transparent);filter:blur(6px)}
  .pf-base{position:absolute;inset:0;width:368px;height:288px;filter:drop-shadow(0 10px 14px rgba(0,0,0,.55))}
  .pf-tela{position:absolute;left:0;top:0;overflow:hidden;transform-origin:0 0;background:#fff}
  .pf-tela--cel{border-radius:30px}
  .pf-tela::after{content:"";position:absolute;inset:0;background:linear-gradient(120deg,rgba(255,255,255,.16),transparent 35%);pointer-events:none}
  .pf-tela img{position:absolute;left:0;top:0;width:100%;height:auto;transition:transform 1.2s ease}
  .pf:hover .pf-tela--lap img{transform:translateY(calc(-100% + 450px));transition:transform 9s linear}
  .pf:hover .pf-tela--cel img{transform:translateY(calc(-100% + 650px));transition:transform 9s linear .4s}
  @media(hover:none){
    .pf-tela--lap img{animation:pf-rola-lap 18s ease-in-out infinite alternate}
    .pf-tela--cel img{animation:pf-rola-cel 18s ease-in-out -9s infinite alternate}
  }
  @keyframes pf-rola-lap{0%,10%{transform:translateY(0)}90%,100%{transform:translateY(calc(-100% + 450px))}}
  @keyframes pf-rola-cel{0%,10%{transform:translateY(0)}90%,100%{transform:translateY(calc(-100% + 650px))}}
  @media(prefers-reduced-motion:reduce){.pf-tela img{animation:none !important;transition:none !important;transform:none !important}}

  .pf-txt{flex:1;padding:12px 16px 14px;display:flex;flex-direction:column;gap:4px;text-align:left}
  .pf-tipo{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#ff8a24}
  .pf h3{margin:0;font-size:18px}
  .pf p{margin:0 0 6px;font-size:13px;line-height:1.5;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;color:#aeb4bd}
  .pf-cta{display:flex;align-items:center;justify-content:center;gap:7px;width:100%;height:34px;margin-top:10px;border-radius:999px;border:1px solid rgba(255,255,255,.16);background:transparent;color:#aeb4bd;font-size:13px;font-weight:600;text-decoration:none;transition:color .2s,border-color .2s,background .2s}
  .pf-cta svg{width:15px;height:15px}
  .pf-cta:hover,.pf-cta:focus-visible{color:#ff8a24;border-color:rgba(255,138,36,.6);background:rgba(255,138,36,.06)}
  .pf-link{margin-top:auto;align-self:flex-start;max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:700;font-size:12px;letter-spacing:-.01em;color:#fff;text-decoration:none;border-bottom:1px solid rgba(255,138,36,.6);padding-bottom:2px}
  .pf-link:hover{color:#ff8a24}
</style>

<script>
  const cenas = document.querySelectorAll<HTMLElement>('.pf-cena');
  const ro = new ResizeObserver((es) => es.forEach((e) => (e.target as HTMLElement).style.setProperty('--k', String(e.contentRect.width / 368))));
  cenas.forEach((c) => ro.observe(c));
</script>
