---
// Hero cinematográfico (porte do componente React "cinematic-landing-hero" para Astro + GSAP, sem React/Tailwind).
// Dados de exemplo (fictícios) — ver CLAUDE.md.
import { waLink } from '../config';
import Icon from './Icon.astro';
const {
  brandName = 'MKT',
  tagline1 = 'Sua empresa vendendo',
  tagline2 = 'mais na internet.',
  cardHeading = 'Marketing que vira cliente.',
  cardDescription = 'A MKT Center cria sites, apps, lojas virtuais e campanhas que levam o cliente direto para o seu WhatsApp, com cada contato medido.',
  metricValue = 248,
  metricLabel = 'Contatos no mês',
  ctaHeading = 'Vamos crescer juntos?',
  ctaDescription = 'Fale com a gente pelo WhatsApp e receba uma proposta para o seu negócio ainda hoje.',
} = Astro.props;
---
<section class="ch" id="hero" data-metric={metricValue}>
  <div class="film-grain" aria-hidden="true"></div>
  <div class="bg-grid-theme" aria-hidden="true"></div>

  <div class="hero-text-wrapper">
    <h1>
      <span class="text-track gsap-reveal text-3d-matte">{tagline1}</span>
      <span class="text-days gsap-reveal text-silver-matte">{tagline2}</span>
    </h1>
  </div>

  <div class="cta-wrapper gsap-reveal">
    <h2 class="text-silver-matte">{ctaHeading}</h2>
    <p>{ctaDescription}</p>
    <div class="cta-btns">
      <a href={waLink()} target="_blank" rel="noopener" class="btn-modern-light">
        <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path fill="#25d366" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm5.9 15.7c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.7-.4z"/></svg>
        <span><small>Fale agora no</small><strong>WhatsApp</strong></span>
      </a>
      <a href="#servicos" class="btn-modern-dark">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#ff6900" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        <span><small>Conheça nossos</small><strong>Serviços</strong></span>
      </a>
    </div>
  </div>

  <div class="card-layer">
    <div class="main-card premium-depth-card gsap-reveal">
      <div class="card-sheen" aria-hidden="true"></div>
      <div class="card-grid">
        <div class="card-right-text gsap-reveal">
          <p class="brand text-card-silver-matte" aria-hidden="true">{brandName}</p>
        </div>

        <div class="mockup-scroll-wrapper">
          <div class="mockup-scale">
            <div class="iphone-bezel">
              <div class="hardware-btn" style="top:120px;left:-3px;height:25px"></div>
              <div class="hardware-btn" style="top:160px;left:-3px;height:45px"></div>
              <div class="hardware-btn" style="top:220px;left:-3px;height:45px"></div>
              <div class="hardware-btn" style="top:170px;right:-3px;height:70px;transform:scaleX(-1)"></div>
              <div class="screen">
                <div class="screen-glare" aria-hidden="true"></div>
                <div class="island"><i></i></div>
                <div class="app">
                  <div class="phone-widget app-top">
                    <div><small>Hoje</small><strong>Resultados</strong></div>
                    <span class="avatar">MK</span>
                  </div>
                  <div class="phone-widget ring">
                    <svg viewBox="0 0 176 176" aria-hidden="true">
                      <circle cx="88" cy="88" r="64" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="12" />
                      <circle class="progress-ring" cx="88" cy="88" r="64" fill="none" stroke="#ff6900" stroke-width="12" />
                    </svg>
                    <div class="ring-txt"><span class="counter-val">0</span><small>{metricLabel}</small></div>
                  </div>
                  <div class="phone-widget widget-depth row">
                    <span class="ico ico-o"><Icon name="message" size={18} /></span>
                    <div><b>Novo contato no WhatsApp</b><em>Criação de Sites · agora</em></div>
                  </div>
                  <div class="phone-widget widget-depth row">
                    <span class="ico ico-g"><Icon name="trending" size={18} /></span>
                    <div><b>Campanha Google Ads</b><em>Custo por contato −40%</em></div>
                  </div>
                  <div class="home-bar"></div>
                </div>
              </div>
            </div>

            <div class="floating-badge floating-ui-badge b1">
              <span class="b-ico"><Icon name="rocket" size={18} /></span>
              <div><b>+112% contatos</b><em>em 2 meses</em></div>
            </div>
            <div class="floating-badge floating-ui-badge b2">
              <span class="b-ico"><Icon name="star" size={18} /></span>
              <div><b>1º no Google</b><em>na sua cidade</em></div>
            </div>
          </div>
        </div>

        <div class="card-left-text gsap-reveal">
          <h3>{cardHeading}</h3>
          <p><strong>MKT Center</strong> {cardDescription.replace(/^A MKT Center /, '')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ch{--fg:#111317;position:relative;width:100%;height:calc(100vh - 68px);height:calc(100svh - 68px);overflow:hidden;display:flex;align-items:center;justify-content:center;background:var(--preto);color:var(--fg);perspective:1500px}
  .gsap-reveal{visibility:hidden}
  .film-grain{position:absolute;inset:0;pointer-events:none;z-index:50;opacity:.05;mix-blend-mode:overlay;background:url('data:image/svg+xml;utf8,<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(%23n)"/></svg>')}
  .bg-grid-theme{position:absolute;inset:0;z-index:0;pointer-events:none;opacity:.5;background-size:60px 60px;background-image:linear-gradient(to right,rgba(17,19,23,.06) 1px,transparent 1px),linear-gradient(to bottom,rgba(17,19,23,.06) 1px,transparent 1px);mask-image:radial-gradient(ellipse at center,black 0%,transparent 70%);-webkit-mask-image:radial-gradient(ellipse at center,black 0%,transparent 70%)}

  .hero-text-wrapper{position:absolute;z-index:10;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:0 16px;will-change:transform}
  .hero-text-wrapper h1{display:flex;flex-direction:column;gap:.1em;font-family:var(--ff-tit);font-size:clamp(52px,10vw,88px);line-height:.9;text-transform:uppercase;letter-spacing:-.02em}
  .text-track,.text-days{display:block}
  .text-3d-matte{color:var(--fg);text-shadow:0 10px 30px rgba(17,19,23,.2),0 2px 4px rgba(17,19,23,.1)}
  .text-silver-matte{background:linear-gradient(180deg,#111317 0%,rgba(17,19,23,.4) 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;transform:translateZ(0);filter:drop-shadow(0 10px 20px rgba(17,19,23,.15)) drop-shadow(0 2px 4px rgba(17,19,23,.1))}
  .text-days{background:linear-gradient(180deg,#ff8a24 0%,#a84300 100%);-webkit-background-clip:text;background-clip:text}
  .text-card-silver-matte{background:linear-gradient(180deg,#fff 0%,#a1a1aa 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;transform:translateZ(0);filter:drop-shadow(0 12px 24px rgba(0,0,0,.8)) drop-shadow(0 4px 8px rgba(0,0,0,.6))}

  .cta-wrapper{position:absolute;z-index:10;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 16px;will-change:transform}
  .cta-wrapper h2{font-size:clamp(44px,7vw,72px);margin-bottom:20px}
  .cta-wrapper p{color:var(--prata);font-size:1.15rem;max-width:560px;margin-bottom:40px}
  .cta-btns{display:flex;flex-direction:column;gap:20px}
  @media(min-width:640px){.cta-btns{flex-direction:row}}
  .cta-btns a{display:flex;align-items:center;gap:12px;padding:16px 32px;border-radius:1.25rem;text-decoration:none;text-align:left}
  .cta-btns small{display:block;font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;opacity:.6;margin-bottom:-2px}
  .cta-btns strong{font-size:1.25rem;line-height:1}
  .btn-modern-light,.btn-modern-dark{transition:all .4s cubic-bezier(.25,1,.5,1)}
  .btn-modern-light{background:linear-gradient(180deg,#fff 0%,#f1f5f9 100%);color:#0f172a;box-shadow:0 0 0 1px rgba(0,0,0,.05),0 2px 4px rgba(0,0,0,.1),0 12px 24px -4px rgba(0,0,0,.3),inset 0 1px 1px #fff,inset 0 -3px 6px rgba(0,0,0,.06)}
  .btn-modern-light:hover{transform:translateY(-3px);box-shadow:0 0 0 1px rgba(0,0,0,.05),0 6px 12px -2px rgba(0,0,0,.15),0 20px 32px -6px rgba(0,0,0,.4),inset 0 1px 1px #fff,inset 0 -3px 6px rgba(0,0,0,.06)}
  .btn-modern-dark{background:linear-gradient(180deg,#27272a 0%,#18181b 100%);color:#fff;box-shadow:0 0 0 1px rgba(255,255,255,.1),0 2px 4px rgba(0,0,0,.6),0 12px 24px -4px rgba(0,0,0,.9),inset 0 1px 1px rgba(255,255,255,.15),inset 0 -3px 6px rgba(0,0,0,.8)}
  .btn-modern-dark:hover{transform:translateY(-3px);background:linear-gradient(180deg,#3f3f46 0%,#27272a 100%)}

  .card-layer{position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;pointer-events:none;perspective:1500px}
  .main-card{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;pointer-events:auto;width:92vw;height:92%;border-radius:32px}
  @media(min-width:768px){.main-card{width:85vw;height:85%;border-radius:40px}}
  .premium-depth-card{background:linear-gradient(145deg,#2a1608 0%,#090a0c 55%,#111317 100%);box-shadow:0 40px 100px -20px rgba(0,0,0,.9),0 20px 40px -20px rgba(0,0,0,.8),inset 0 1px 2px rgba(255,255,255,.2),inset 0 -2px 4px rgba(0,0,0,.8);border:1px solid rgba(255,255,255,.04)}
  .card-sheen{position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:50;background:radial-gradient(800px circle at var(--mouse-x,50%) var(--mouse-y,50%),rgba(255,140,60,.08) 0%,transparent 40%);mix-blend-mode:screen}
  .card-grid{position:relative;z-index:10;width:100%;height:100%;max-width:1140px;margin:0 auto;padding:24px 16px;display:flex;flex-direction:column;justify-content:space-evenly;align-items:center}
  @media(min-width:1024px){.card-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:32px;padding:0 48px}}
  .card-right-text{order:1;display:flex;justify-content:center;width:100%}
  .brand{font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;letter-spacing:-.03em;line-height:1;font-size:clamp(4rem,12vw,9rem)}
  .card-left-text{order:3;text-align:center;width:100%;color:#fff}
  .card-left-text h3{font-family:var(--ff-txt);text-transform:none;font-size:clamp(1.5rem,3vw,2.4rem);letter-spacing:-.02em;line-height:1.15}
  .card-left-text p{display:none;color:rgba(255,226,204,.72);font-size:1.05rem;margin-top:16px}
  .card-left-text p strong{color:#fff}
  @media(min-width:768px){.card-left-text p{display:block}}
  @media(min-width:1024px){.card-left-text{order:1;text-align:left}.card-right-text{order:3;justify-content:flex-end}.mockup-scroll-wrapper{order:2}}

  .mockup-scroll-wrapper{order:2;position:relative;width:100%;height:380px;display:flex;align-items:center;justify-content:center;perspective:1000px}
  @media(min-width:1024px){.mockup-scroll-wrapper{height:600px}}
  .mockup-scale{position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center;transform:scale(.62)}
  @media(min-width:768px){.mockup-scale{transform:scale(.8)}}
  @media(min-width:1024px){.mockup-scale{transform:none}}
  .iphone-bezel{position:relative;width:280px;height:580px;border-radius:3rem;background:#111;box-shadow:inset 0 0 0 2px #52525b,inset 0 0 0 7px #000,0 40px 80px -15px rgba(0,0,0,.9),0 15px 25px -5px rgba(0,0,0,.7);transform-style:preserve-3d;will-change:transform}
  .hardware-btn{position:absolute;width:3px;border-radius:4px 0 0 4px;background:linear-gradient(90deg,#404040,#171717)}
  .screen{position:absolute;inset:7px;background:#0b0705;border-radius:2.5rem;overflow:hidden;box-shadow:inset 0 0 15px #000;color:#fff;z-index:10}
  .screen-glare{position:absolute;inset:0;z-index:40;pointer-events:none;background:linear-gradient(110deg,rgba(255,255,255,.08) 0%,rgba(255,255,255,0) 45%)}
  .island{position:absolute;top:5px;left:50%;transform:translateX(-50%);width:100px;height:28px;background:#000;border-radius:99px;z-index:50;display:flex;align-items:center;justify-content:flex-end;padding:0 12px}
  .island i{width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 8px rgba(34,197,94,.8)}
  .app{position:relative;height:100%;padding:48px 20px 32px;display:flex;flex-direction:column}
  .app-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}
  .app-top small{display:block;font-size:10px;color:#a3a3a3;text-transform:uppercase;letter-spacing:.15em;font-weight:700}
  .app-top strong{font-size:1.25rem}
  .avatar{width:36px;height:36px;border-radius:50%;background:rgba(255,105,0,.15);border:1px solid rgba(255,105,0,.35);display:grid;place-items:center;font-weight:700;font-size:.8rem;color:#ffb27a}
  .ring{position:relative;width:176px;height:176px;margin:0 auto 28px;display:flex;align-items:center;justify-content:center;filter:drop-shadow(0 15px 25px rgba(0,0,0,.8))}
  .ring svg{position:absolute;inset:0;width:100%;height:100%}
  .progress-ring{transform:rotate(-90deg);transform-origin:center;stroke-dasharray:402;stroke-dashoffset:402;stroke-linecap:round}
  .ring-txt{display:flex;flex-direction:column;align-items:center;z-index:1}
  .counter-val{font-size:2.4rem;font-weight:800;letter-spacing:-.04em}
  .ring-txt small{font-size:8px;color:rgba(255,178,122,.6);text-transform:uppercase;letter-spacing:.1em;font-weight:700}
  .row{display:flex;align-items:center;gap:12px;padding:12px;border-radius:16px;margin-bottom:12px}
  .widget-depth{background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.01));box-shadow:0 10px 20px rgba(0,0,0,.3),inset 0 1px 1px rgba(255,255,255,.05),inset 0 -1px 1px rgba(0,0,0,.5);border:1px solid rgba(255,255,255,.03)}
  .ico{width:40px;height:40px;flex:none;border-radius:12px;display:grid;place-items:center;font-size:1rem}
  .ico{color:#ff8a24}.ico-g{color:#3ddc97}.b-ico{color:#ff8a24}.ico-o{background:linear-gradient(135deg,rgba(255,105,0,.2),rgba(255,105,0,.05));border:1px solid rgba(255,105,0,.25)}
  .ico-g{background:linear-gradient(135deg,rgba(16,185,129,.2),rgba(16,185,129,.05));border:1px solid rgba(16,185,129,.25)}
  .row b,.floating-badge b{display:block;font-size:.75rem;line-height:1.3}
  .row em,.floating-badge em{display:block;font-style:normal;font-size:.68rem;color:#a3a3a3}
  .home-bar{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:120px;height:4px;background:rgba(255,255,255,.2);border-radius:99px}
  .floating-ui-badge{background:linear-gradient(135deg,rgba(255,255,255,.08),rgba(255,255,255,.01));backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);box-shadow:0 0 0 1px rgba(255,255,255,.1),0 25px 50px -12px rgba(0,0,0,.8),inset 0 1px 1px rgba(255,255,255,.2),inset 0 -1px 1px rgba(0,0,0,.5)}
  .floating-badge{position:absolute;display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:16px;z-index:30;color:#fff}
  .floating-badge b{font-size:.85rem}
  .b-ico{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:rgba(255,105,0,.15);border:1px solid rgba(255,105,0,.3)}
  .b1{top:24px;left:-15px}
  .b2{bottom:48px;right:-15px}
  @media(min-width:1024px){.b1{top:48px;left:-80px}.b2{bottom:80px;right:-80px}}

  @media (prefers-reduced-motion: reduce){
    .gsap-reveal{visibility:visible}
    .hero-text-wrapper,.cta-wrapper{display:none}
    .main-card{width:100%;height:100%;border-radius:0}
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.getElementById('hero')!;
  const metricValue = Number(root.dataset.metric || 0);
  const card = root.querySelector<HTMLElement>('.main-card')!;
  const mockup = root.querySelector<HTMLElement>('.iphone-bezel')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduce) {
    root.querySelector('.counter-val')!.textContent = String(metricValue);
    (root.querySelector('.progress-ring') as SVGElement).style.strokeDashoffset = '60';
  } else {
    let raf = 0;
    addEventListener('mousemove', (e) => {
      if (scrollY > innerHeight * 2) return;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mouse-x', `${e.clientX - r.left}px`);
        card.style.setProperty('--mouse-y', `${e.clientY - r.top}px`);
        const x = (e.clientX / innerWidth - 0.5) * 2;
        const y = (e.clientY / innerHeight - 0.5) * 2;
        gsap.to(mockup, { rotationY: x * 12, rotationX: -y * 12, ease: 'power3.out', duration: 1.2 });
      });
    });

    const isMobile = innerWidth < 768;
    gsap.context(() => {
      gsap.set('.text-track', { autoAlpha: 0, y: 60, scale: 0.85, filter: 'blur(20px)', rotationX: -20 });
      gsap.set('.text-days', { autoAlpha: 1, clipPath: 'inset(0 100% 0 0)' });
      gsap.set('.main-card', { y: innerHeight + 200, autoAlpha: 1 });
      gsap.set(['.card-left-text', '.card-right-text', '.mockup-scroll-wrapper', '.floating-badge', '.phone-widget'], { autoAlpha: 0 });
      gsap.set('.cta-wrapper', { autoAlpha: 0, scale: 0.8, filter: 'blur(30px)' });

      gsap.timeline({ delay: 0.3 })
        .to('.text-track', { duration: 1.8, autoAlpha: 1, y: 0, scale: 1, filter: 'blur(0px)', rotationX: 0, ease: 'expo.out' })
        .to('.text-days', { duration: 1.4, clipPath: 'inset(0 0% 0 0)', ease: 'power4.inOut' }, '-=1.0');

      gsap.timeline({
        scrollTrigger: { trigger: root, start: 'top 68px', end: '+=7000', pin: true, scrub: 1, anticipatePin: 1 },
      })
        .to(['.hero-text-wrapper', '.bg-grid-theme'], { scale: 1.15, filter: 'blur(20px)', opacity: 0.2, ease: 'power2.inOut', duration: 2 }, 0)
        .to('.main-card', { y: 0, ease: 'power3.inOut', duration: 2 }, 0)
        .to('.main-card', { width: '100%', height: '100%', borderRadius: '0px', ease: 'power3.inOut', duration: 1.5 })
        .fromTo('.mockup-scroll-wrapper',
          { y: 300, z: -500, rotationX: 50, rotationY: -30, autoAlpha: 0, scale: 0.6 },
          { y: 0, z: 0, rotationX: 0, rotationY: 0, autoAlpha: 1, scale: 1, ease: 'expo.out', duration: 2.5 }, '-=0.8')
        .fromTo('.phone-widget', { y: 40, autoAlpha: 0, scale: 0.95 }, { y: 0, autoAlpha: 1, scale: 1, stagger: 0.15, ease: 'back.out(1.2)', duration: 1.5 }, '-=1.5')
        .to('.progress-ring', { strokeDashoffset: 60, duration: 2, ease: 'power3.inOut' }, '-=1.2')
        .to('.counter-val', { innerHTML: metricValue, snap: { innerHTML: 1 }, duration: 2, ease: 'expo.out' }, '-=2.0')
        .fromTo('.floating-badge', { y: 100, autoAlpha: 0, scale: 0.7, rotationZ: -10 }, { y: 0, autoAlpha: 1, scale: 1, rotationZ: 0, ease: 'back.out(1.5)', duration: 1.5, stagger: 0.2 }, '-=2.0')
        .fromTo('.card-left-text', { x: -50, autoAlpha: 0 }, { x: 0, autoAlpha: 1, ease: 'power4.out', duration: 1.5 }, '-=1.5')
        .fromTo('.card-right-text', { x: 50, autoAlpha: 0, scale: 0.8 }, { x: 0, autoAlpha: 1, scale: 1, ease: 'expo.out', duration: 1.5 }, '<')
        .to({}, { duration: 2.5 })
        .set('.hero-text-wrapper', { autoAlpha: 0 })
        .set('.cta-wrapper', { autoAlpha: 1 })
        .to({}, { duration: 1.5 })
        .to(['.mockup-scroll-wrapper', '.floating-badge', '.card-left-text', '.card-right-text'], {
          scale: 0.9, y: -40, z: -200, autoAlpha: 0, ease: 'power3.in', duration: 1.2, stagger: 0.05,
        })
        .to('.main-card', {
          width: isMobile ? '92vw' : '85vw', height: isMobile ? '92%' : '85%',
          borderRadius: isMobile ? '32px' : '40px', ease: 'expo.inOut', duration: 1.8,
        }, 'pullback')
        .to('.cta-wrapper', { scale: 1, filter: 'blur(0px)', ease: 'expo.inOut', duration: 1.8 }, 'pullback')
        .to('.main-card', { y: -innerHeight - 300, ease: 'power3.in', duration: 1.5 });
    }, root);
  }
</script>
