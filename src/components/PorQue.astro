---
// Seção "Por que a MKT Center": 6 cards em 2 linhas de 3, no estilo editorial escuro com objeto 3D
// brilhante (3D real com Three.js, src/scripts/objetos3d.ts), ondas de luz laranja, número, título, descrição e link.
const itens = [
  { n: '01', t: 'Estratégia', d: 'Clareza para decidir o que realmente importa no seu digital.', l: 'Como trabalhamos', h: '/quem-somos/', arte: 'alvo' },
  { n: '02', t: 'Todas as telas', d: 'Nossos projetos são pensados para celular, tablet, notebook e computador.', l: 'Ver projetos', h: '/portfolio/', arte: 'celular' },
  { n: '03', t: 'Contato direto', d: 'Cada página leva o visitante para o seu WhatsApp.', l: 'Falar agora', h: '/contato/', arte: 'chat' },
  { n: '04', t: 'Google', d: 'Sites rápidos e prontos para aparecer nas buscas.', l: 'Tráfego e SEO', h: '/trafego-e-seo/', arte: 'lupa' },
  { n: '05', t: 'Resultado medido', d: 'Você sabe de onde vem cada contato e cada venda.', l: 'Ver resultados', h: '/portfolio/', arte: 'grafico' },
  { n: '06', t: 'Posicionamento', d: 'Uma agência para todo o digital, sem jargão.', l: 'Conheça a MKT', h: '/quem-somos/', arte: 'cavalo' },
];
---
<section class="pq" id="por-que">
  <div class="wrap">
    <span class="eyebrow">Por que a MKT Center</span>
    <h2>Feito para dar resultado</h2>
    <div class="pq-grid">
      {itens.map((it, i) => (
        <article class="pq-card card" style={`--d:${i * .08}s`}>
          <div class="pq-arte" aria-hidden="true">
            <svg class="pq-onda" viewBox="0 0 400 200" preserveAspectRatio="none">
              <path d="M-10 150 C 80 110, 140 170, 220 130 S 360 90, 410 120" />
              <path d="M-10 165 C 90 135, 160 185, 240 150 S 370 115, 410 140" />
              <path d="M-10 120 C 70 140, 170 95, 260 120 S 360 150, 410 100" />
            </svg>
            <span class="pq-luz"></span>
            <canvas class="pq-obj" data-obj3d={it.arte}></canvas>
          </div>
          <div class="pq-txt">
            <span class="pq-n">{it.n}</span>
            <h3>{it.t}</h3>
            <p>{it.d}</p>
            <a href={it.h}>{it.l} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>

  .pq-grid{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:640px){.pq-grid{grid-template-columns:repeat(3,1fr)}}
  @media(min-width:1024px){.pq-grid{grid-template-columns:repeat(6,1fr);gap:12px}}

  .pq-card{position:relative;display:flex;flex-direction:column;padding:0;border-radius:var(--radius-lg);overflow:hidden;text-align:left;
    background:radial-gradient(120% 80% at 50% 30%,#17181c,#0a0b0d 70%);border:1px solid rgba(255,255,255,.07);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.06),0 20px 40px -24px rgba(0,0,0,.9);transition:border-color .3s,transform .3s}
  .pq-card:hover{border-color:rgba(255,105,0,.45);transform:translateY(-4px)}
  .pq-arte{position:relative;aspect-ratio:1/.8}
  .pq-onda{position:absolute;inset:0;width:100%;height:100%}
  .pq-onda path{fill:none;stroke:#ff4d00;stroke-width:1.6;stroke-linecap:round;filter:drop-shadow(0 0 4px #ff6900);opacity:.7;stroke-dasharray:420;animation:pq-onda 6s ease-in-out infinite alternate}
  .pq-onda path:nth-child(2){opacity:.4;animation-delay:-2s}
  .pq-onda path:nth-child(3){opacity:.25;animation-delay:-4s}
  @keyframes pq-onda{from{stroke-dashoffset:60}to{stroke-dashoffset:-60}}
  .pq-obj{position:absolute;inset:0;width:100%;height:100%;display:block}
  .pq-luz{position:absolute;left:20%;right:20%;bottom:6%;height:14%;border-radius:50%;background:radial-gradient(closest-side,rgba(255,105,0,.55),transparent);filter:blur(6px)}

  .pq-txt{padding:0 16px 18px}
  .pq-n{display:block;font-size:12px;font-weight:700;color:#ff6900;letter-spacing:.06em;margin-bottom:4px}
  .pq-txt h3{font-size:20px;line-height:1.05;color:#fff}
  .pq-txt p{margin-top:6px;color:#aeb4bd;font-size:13px;line-height:19px}
  .pq-txt a{display:inline-flex;align-items:center;gap:6px;margin-top:12px;padding-bottom:3px;border-bottom:1px solid rgba(255,255,255,.35);color:#fff;font-size:13px;font-weight:600;text-decoration:none;transition:border-color .2s,color .2s}
  .pq-txt a:hover{color:#ffb35c;border-color:#ff6900}
  @media(max-width:767px){.pq-txt{text-align:center}}
  @media (prefers-reduced-motion: reduce){.pq-onda path{animation:none}}
</style>

<script>
  // carrega o Three.js só quando a seção chega perto da tela
  const sec = document.getElementById('por-que');
  if (sec) {
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      import('../scripts/objetos3d').then((m) => m.iniciarObjetos3D(sec));
    }, { rootMargin: '400px' });
    io.observe(sec);
  }
</script>
