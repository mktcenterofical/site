---
// Faixa laranja escura em largura total: "Invisível não vende." em duas colunas.
// Esquerda: título e subtítulo. Direita: composição de interface (estilo produto): mapa escuro em
// perspectiva com o pin da empresa, busca local sendo digitada, perfil da empresa no Google e um
// indicador de ligações. Dados fictícios — ver CLAUDE.md.

// rede de ruas do mapa (viewBox 600 x 420)
const ruas = [
  'M-20 70 C 120 60, 220 110, 320 95 S 520 60, 640 80',
  'M-20 190 C 90 200, 180 170, 300 205 S 500 250, 640 220',
  'M-20 320 C 140 300, 260 345, 380 320 S 560 300, 640 330',
  'M90 -20 C 100 100, 70 220, 110 440',
  'M250 -20 C 230 110, 280 260, 240 440',
  'M420 -20 C 440 120, 400 250, 450 440',
  'M540 -20 C 520 140, 570 280, 530 440',
];
const vielas = ['M-20 130 L 640 150', 'M-20 260 L 640 275', 'M170 -20 L 190 440', 'M340 -20 L 330 440', 'M-20 380 L 640 370'];
const rota = 'M110 400 C 120 330, 210 330, 245 280 S 300 215, 300 205';
const linha = [8, 14, 11, 19, 16, 24, 22, 31, 29, 38];
const spark = linha.map((v, i) => `${i === 0 ? 'M' : 'L'}${((i * 120) / (linha.length - 1)).toFixed(1)} ${40 - v}`).join(' ');
---
<section class="iv" id="invisivel" aria-labelledby="iv-tit">
  <div class="iv-grade" aria-hidden="true"></div>
  <div class="wrap iv-in">
    <div class="iv-txt">
      <h2 id="iv-tit" class="iv-tit"><span>Invisível</span><span class="iv-tit2">não vende.</span></h2>
      <i class="iv-traco" aria-hidden="true"></i>
      <p class="iv-sub">Apareça para quem <b>já está procurando</b> o que você vende: no Google, no mapa e no momento da decisão.</p>
    </div>

    <div class="iv-arte" aria-hidden="true">
      <div class="iv-mapa">
        <svg viewBox="0 0 600 420" preserveAspectRatio="xMidYMid slice">
          <defs>
            <radialGradient id="iv-vinheta" cx=".5" cy=".5" r=".75"><stop offset=".55" stop-color="#000" stop-opacity="0" /><stop offset="1" stop-color="#000" stop-opacity=".55" /></radialGradient>
            <radialGradient id="iv-calor" cx=".5" cy=".5" r=".5"><stop offset="0" stop-color="#ff7a1a" stop-opacity=".55" /><stop offset="1" stop-color="#ff7a1a" stop-opacity="0" /></radialGradient>
          </defs>
          <rect width="600" height="420" fill="#16181c" />
          <path d="M370 420 C 380 360, 470 330, 600 340 L 600 420 Z" fill="#1b2a33" />
          <rect x="430" y="110" width="80" height="60" rx="10" fill="#1c2620" />
          <rect x="30" y="215" width="50" height="70" rx="8" fill="#1c2620" />
          <g fill="none" stroke="#2a2d33" stroke-width="1.4">{vielas.map((d) => <path d={d} />)}</g>
          <g fill="none" stroke="#3a3e46" stroke-width="5" stroke-linecap="round">{ruas.map((d) => <path d={d} />)}</g>
          <g fill="none" stroke="#4a4f58" stroke-width="1.2">{ruas.map((d) => <path d={d} />)}</g>
          <circle cx="300" cy="205" r="120" fill="url(#iv-calor)" />
          <path d={rota} fill="none" stroke="#ff8a24" stroke-width="5" stroke-linecap="round" />
          <path class="iv-rota" d={rota} fill="none" stroke="#fff1de" stroke-width="5" stroke-linecap="round" pathLength="100" />
          <circle cx="110" cy="400" r="7" fill="#fff" stroke="#4285f4" stroke-width="4" />
          <rect width="600" height="420" fill="url(#iv-vinheta)" />
        </svg>
      </div>

      <span class="iv-onda"></span><span class="iv-onda o2"></span>
      <div class="iv-pin">
        <svg viewBox="0 0 64 84">
          <defs><linearGradient id="iv-pin" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffb35c" /><stop offset="1" stop-color="#ff6900" /></linearGradient></defs>
          <path d="M32 82 C 26 70 4 52 4 31 A 28 28 0 1 1 60 31 C 60 52 38 70 32 82 Z" fill="url(#iv-pin)" stroke="#fff" stroke-width="3" />
          <circle cx="32" cy="31" r="11" fill="#fff" />
        </svg>
      </div>

      <div class="iv-card iv-busca">
        <svg class="iv-g" viewBox="0 0 24 24"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3z" /><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22z" /><path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1A10 10 0 0 0 2 12c0 1.6.4 3.1 1.1 4.6z" /><path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.7 9.4 5.9 12 5.9z" /></svg>
        <span class="iv-q"><span class="iv-digita">padaria perto de mim</span><i class="iv-cursor"></i></span>
        <svg class="iv-lupa" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </div>

      <div class="iv-card iv-metrica">
        <small>Ligações pelo Google</small>
        <div class="iv-met-l"><b>+64%</b><em>este mês</em></div>
        <svg viewBox="0 0 120 44" class="iv-spark"><path d={`${spark} L120 44 L0 44 Z`} fill="rgba(61,220,151,.15)" /><path class="iv-spark-l" d={spark} fill="none" stroke="#3ddc97" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" pathLength="100" /></svg>
      </div>

      <div class="iv-card iv-perfil">
        <div class="iv-foto"><img src="/mock/padaria.webp" alt="" width="640" height="400" loading="lazy" decoding="async" /><span>1º no mapa</span></div>
        <div class="iv-info">
          <b>Padaria Pão Dourado</b>
          <div class="iv-nota"><strong>4,9</strong><span class="iv-est">★★★★★</span><em>(312)</em></div>
          <small>Padaria · <i>Aberto agora</i> · Fecha às 20h</small>
          <div class="iv-acoes">
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" /></svg>Ligar</span>
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 19-9-9 19-2-8z" /></svg>Rotas</span>
            <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20" /></svg>Site</span>
            <span class="iv-wa"><svg viewBox="0 0 32 32" fill="currentColor"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm5.9 15.7c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.7-.4z" /></svg>WhatsApp</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .iv{position:relative;overflow:hidden;isolation:isolate;padding:80px 0;color:#fff;
    background:radial-gradient(700px 520px at 78% 50%,rgba(255,140,40,.32),transparent 70%),linear-gradient(150deg,#a84300 0%,#8a3500 50%,#5a2200 100%)}
  .iv-grade{position:absolute;inset:0;z-index:-1;opacity:.4;background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px);background-size:48px 48px;mask-image:radial-gradient(ellipse at 30% 50%,#000,transparent 70%);-webkit-mask-image:radial-gradient(ellipse at 30% 50%,#000,transparent 70%)}
  .iv-in{display:grid;gap:48px;align-items:center}
  @media(min-width:1024px){.iv-in{grid-template-columns:.85fr 1.15fr;gap:48px}}

  .iv-tit{display:flex;flex-direction:column;margin:0;font-size:clamp(56px,7vw,108px);line-height:.86;letter-spacing:-.02em;color:#fff}
  .iv-tit2{background:linear-gradient(180deg,#fff1de,#ffc993);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .iv-traco{display:block;width:64px;height:3px;margin:24px 0 18px;border-radius:3px;background:#fff1de}
  .iv-sub{font-size:20px;line-height:1.45;color:rgba(255,241,222,.86);max-width:32ch}
  .iv-sub b{color:#fff}

  /* ---------- composição de interface ---------- */
  .iv-arte{position:relative;width:100%;max-width:620px;margin:0 auto;aspect-ratio:1/.86;container-type:inline-size;perspective:1600px;text-align:left}
  .iv-mapa{position:absolute;left:8%;right:4%;top:12%;bottom:14%;border-radius:3cqw;overflow:hidden;background:#16181c;
    box-shadow:0 0 0 1px rgba(255,255,255,.08),0 4cqw 8cqw -2cqw rgba(20,6,0,.85);transform:rotateY(-10deg) rotateX(8deg)}
  .iv-mapa svg{position:absolute;inset:0;width:100%;height:100%}
  .iv-rota{stroke-dasharray:14 86;animation:iv-flui 2.6s linear infinite}
  @keyframes iv-flui{from{stroke-dashoffset:100}to{stroke-dashoffset:0}}
  .iv-pin{position:absolute;z-index:2;left:51%;top:47%;width:9cqw;transform:translate(-50%,-100%);filter:drop-shadow(0 1.2cqw 1.4cqw rgba(0,0,0,.6)) drop-shadow(0 0 2cqw rgba(255,138,36,.7));animation:iv-pula 2.6s ease-in-out infinite}
  .iv-pin svg{display:block;width:100%}
  @keyframes iv-pula{50%{transform:translate(-50%,-100%) translateY(-1cqw)}}
  .iv-onda{position:absolute;z-index:1;left:51%;top:47%;width:14cqw;height:5cqw;margin:-2.5cqw 0 0 -7cqw;border-radius:50%;border:2px solid #ffb35c;opacity:0;animation:iv-onda 2.6s ease-out infinite}
  .iv-onda.o2{animation-delay:-1.3s}
  @keyframes iv-onda{0%{transform:scale(.4);opacity:.9}100%{transform:scale(2.2);opacity:0}}

  .iv-card{position:absolute;border-radius:2cqw;background:rgba(18,19,22,.82);border:1px solid rgba(255,255,255,.12);
    backdrop-filter:blur(16px) saturate(140%);-webkit-backdrop-filter:blur(16px) saturate(140%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 3cqw 6cqw -2cqw rgba(10,3,0,.85);color:#fff}

  .iv-busca{left:0;top:2%;width:62%;display:flex;align-items:center;gap:1.8cqw;padding:1.8cqw 2.4cqw;border-radius:99px;background:rgba(250,248,245,.96);color:#1b1d22;animation:iv-entra 1s cubic-bezier(.2,.8,.2,1) both}
  .iv-g{width:3.4cqw;height:3.4cqw;flex:none}
  .iv-q{flex:1;display:flex;align-items:center;font-size:2.5cqw;font-weight:600;white-space:nowrap;overflow:hidden}
  .iv-digita{display:inline-block;overflow:hidden;animation:iv-digita 7s steps(20) infinite}
  @keyframes iv-digita{0%,6%{max-width:0}40%,88%{max-width:100%}100%{max-width:0}}
  .iv-cursor{width:2px;height:3cqw;margin-left:2px;background:#ff6900;animation:iv-pisca 1s steps(1) infinite}
  @keyframes iv-pisca{50%{opacity:0}}
  .iv-lupa{width:3.2cqw;height:3.2cqw;color:#5f6368;flex:none}

  .iv-metrica{right:0;top:3%;width:30%;padding:1.8cqw 2cqw;animation:iv-entra 1s .15s cubic-bezier(.2,.8,.2,1) both}
  .iv-metrica small{display:block;font-size:1.7cqw;color:#aeb4bd}
  .iv-met-l{display:flex;align-items:baseline;gap:1cqw;margin:.4cqw 0 .8cqw}
  .iv-met-l b{font-family:var(--ff-tit);font-weight:800;font-size:5cqw;line-height:1;color:#3ddc97}
  .iv-met-l em{font-style:normal;font-size:1.6cqw;color:#aeb4bd}
  .iv-spark{display:block;width:100%;height:auto}
  .iv-spark-l{stroke-dasharray:100;animation:iv-desenha 2.4s ease-out both}
  @keyframes iv-desenha{from{stroke-dashoffset:100}to{stroke-dashoffset:0}}

  .iv-perfil{right:0;bottom:0;width:66%;display:grid;grid-template-columns:36% 1fr;gap:2cqw;padding:1.6cqw;animation:iv-entra 1s .3s cubic-bezier(.2,.8,.2,1) both}
  .iv-foto{position:relative;border-radius:1.4cqw;overflow:hidden;min-height:0}
  .iv-foto img{display:block;width:100%;height:100%;object-fit:cover}
  .iv-foto span{position:absolute;left:1cqw;top:1cqw;padding:.4cqw 1.2cqw;border-radius:99px;background:#ff6900;color:#141006;font-size:1.5cqw;font-weight:800}
  .iv-info{display:flex;flex-direction:column;gap:.8cqw;padding:.6cqw 0;min-width:0}
  .iv-info>b{font-size:2.6cqw;line-height:1.15}
  .iv-nota{display:flex;align-items:center;gap:.8cqw;font-size:1.9cqw}
  .iv-nota strong{font-weight:700}
  .iv-est{color:#fbbc04;letter-spacing:.06em}
  .iv-nota em{font-style:normal;color:#aeb4bd}
  .iv-info small{font-size:1.65cqw;color:#aeb4bd}
  .iv-info small i{font-style:normal;color:#3ddc97;font-weight:600}
  .iv-acoes{display:grid;grid-template-columns:repeat(4,1fr);gap:.8cqw;margin-top:.6cqw}
  .iv-acoes span{display:flex;flex-direction:column;align-items:center;gap:.5cqw;padding:1cqw .4cqw;border-radius:1.2cqw;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);font-size:1.4cqw;color:#e4e6ea}
  .iv-acoes svg{width:2.6cqw;height:2.6cqw;color:#8ab4f8}
  .iv-acoes .iv-wa{background:rgba(37,211,102,.14);border-color:rgba(37,211,102,.35)}
  .iv-acoes .iv-wa svg{color:#25d366}
  @keyframes iv-entra{from{opacity:0;transform:translateY(2cqw)}to{opacity:1;transform:none}}

  @media(max-width:767px){
    .iv{padding:52px 0}
    .iv-txt{display:flex;flex-direction:column;align-items:center;text-align:center}
    .iv-tit{align-items:center;font-size:56px}
    .iv-traco{margin-inline:auto}
    .iv-sub{font-size:17px}
  }
  @media (prefers-reduced-motion: reduce){
    .iv-rota,.iv-pin,.iv-onda,.iv-cursor,.iv-busca,.iv-metrica,.iv-perfil,.iv-spark-l,.iv-digita{animation:none}
  }
</style>
