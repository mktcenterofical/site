---
// Faixa laranja escura em largura total, baixa: "Invisível não vende." em duas colunas.
// Esquerda: título e subtítulo. Direita: composição sobre presença local (inspirada em referência do cliente,
// sem copiar): perfil da empresa no Google, avaliações de clientes, cartão do site e um celular 3D com o
// perfil e a distribuição das notas. Nomes, notas e números são fictícios — ver CLAUDE.md.
const barras = [86, 9, 3, 1, 1];
const google = '<path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22z"/><path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1A10 10 0 0 0 2 12c0 1.6.4 3.1 1.1 4.6z"/><path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.7 9.4 5.9 12 5.9z"/>';
const avaliacoes: [string, string, string][] = [
  ['pessoa2', 'Lucas M.', 'Atendimento excelente e entrega no prazo.'],
  ['pessoa1', 'Juliana R.', 'Achei pelo Google e virei cliente fiel.'],
];
---
<section class="iv" id="invisivel" aria-labelledby="iv-tit">
  <div class="wrap iv-in">
    <div class="iv-txt">
      <h2 id="iv-tit" class="iv-tit"><span>Invisível</span><span class="iv-tit2">não vende.</span></h2>
      <i class="iv-traco" aria-hidden="true"></i>
      <p class="iv-sub">Apareça para quem <b>já está procurando</b> o que você vende: no Google, no mapa e no momento da decisão.</p>
    </div>

    <div class="iv-arte" aria-hidden="true">
      <!-- perfil no Google -->
      <div class="iv-card iv-perfil">
        <svg class="iv-g" viewBox="0 0 24 24" set:html={google} />
        <b>Sua Empresa</b>
        <div class="iv-nota"><strong>4,9</strong><span class="iv-est">{[0, 1, 2, 3, 4].map((k) => <i style={`animation-delay:${k * .12}s`}>★</i>)}</span><em>(312)</em></div>
        <small>Empresa local · <i>Aberto agora</i></small>
      </div>

      <!-- avaliações -->
      {avaliacoes.map(([foto, nome, txt], k) => (
        <div class={`iv-card iv-aval a${k + 1}`}>
          <img src={`/mock/${foto}.webp`} alt="" width="96" height="96" loading="lazy" decoding="async" />
          <div><b>{nome}</b><span class="iv-est-p">★★★★★</span><small>{txt}</small></div>
        </div>
      ))}

      <!-- site -->
      <div class="iv-card iv-site">
        <div class="iv-url"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>suaempresa.com.br</div>
        <b>Soluções que geram <span>resultado</span></b>
        <small>Serviços, cases e contato em um clique.</small>
        <em>Saiba mais</em>
      </div>

      <!-- celular 3D -->
      <div class="iv-cel">
        <div class="iv-cel-tela">
          <span class="iv-ilha"></span>
          <div class="iv-cel-top"><b>Sua Empresa</b><small><span>★★★★★</span> 4,9 (312)</small><small class="v">Empresa local · Aberto</small></div>
          <div class="iv-foto"><img src="/mock/padaria.webp" alt="" width="640" height="400" loading="lazy" decoding="async" /></div>
          <div class="iv-btns"><span>Ligar</span><span>Rota</span><span>Site</span></div>
          <div class="iv-abas"><span>Visão geral</span><span class="on">Avaliações</span><span>Fotos</span></div>
          <div class="iv-dist">
            <div class="iv-dist-n"><b>4,9</b><span>★★★★★</span></div>
            <div class="iv-dist-b">{barras.map((v, i) => <div><em>{5 - i}</em><i><u style={`--v:${v}%;animation-delay:${.3 + i * .12}s`}></u></i></div>)}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .iv{position:relative;overflow:hidden;isolation:isolate;padding:40px 0;color:#fff;
    background:radial-gradient(600px 380px at 75% 50%,rgba(255,140,40,.3),transparent 70%),linear-gradient(150deg,#a84300 0%,#8a3500 50%,#5a2200 100%)}
  .iv-in{display:grid;gap:32px;align-items:center}
  @media(min-width:1024px){.iv-in{grid-template-columns:.8fr 1.2fr;gap:40px}}
  .iv-tit{display:flex;flex-direction:column;margin:0;font-size:clamp(52px,6vw,92px);line-height:.86;letter-spacing:-.02em;color:#fff}
  .iv-tit2{background:linear-gradient(180deg,#fff1de,#ffc993);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .iv-traco{display:block;width:64px;height:3px;margin:20px 0 16px;border-radius:3px;background:#fff1de}
  .iv-sub{font-size:19px;line-height:1.45;color:rgba(255,241,222,.86);max-width:32ch}
  .iv-sub b{color:#fff}

  /* ---------- composição ---------- */
  .iv-arte{position:relative;width:100%;max-width:640px;margin:0 auto;aspect-ratio:1000/620;container-type:inline-size;perspective:1400px;text-align:left}
  .iv-card{position:absolute;border-radius:1.8cqw;background:linear-gradient(160deg,rgba(28,29,33,.94),rgba(14,15,17,.94));border:1px solid rgba(255,255,255,.1);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.1),0 2.4cqw 5cqw -1.5cqw rgba(30,8,0,.85);color:#fff;animation:iv-entra .9s cubic-bezier(.2,.8,.2,1) both}
  @keyframes iv-entra{from{opacity:0;transform:translateY(2cqw)}to{opacity:1;transform:none}}
  .iv-est{color:#fbbc04;letter-spacing:.08em}
  .iv-est i{font-style:normal;display:inline-block;animation:iv-estrela .5s ease-out both}
  @keyframes iv-estrela{from{opacity:0;transform:scale(.3)}to{opacity:1;transform:none}}

  .iv-perfil{left:0;top:0;width:40%;display:flex;flex-direction:column;align-items:center;gap:.8cqw;padding:2.2cqw 1.6cqw;text-align:center}
  .iv-g{width:5cqw;height:5cqw}
  .iv-perfil b{font-size:2.5cqw;font-weight:600}
  .iv-nota{display:flex;align-items:center;gap:.8cqw;font-size:2.1cqw}
  .iv-nota em{font-style:normal;color:#aeb4bd}
  .iv-perfil small{font-size:1.6cqw;color:#aeb4bd}
  .iv-perfil small i{font-style:normal;color:#3ddc97}

  .iv-aval{left:0;width:40%;display:flex;align-items:center;gap:1.4cqw;padding:1.3cqw 1.6cqw}
  .iv-aval.a1{top:47%;animation-delay:.15s}
  .iv-aval.a2{top:72%;animation-delay:.3s}
  .iv-aval img{width:5.6cqw;height:5.6cqw;border-radius:50%;object-fit:cover;flex:none;box-shadow:0 0 0 .3cqw rgba(255,138,36,.5)}
  .iv-aval div{display:flex;flex-direction:column;gap:.2cqw;min-width:0}
  .iv-aval b{font-size:1.7cqw}
  .iv-est-p{color:#fbbc04;font-size:1.5cqw;letter-spacing:.08em}
  .iv-aval small{font-size:1.4cqw;color:#c3c8cf;line-height:1.3}

  .iv-site{left:43%;top:44%;width:29%;display:flex;flex-direction:column;gap:1cqw;padding:1.6cqw;animation-delay:.2s}
  .iv-url{display:flex;align-items:center;gap:.6cqw;padding:.5cqw 1cqw;border-radius:99px;background:#1d1f24;color:#8a9099;font-size:1.25cqw}
  .iv-url svg{width:1.5cqw;height:1.5cqw}
  .iv-site b{font-size:2.3cqw;line-height:1.15}
  .iv-site b span{color:#ff8a24}
  .iv-site small{font-size:1.35cqw;color:#aeb4bd}
  .iv-site em{align-self:flex-start;font-style:normal;padding:.6cqw 1.4cqw;border-radius:99px;background:#ff6900;color:#141006;font-weight:800;font-size:1.3cqw}

  /* celular realista inclinado */
  .iv-cel{position:absolute;right:1%;top:-2%;width:27%;aspect-ratio:9/18.6;padding:.7cqw;border-radius:4.4cqw;
    background:linear-gradient(135deg,#d7d9dc,#7b7f86 30%,#c9ccd0 55%,#5d6168);
    box-shadow:0 0 0 .25cqw #2b2d31 inset,2cqw 3cqw 5cqw -1cqw rgba(20,6,0,.85),0 0 5cqw -1cqw rgba(255,138,36,.6);
    transform:rotateY(-20deg) rotateZ(5deg);animation:iv-cel 6s ease-in-out infinite}
  @keyframes iv-cel{50%{transform:rotateY(-20deg) rotateZ(5deg) translateY(-1.2cqw)}}
  .iv-cel-tela{position:relative;height:100%;border-radius:3.8cqw;border:.7cqw solid #050506;overflow:hidden;background:#141518;display:flex;flex-direction:column;gap:.7cqw;padding:3.2cqw 1.2cqw 1.2cqw;font-size:1.1cqw}
  .iv-cel-tela::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(118deg,rgba(255,255,255,.14),rgba(255,255,255,0) 40%)}
  .iv-ilha{position:absolute;left:50%;top:.8cqw;width:36%;height:1.9cqw;transform:translateX(-50%);border-radius:99px;background:#050506}
  .iv-cel-top b{display:block;font-size:1.6cqw}
  .iv-cel-top small{display:block;color:#aeb4bd}
  .iv-cel-top small span{color:#fbbc04}
  .iv-cel-top small.v{color:#3ddc97}
  .iv-foto{height:17%;flex:none;border-radius:1cqw;overflow:hidden}
  .iv-foto img{display:block;width:100%;height:100%;object-fit:cover}
  .iv-btns{display:grid;grid-template-columns:repeat(3,1fr);gap:.6cqw}
  .iv-btns span{text-align:center;padding:.35cqw 0;border-radius:99px;border:1px solid #2f3238;color:#8ab4f8;font-size:1.15cqw}
  .iv-abas{display:flex;justify-content:space-between;border-bottom:1px solid #2a2d33;font-size:1.1cqw;color:#8a9099}
  .iv-abas span{padding-bottom:.5cqw}
  .iv-abas .on{color:#8ab4f8;box-shadow:inset 0 -2px #8ab4f8}
  .iv-dist{display:grid;grid-template-columns:auto 1fr;gap:1cqw;align-items:center}
  .iv-dist-n b{display:block;font-size:2.8cqw;line-height:1}
  .iv-dist-n span{color:#fbbc04;font-size:1cqw}
  .iv-dist-b{display:grid;gap:.35cqw}
  .iv-dist-b div{display:flex;align-items:center;gap:.6cqw}
  .iv-dist-b em{font-style:normal;font-size:1cqw;color:#8a9099;width:.8cqw}
  .iv-dist-b i{flex:1;height:.6cqw;border-radius:9px;background:#2a2d33;overflow:hidden}
  .iv-dist-b u{display:block;height:100%;width:var(--v);border-radius:inherit;background:#fbbc04;animation:iv-barra 1.2s cubic-bezier(.2,.8,.2,1) both}
  @keyframes iv-barra{from{width:0}}

  @media(max-width:767px){
    /* celular: composição reorganizada em coluna (cartões à esquerda, celular à direita), sem sobreposição */
    .iv-arte{aspect-ratio:1/1.12;max-width:460px}
    .iv-perfil{width:58%;top:0}
    .iv-aval{width:58%}
    .iv-aval.a1{top:31%}
    .iv-aval.a2{top:50%}
    .iv-site{left:0;top:70%;width:58%}
    .iv-cel{width:38%;top:6%;right:0}
    .iv-txt{display:flex;flex-direction:column;align-items:center;text-align:center}
    .iv-tit{align-items:center;font-size:52px}
    .iv-traco{margin-inline:auto}
    .iv-sub{font-size:17px}
  }
  @media (prefers-reduced-motion: reduce){.iv-card,.iv-est i,.iv-cel,.iv-dist-b u{animation:none}}
</style>
