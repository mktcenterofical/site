---
// Seção 2 da home (abaixo do carrossel de logos): "Conectamos seu negócio ao site e às redes".
// Esquerda: texto no estilo do hero. Direita: ilustração em código — o negócio (à esquerda) alimenta
// o site/loja (centro), que se conecta às redes sociais (cartões de vidro à direita) por linhas de luz animadas.
import { waLink } from '../config';
import Icon from './Icon.astro';

const negocio: [string, string][] = [
  ['store', 'Produtos e serviços'],
  ['folder', 'Projetos e cases'],
  ['smile', 'Equipe e história'],
  ['trending', 'Resultados'],
];
// y central (no viewBox 1000 x 860) de cada item da esquerda e de cada rede
const yNeg = [250, 370, 490, 610];
const redes = [
  { id: 'ig', nome: 'Instagram', txt: 'Post publicado', y: 150 },
  { id: 'fb', nome: 'Facebook', txt: 'Anúncio no ar', y: 330 },
  { id: 'wa', nome: 'WhatsApp', txt: 'Novo pedido', y: 510 },
  { id: 'gg', nome: 'Google', txt: '1º na busca', y: 690 },
];
const DX0 = 285, DX1 = 645, DY = 430; // bordas do site/loja no centro
const pathsNeg = yNeg.map((y, i) => `M215 ${y} C 255 ${y}, 245 ${DY - 90 + i * 60}, ${DX0} ${DY - 90 + i * 60}`);
const pathsRede = redes.map((r) => `M${DX1} ${DY} C 700 ${DY}, 690 ${r.y}, 745 ${r.y}`);
const pct = (v: number, t: number) => `${(v / t) * 100}%`;
---
<section class="cx" id="conexao">
  <div class="wrap cx-in">
    <div class="cx-texto">
      <h2 class="cx-h">
        <span>Seu negócio,</span>
        <span>site e redes</span>
        <span class="cx-or">conectados</span>
      </h2>
      <p class="cx-lead">Levamos o que a sua empresa tem de melhor para um site ou loja virtual feito para vender. Depois conectamos tudo ao Instagram, Facebook, WhatsApp e Google, para cada post, anúncio e busca trazer o cliente de volta para você.</p>
      <div class="acoes">
        <a class="btn btn-primary" href={waLink('Olá! Quero conectar meu negócio ao site e às redes sociais.')} target="_blank" rel="noopener">Quero tudo conectado</a>
        <a class="btn cx-ghost" href="/trafego-e-seo/">Ver como funciona</a>
      </div>
    </div>

    <div class="cx-arte" aria-hidden="true">
      <div class="cx-luz"></div>

      <svg class="cx-fios" viewBox="0 0 1000 860" preserveAspectRatio="none">
        <defs>
          <linearGradient id="cx-g" x1="0" x2="1">
            <stop offset="0" stop-color="#ff6900" stop-opacity=".2" />
            <stop offset=".5" stop-color="#ffb35c" />
            <stop offset="1" stop-color="#ff6900" stop-opacity=".6" />
          </linearGradient>
          <filter id="cx-brilho"><feGaussianBlur stdDeviation="4" /></filter>
        </defs>
        {[...pathsNeg, ...pathsRede].map((d) => (
          <g>
            <path d={d} fill="none" stroke="#ff6900" stroke-opacity=".35" stroke-width="7" filter="url(#cx-brilho)" />
            <path d={d} fill="none" stroke="url(#cx-g)" stroke-width="2.4" />
            <path class="cx-pulso" d={d} fill="none" stroke="#fff4e6" stroke-width="3" stroke-linecap="round" pathLength="100" />
          </g>
        ))}
        {redes.map((r) => <polygon points={`745,${r.y - 7} 757,${r.y} 745,${r.y + 7}`} fill="#ffb35c" />)}
      </svg>

      <!-- o negócio -->
      <div class="cx-neg">
        <small>Seu negócio</small>
        {negocio.map(([i, t], k) => (
          <div class="cx-chip" style={`top:${pct(yNeg[k] - 45, 860)}`}><span><Icon name={i} size={16} /></span>{t}</div>
        ))}
      </div>

      <!-- site / loja -->
      <div class="cx-dev" style={`left:${pct(DX0, 1000)};width:${pct(DX1 - DX0, 1000)}`}>
        <div class="cx-bar"><i></i><i></i><i></i><span>seusite.com.br</span></div>
        <div class="cx-hero">
          <img src="/mock/padaria.webp" alt="" width="640" height="400" loading="lazy" decoding="async" />
          <div><b>Seu site</b><em>ou loja virtual</em><span>Comprar</span></div>
        </div>
        <div class="cx-prods">
          {['pao', 'croissant', 'bolo'].map((p) => <div><img src={`/mock/${p}.webp`} alt="" width="320" height="220" loading="lazy" decoding="async" /><i></i></div>)}
        </div>
        <div class="cx-kpi"><span><Icon name="trending" size={14} />Vendas hoje</span><b>+38%</b></div>
      </div>

      <!-- redes sociais (cartões de vidro) -->
      {redes.map((r) => (
        <div class="cx-rede" style={`top:${pct(r.y - 70, 860)}`}>
          <div class="cx-rede-top">
            <span class={`cx-ic cx-${r.id}`}>
              {r.id === 'ig' && <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="#fff" /></svg>}
              {r.id === 'fb' && <svg viewBox="0 0 24 24" fill="#fff"><path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v7h4v-7h3l.5-4h-3.5V8.8c0-.5.3-.8.5-.8z" /></svg>}
              {r.id === 'wa' && <svg viewBox="0 0 32 32" fill="#fff"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm5.9 15.7c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.7-.4z" /></svg>}
              {r.id === 'gg' && <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3z" /><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22z" /><path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1A10 10 0 0 0 2 12c0 1.6.4 3.1 1.1 4.6z" /><path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.7 9.4 5.9 12 5.9z" /></svg>}
            </span>
            <b>{r.nome}</b>
          </div>
          <i class="cx-l l1"></i><i class="cx-l l2"></i>
          <div class="cx-st"><span>✓</span>{r.txt}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cx-in{display:grid;gap:48px;align-items:center}
  @media(min-width:1024px){.cx-in{grid-template-columns:1fr 1.15fr;gap:56px}}

  /* texto no estilo do hero */
  .cx-h{display:flex;flex-direction:column;font-size:clamp(42px,4.6vw,66px);line-height:.9;letter-spacing:-.02em;margin:0;color:#fff}
  .cx-h span{display:block}
  .cx-or{background:linear-gradient(180deg,#ff8a24,#ff6900);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .cx-lead{color:#aeb4bd;font-size:18px;line-height:28px;max-width:52ch;margin-top:24px}
  .cx-ghost{border-color:#5b616b;color:#fff;background:transparent}
  .cx-ghost:hover{border-color:#fff}

  /* ---------- ilustração ---------- */
  .cx-arte{position:relative;width:min(100%,620px);aspect-ratio:1000/860;margin:0 auto;container-type:inline-size;text-align:left}
  .cx-luz{position:absolute;left:20%;right:20%;top:20%;bottom:10%;border-radius:50%;background:radial-gradient(closest-side,rgba(255,105,0,.28),transparent);filter:blur(10px)}
  .cx-fios{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
  .cx-pulso{stroke-dasharray:6 94;animation:cx-flui 2.6s linear infinite}
  .cx-fios g:nth-child(2n) .cx-pulso{animation-delay:-1.3s}
  .cx-fios g:nth-child(3n) .cx-pulso{animation-delay:-.7s}
  @keyframes cx-flui{from{stroke-dashoffset:100}to{stroke-dashoffset:0}}

  .cx-neg small{position:absolute;left:0;top:18%;font-size:1.5cqw;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#ff8a24}
  .cx-chip{position:absolute;left:0;width:21.5%;height:10.5%;display:flex;align-items:center;gap:1cqw;padding:0 1.2cqw;border-radius:1.4cqw;background:linear-gradient(160deg,#1d1f24,#121316);border:1px solid #2a2d33;color:#e4e6ea;font-size:1.45cqw;font-weight:600;line-height:1.15;box-shadow:0 1.5cqw 3cqw -1.5cqw rgba(0,0,0,.9)}
  .cx-chip span{flex:none;display:grid;place-items:center;width:3.6cqw;height:3.6cqw;border-radius:1cqw;background:rgba(255,105,0,.15);color:#ff8a24}
  .cx-chip :global(svg){width:2cqw;height:2cqw}

  .cx-dev{position:absolute;top:22%;height:56%;display:flex;flex-direction:column;gap:1.2cqw;padding:1.2cqw;border-radius:2cqw;background:linear-gradient(160deg,#2b2e34,#121316 45%,#0b0c0e);border:1px solid rgba(255,138,36,.45);box-shadow:0 0 5cqw -1cqw rgba(255,105,0,.55),0 4cqw 6cqw -2cqw rgba(0,0,0,.9)}
  .cx-bar{display:flex;align-items:center;gap:.6cqw}
  .cx-bar i{width:1.2cqw;height:1.2cqw;border-radius:50%;background:#ff5f57}
  .cx-bar i:nth-child(2){background:#febc2e}.cx-bar i:nth-child(3){background:#28c840}
  .cx-bar span{margin-left:1cqw;flex:1;padding:.3cqw 1.2cqw;border-radius:99px;background:#1d1f24;color:#8a9099;font-size:1.2cqw}
  .cx-hero{position:relative;flex:1;min-height:0;border-radius:1.2cqw;overflow:hidden}
  .cx-arte img{display:block;width:100%;height:100%;object-fit:cover}
  .cx-hero div{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;gap:.4cqw;padding:0 2cqw;background:linear-gradient(90deg,rgba(9,10,12,.92),rgba(9,10,12,.2) 75%)}
  .cx-hero b{font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:3.4cqw;line-height:.9;color:#fff}
  .cx-hero em{font-style:normal;font-size:1.6cqw;color:#ff8a24;font-weight:700}
  .cx-hero span{align-self:flex-start;margin-top:.8cqw;padding:.5cqw 1.4cqw;border-radius:99px;background:#ff6900;color:#141006;font-weight:800;font-size:1.3cqw}
  .cx-prods{display:grid;grid-template-columns:repeat(3,1fr);gap:1cqw;height:28%}
  .cx-prods div{display:grid;grid-template-rows:1fr auto;gap:.5cqw;padding:.6cqw;border-radius:1cqw;background:#1a1c20;border:1px solid #26292f;min-height:0}
  .cx-prods img{border-radius:.7cqw;min-height:0}
  .cx-prods i{height:.8cqw;width:70%;border-radius:9px;background:#33363d}
  .cx-kpi{display:flex;justify-content:space-between;align-items:center;padding:.8cqw 1.2cqw;border-radius:1cqw;background:rgba(61,220,151,.08);border:1px solid rgba(61,220,151,.25);font-size:1.3cqw;color:#c3c8cf}
  .cx-kpi span{display:flex;align-items:center;gap:.6cqw}
  .cx-kpi :global(svg){width:1.6cqw;height:1.6cqw;color:#3ddc97}
  .cx-kpi b{color:#3ddc97;font-size:1.8cqw}

  .cx-rede{position:absolute;right:0;width:25.5%;height:16.3%;display:flex;flex-direction:column;gap:.8cqw;padding:1.2cqw;border-radius:1.6cqw;background:linear-gradient(150deg,rgba(255,255,255,.11),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.14);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:inset 0 1px 0 rgba(255,255,255,.18),0 2cqw 4cqw -1.5cqw rgba(0,0,0,.9);color:#fff;animation:cx-flutua 4.5s ease-in-out infinite}
  .cx-rede:nth-of-type(2n){animation-delay:-2.2s}
  @keyframes cx-flutua{50%{transform:translateY(-.8cqw)}}
  .cx-rede-top{display:flex;align-items:center;gap:1cqw}
  .cx-rede-top b{font-size:1.6cqw}
  .cx-ic{display:grid;place-items:center;width:3.6cqw;height:3.6cqw;border-radius:1cqw;flex:none}
  .cx-ic svg{width:2.2cqw;height:2.2cqw}
  .cx-ig{background:radial-gradient(circle at 30% 110%,#fdc468,#fa7e1e 25%,#d62976 55%,#962fbf 80%,#4f5bd5)}
  .cx-fb{background:#1877f2}
  .cx-wa{background:#25d366}
  .cx-gg{background:#fff}
  .cx-l{display:block;flex:none;height:.8cqw;border-radius:9px;background:rgba(255,255,255,.18)}
  .cx-l.l1{width:90%}.cx-l.l2{width:62%;background:rgba(255,138,36,.55)}
  .cx-st{margin-top:auto;display:flex;align-items:center;gap:.7cqw;font-size:1.25cqw;color:#c3c8cf}
  .cx-st span{flex:none;display:grid;place-items:center;width:2cqw;height:2cqw;border-radius:50%;background:#0b7544;color:#fff;font-size:1.1cqw;font-weight:800}

  @media(max-width:767px){
    .cx-h{font-size:40px;align-items:center}
    .cx-lead{font-size:16px;line-height:26px;margin-inline:auto}
    .cx-arte{width:100%}
  }
  @media (prefers-reduced-motion: reduce){.cx-pulso,.cx-rede{animation:none}.cx-pulso{display:none}}
</style>
