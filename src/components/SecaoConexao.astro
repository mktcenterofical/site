---
// Seção 2 da home (abaixo do carrossel de logos): "Conectamos seu negócio ao site e às redes".
// Esquerda: texto no estilo do hero. Direita: ilustração em código — caixa 3D com o site em cima e o acervo
// do negócio embaixo, ligada por linhas de luz animadas a cartões de vidro 3D das redes sociais.
import { waLink } from '../config';
import Icon from './Icon.astro';

const negocio: [string, string][] = [
  ['store', 'Produtos e serviços'],
  ['folder', 'Projetos e cases'],
  ['trending', 'Dados e resultados'],
  ['smile', 'Equipe e história'],
];
// redes (cartões de vidro) e as curvas de luz que saem do site até cada uma (viewBox 1000 x 860)
const redes = [
  { id: 'ig', nome: 'Instagram', txt: 'Post publicado', y: 175 },
  { id: 'wa', nome: 'WhatsApp', txt: 'Novo pedido', y: 430 },
  { id: 'gg', nome: 'Google', txt: '1º na busca', y: 685 },
];
const saidas = [250, 330, 410, 490, 570];
const fios = redes.flatMap((r, i) => [saidas[i], saidas[i + 2]].map((y0, k) => `M560 ${y0} C 620 ${y0}, ${610 + k * 20} ${r.y + (k ? 18 : -18)}, 690 ${r.y + (k ? 18 : -18)}`));
const pct = (v: number, t: number) => `${(v / t) * 100}%`;
---
<section class="cx" id="conexao">
  <div class="wrap cx-in">
    <div class="cx-texto">
      <h2 class="cx-h">
        <span>Seu negócio,</span>
        <span>site e redes</span>
        <span class="cx-or">conectados</span>
      </h2>
      <p class="cx-lead">Levamos o que a sua empresa tem de melhor para um site ou loja virtual feito para vender. Depois conectamos tudo às <a href="/trafego-e-seo/">redes sociais e ao Google</a>, para cada post, anúncio e busca trazer o cliente de volta para você.</p>
      <div class="acoes">
        <a class="btn btn-primary" href={waLink('Olá! Quero conectar meu negócio ao site e às redes sociais.')} target="_blank" rel="noopener">Quero tudo conectado</a>
        <a class="btn cx-ghost" href="/trafego-e-seo/">Ver como funciona</a>
      </div>
    </div>

    <div class="cx-arte" aria-hidden="true">
      <div class="cx-chao"></div>

      <svg class="cx-fios" viewBox="0 0 1000 860" preserveAspectRatio="none">
        <defs>
          <linearGradient id="cx-g" x1="0" x2="1">
            <stop offset="0" stop-color="#ff6900" stop-opacity=".25" />
            <stop offset=".55" stop-color="#ffb35c" />
            <stop offset="1" stop-color="#ff8a24" />
          </linearGradient>
          <filter id="cx-brilho" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="5" /></filter>
        </defs>
        {fios.map((d) => (
          <g>
            <path d={d} fill="none" stroke="#ff6900" stroke-opacity=".55" stroke-width="9" filter="url(#cx-brilho)" />
            <path d={d} fill="none" stroke="url(#cx-g)" stroke-width="2.6" />
            <path class="cx-pulso" d={d} fill="none" stroke="#fff4e6" stroke-width="3.4" stroke-linecap="round" pathLength="100" />
          </g>
        ))}
        {redes.map((r) => [-18, 18].map((o) => <polygon points={`688,${r.y + o - 8} 702,${r.y + o} 688,${r.y + o + 8}`} fill="#ffc68a" />))}
      </svg>

      <!-- caixa 3D: em cima o site, embaixo o "acervo" do negócio -->
      <div class="cx-caixa">
        <div class="cx-modulo cx-mod-site">
          <div class="cx-bar"><i></i><i></i><i></i><span></span></div>
          <div class="cx-site">
            <div class="cx-site-img"><img src="/mock/padaria.webp" alt="" width="640" height="400" loading="lazy" decoding="async" /></div>
            <div class="cx-site-txt">
              <b>Site da empresa</b>
              <em>ou loja virtual, pronto para vender</em>
              <i></i><i class="c"></i>
            </div>
          </div>
        </div>
        <div class="cx-modulo cx-mod-base">
          <ul class="cx-lista">
            {negocio.map(([i, t]) => <li><span><Icon name={i} size={14} /></span>{t}</li>)}
          </ul>
          <div class="cx-docs">
            <div class="cx-folha f3"></div><div class="cx-folha f2"></div>
            <div class="cx-folha f1"><i class="t"></i><i></i><i></i><i class="c"></i><span class="cx-graf"></span></div>
          </div>
          <div class="cx-fotos">
            <div><img src="/mock/pao.webp" alt="" width="320" height="220" loading="lazy" decoding="async" /></div>
            <div><img src="/mock/croissant.webp" alt="" width="320" height="220" loading="lazy" decoding="async" /></div>
            <div class="cx-barras"><i style="height:35%"></i><i style="height:55%"></i><i style="height:45%"></i><i style="height:75%"></i><i style="height:100%"></i></div>
          </div>
          <div class="cx-rodape"><span class="cx-av"><img src="/mock/pessoa1.webp" alt="" width="96" height="96" loading="lazy" decoding="async" /></span><i></i><i></i></div>
        </div>
        <div class="cx-plataforma"></div>
      </div>

      <!-- redes sociais: cartões de vidro 3D -->
      {redes.map((r) => (
        <div class="cx-vidro" style={`top:${pct(r.y - 105, 860)}`}>
          <div class="cx-vidro-top">
            <span class={`cx-ic cx-${r.id}`}>
              {r.id === 'ig' && <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="#fff" /></svg>}
              {r.id === 'wa' && <svg viewBox="0 0 32 32" fill="#fff"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm5.9 15.7c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.7-.4z" /></svg>}
              {r.id === 'gg' && <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3z" /><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22z" /><path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1A10 10 0 0 0 2 12c0 1.6.4 3.1 1.1 4.6z" /><path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10C7.2 7.7 9.4 5.9 12 5.9z" /></svg>}
            </span>
            <b>{r.nome}<small>conectado ao seu site</small></b>
          </div>
          <i class="cx-l"></i><i class="cx-l l2"></i><i class="cx-l l3"></i>
          <div class="cx-st"><span>✓</span>{r.txt}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cx-in{display:grid;gap:48px;align-items:center}
  @media(min-width:1024px){.cx-in{grid-template-columns:1fr 1.15fr;gap:56px}}

  /* texto no estilo do hero */
  .cx-h{display:flex;flex-direction:column;font-size:clamp(42px,4.6vw,66px);line-height:.9;letter-spacing:-.02em;margin:0;color:#fff}
  .cx-h span{display:block}
  .cx-or{background:linear-gradient(180deg,#ff8a24,#ff6900);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .cx-lead a{color:#fff;text-decoration:underline;text-decoration-color:#ff6900;text-underline-offset:3px}
  .cx-lead{color:#aeb4bd;font-size:18px;line-height:28px;max-width:52ch;margin-top:24px}
  .cx-ghost{border-color:#5b616b;color:#fff;background:transparent}
  .cx-ghost:hover{border-color:#fff}

  /* ---------- ilustração: caixa 3D + cartões de vidro ---------- */
  .cx-arte{position:relative;width:min(100%,640px);aspect-ratio:1000/860;margin:0 auto;container-type:inline-size;text-align:left;perspective:1400px}
  .cx-chao{position:absolute;inset:-6% -10% -4% 10%;background:linear-gradient(135deg,transparent 45%,rgba(255,105,0,.22) 70%,rgba(255,105,0,.05));clip-path:polygon(40% 100%,100% 30%,100% 100%);filter:blur(14px);opacity:.8;mask-image:linear-gradient(90deg,transparent,#000 40%,#000 75%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 40%,#000 75%,transparent)}
  .cx-fios{position:absolute;inset:0;width:100%;height:100%;overflow:visible;z-index:1}
  .cx-pulso{stroke-dasharray:7 93;animation:cx-flui 2.4s linear infinite}
  .cx-fios g:nth-child(2n) .cx-pulso{animation-delay:-1.2s}
  .cx-fios g:nth-child(3n) .cx-pulso{animation-delay:-.6s}
  @keyframes cx-flui{from{stroke-dashoffset:100}to{stroke-dashoffset:0}}
  .cx-arte img{display:block;width:100%;height:100%;object-fit:cover}

  /* caixa 3D */
  .cx-caixa{position:absolute;left:2%;top:7%;width:54%;height:84%;z-index:2;transform:rotateY(14deg) rotateX(3deg);transform-style:preserve-3d;transform-origin:left center;display:flex;flex-direction:column;gap:1.4cqw}
  .cx-modulo{position:relative;border-radius:1.8cqw;padding:1.4cqw;background:linear-gradient(160deg,#2b2d33,#141519 40%,#0b0c0e);border:1px solid rgba(255,255,255,.08);box-shadow:inset 0 1px 0 rgba(255,255,255,.14),inset 0 0 0 .5cqw #0d0e11,0 0 0 1px rgba(255,138,36,.35),0 0 3cqw -1cqw rgba(255,105,0,.6)}
  /* espessura da caixa (lateral e topo) */
  .cx-modulo::before{content:'';position:absolute;top:1.2cqw;bottom:-1.2cqw;right:-2.4cqw;width:2.4cqw;border-radius:0 1.4cqw 1.4cqw 0;background:linear-gradient(90deg,#1a1b1f,#050506);transform:skewY(-30deg);transform-origin:left top;box-shadow:inset -1px 0 0 rgba(255,138,36,.4)}
  .cx-modulo::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:2px;border-radius:2px;background:linear-gradient(90deg,transparent,#ff8a24 20%,#ffb35c 50%,#ff8a24 80%,transparent);box-shadow:0 0 1.6cqw #ff6900}
  .cx-mod-site{height:40%;display:flex;flex-direction:column;gap:1cqw}
  .cx-bar{display:flex;align-items:center;gap:.7cqw}
  .cx-bar i{width:1.3cqw;height:1.3cqw;border-radius:50%;background:#ff6900}
  .cx-bar i:nth-child(2){background:#ff8a24}.cx-bar i:nth-child(3){background:#3a3d44}
  .cx-bar span{margin-left:1.2cqw;flex:1;height:2cqw;border-radius:99px;background:linear-gradient(90deg,#2a2d33,#1a1c20)}
  .cx-site{flex:1;min-height:0;display:grid;grid-template-columns:1fr 1fr;border-radius:1.2cqw;overflow:hidden;background:#0d0e11;border:1px solid #23262c}
  .cx-site-img{min-height:0;filter:saturate(1.15) contrast(1.05)}
  .cx-site-txt{display:flex;flex-direction:column;justify-content:center;gap:.8cqw;padding:0 1.8cqw}
  .cx-site-txt b{font-size:2.4cqw;font-weight:700;color:#fff;line-height:1.1}
  .cx-site-txt em{font-style:normal;font-size:1.6cqw;color:#ff8a24;line-height:1.25}
  .cx-site-txt i{display:block;height:.8cqw;width:85%;border-radius:9px;background:#33363d}
  .cx-site-txt i.c{width:55%}

  .cx-mod-base{flex:1;min-height:0;display:grid;grid-template-columns:30% 1fr 30%;grid-template-rows:1fr auto;gap:1.2cqw}
  .cx-lista{list-style:none;margin:0;display:flex;flex-direction:column;justify-content:space-between;padding:1cqw;border-radius:1.2cqw;background:#101114;border:1px solid #23262c}
  .cx-lista li{display:flex;align-items:center;gap:.8cqw;font-size:1.3cqw;line-height:1.15;color:#c3c8cf}
  .cx-lista span{flex:none;display:grid;place-items:center;width:2.8cqw;height:2.8cqw;border-radius:.8cqw;background:rgba(255,105,0,.14);color:#ff8a24}
  .cx-lista :global(svg){width:1.6cqw;height:1.6cqw}
  .cx-docs{position:relative}
  .cx-folha{position:absolute;inset:6% 10% 4% 12%;border-radius:.8cqw;background:linear-gradient(160deg,#fff7ec,#f0dcc2);box-shadow:0 1.4cqw 2.4cqw rgba(0,0,0,.6)}
  .cx-folha.f3{transform:translate(-1.6cqw,-1.2cqw) rotate(-6deg);opacity:.7}
  .cx-folha.f2{transform:translate(-.8cqw,-.6cqw) rotate(-3deg);opacity:.85}
  .cx-folha.f1{display:flex;flex-direction:column;gap:.8cqw;padding:1.6cqw}
  .cx-folha i{display:block;height:.7cqw;border-radius:9px;background:#d2b48f}
  .cx-folha i.t{height:1.1cqw;width:70%;background:#b8875a}
  .cx-folha i.c{width:60%}
  .cx-graf{margin-top:auto;align-self:center;width:6cqw;height:6cqw;border-radius:50%;background:conic-gradient(#ff6900 0 38%,#d2b48f 38% 100%)}
  .cx-fotos{display:grid;grid-template-rows:1fr 1fr 1fr;gap:.8cqw;min-height:0}
  .cx-fotos div{border-radius:.8cqw;overflow:hidden;min-height:0;border:1px solid #23262c}
  .cx-barras{display:flex;align-items:flex-end;gap:.5cqw;padding:.6cqw;background:#101114}
  .cx-barras i{flex:1;border-radius:.3cqw .3cqw 0 0;background:linear-gradient(180deg,#ffb35c,#ff6900);box-shadow:0 0 1cqw rgba(255,105,0,.6)}
  .cx-rodape{grid-column:1 / -1;display:flex;align-items:center;gap:1.4cqw;padding:.8cqw 1.2cqw;border-radius:1.2cqw;background:#101114;border:1px solid #23262c}
  .cx-av{width:3.6cqw;height:3.6cqw;border-radius:50%;overflow:hidden;flex:none}
  .cx-rodape i{flex:1;height:2.6cqw;border-radius:.6cqw;border:1px solid #2a2d33;background:linear-gradient(90deg,#16171b,#1d1f24)}
  .cx-plataforma{position:absolute;left:-3%;right:-6%;bottom:-6%;height:5%;border-radius:1cqw;background:linear-gradient(180deg,#2b2d33,#0b0c0e);box-shadow:0 0 0 1px rgba(255,138,36,.3),0 1cqw 3cqw rgba(255,105,0,.45),0 3cqw 5cqw rgba(0,0,0,.9);transform:translateZ(-20px)}

  /* cartões de vidro 3D */
  .cx-vidro{position:absolute;right:0;width:30%;height:24.4%;z-index:3;display:flex;flex-direction:column;gap:.9cqw;padding:1.5cqw;border-radius:1.8cqw;color:#fff;
    background:linear-gradient(150deg,rgba(255,255,255,.16),rgba(255,255,255,.04) 45%,rgba(255,138,36,.08));
    border:1px solid rgba(255,255,255,.22);backdrop-filter:blur(12px) saturate(140%);-webkit-backdrop-filter:blur(12px) saturate(140%);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.35),inset 0 -1px 0 rgba(255,138,36,.5),.8cqw .8cqw 0 -.2cqw rgba(10,11,13,.9),.8cqw .8cqw 0 0 rgba(255,138,36,.45),0 0 4cqw -1cqw rgba(255,105,0,.55),0 3cqw 5cqw -2cqw rgba(0,0,0,.95);
    transform:rotateY(-16deg);transform-origin:left center;animation:cx-flutua 5s ease-in-out infinite}
  .cx-vidro::before{content:'';position:absolute;inset:0;border-radius:inherit;background:linear-gradient(115deg,rgba(255,255,255,.22),rgba(255,255,255,0) 35%);pointer-events:none}
  .cx-vidro:nth-of-type(2n){animation-delay:-2.5s}
  @keyframes cx-flutua{50%{transform:rotateY(-16deg) translateY(-1cqw)}}
  .cx-vidro-top{display:flex;align-items:center;gap:1.1cqw}
  .cx-vidro-top b{display:flex;flex-direction:column;font-size:1.8cqw;line-height:1.15}
  .cx-vidro-top small{font-size:1.15cqw;font-weight:500;color:#c3c8cf}
  .cx-ic{display:grid;place-items:center;width:4.2cqw;height:4.2cqw;border-radius:1.1cqw;flex:none;box-shadow:0 0 2cqw rgba(255,105,0,.35)}
  .cx-ic svg{width:2.5cqw;height:2.5cqw}
  .cx-ig{background:radial-gradient(circle at 30% 110%,#fdc468,#fa7e1e 25%,#d62976 55%,#962fbf 80%,#4f5bd5)}
  .cx-wa{background:#25d366}
  .cx-gg{background:#fff}
  .cx-l{display:block;flex:none;height:.8cqw;width:88%;border-radius:9px;background:rgba(255,255,255,.22)}
  .cx-l.l2{width:70%;height:1cqw;background:linear-gradient(90deg,#ff6900,#ffb35c);box-shadow:0 0 1.2cqw rgba(255,105,0,.7)}
  .cx-l.l3{width:50%}
  .cx-st{margin-top:auto;display:flex;align-items:center;gap:.8cqw;padding:.7cqw .9cqw;border-radius:1cqw;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.12);font-size:1.3cqw;color:#e4e6ea}
  .cx-st span{flex:none;display:grid;place-items:center;width:2.2cqw;height:2.2cqw;border-radius:.6cqw;border:1px solid rgba(255,255,255,.4);font-size:1.2cqw;font-weight:800;line-height:1}

  @media(max-width:767px){
    .cx-h{font-size:40px;align-items:center}
    .cx-lead{font-size:16px;line-height:26px;margin-inline:auto}
    .cx-arte{width:100%}
  }
  @media (prefers-reduced-motion: reduce){.cx-pulso,.cx-vidro{animation:none}.cx-pulso{display:none}}
</style>
