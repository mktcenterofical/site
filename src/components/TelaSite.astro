---
// Tela fictícia de um site institucional (Padaria Pão Dourado) usada no notebook do hero.
const cards: [string, string, string][] = [
  ['pao', 'Pães artesanais', 'Fermentação natural'],
  ['croissant', 'Confeitaria', 'Feita todo dia'],
  ['cafe', 'Café da manhã', 'Das 6h às 11h'],
];
---
<div class="ste">
  <div class="ste-bar"><i></i><i></i><i></i><span>padariapaodourado.com.br</span></div>
  <div class="ste-nav">
    <span class="ste-logo">Pão Dourado</span>
    <span>Início</span><span>Sobre</span><span>Cardápio</span><span>Contato</span>
    <span class="ste-bt">Fale conosco</span>
  </div>
  <div class="ste-hero">
    <div class="ste-hero-t">
      <small>Padaria artesanal desde 1998</small>
      <b>Pão quentinho<br />todo dia</b>
      <p>Três fornadas por dia e encomendas pelo WhatsApp.</p>
      <div><span class="ste-bt">Ver cardápio</span><span class="ste-bt2">Como chegar</span></div>
    </div>
    <div class="ste-img"><img src="/mock/padaria.webp" alt="" width="640" height="400" loading="lazy" decoding="async" /></div>
  </div>
  <div class="ste-cards">
    {cards.map(([img, t, d]) => (
      <div><img src={`/mock/${img}.webp`} alt="" width="320" height="220" loading="lazy" decoding="async" /><b>{t}</b><small>{d}</small></div>
    ))}
  </div>
  <div class="lj-toast"><span>✓</span>Mensagem enviada pelo site</div>
</div>

<style>
  .ste{position:absolute;inset:0;display:flex;flex-direction:column;background:#fbf8f3;color:#1d1a16;font-size:1.75cqw;line-height:1.2;text-align:left;font-family:var(--ff-txt);overflow:hidden}
  .ste img{display:block;width:100%;height:100%;object-fit:cover}
  .ste-bar{display:flex;align-items:center;gap:.45em;padding:.55em .9em;background:#e9e6e2;border-bottom:1px solid #dcd8d3}
  .ste-bar i{width:.65em;height:.65em;border-radius:50%;background:#cbc6c0}
  .ste-bar i:first-child{background:#ff6b5e}
  .ste-bar span{margin-left:.8em;padding:.2em 1.2em;border-radius:99px;background:#fff;color:#6b6f76;font-size:.85em;min-width:45%}
  .ste-nav{display:flex;align-items:center;gap:1.5em;padding:.9em 1.8em;font-size:.9em;color:#55504a;font-weight:600}
  .ste-logo{font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:1.45em;color:#1d1a16;margin-right:auto}
  .ste-bt{background:#ff6900;color:#141006;font-weight:800;border-radius:99px;padding:.45em 1.1em;font-size:.9em;white-space:nowrap}
  .ste-bt2{border:1.5px solid #1d1a16;font-weight:800;border-radius:99px;padding:.35em 1.1em;font-size:.9em;white-space:nowrap}
  .ste-hero{display:grid;grid-template-columns:1fr 1.1fr;gap:1.6em;padding:.4em 1.8em;flex:1;min-height:0}
  .ste-hero-t{display:flex;flex-direction:column;justify-content:center;gap:.7em}
  .ste-hero-t small{color:#a84300;font-weight:800;text-transform:uppercase;letter-spacing:.1em;font-size:.72em}
  .ste-hero-t b{font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:2.6em;line-height:.92}
  .ste-hero-t p{color:#6b655d;font-size:.9em;max-width:24ch}
  .ste-hero-t div{display:flex;gap:.6em;margin-top:.3em}
  .ste-img{border-radius:1em;overflow:hidden;min-height:0}
  .ste-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1em;padding:1em 1.8em 1.4em;height:30%;flex:none}
  .ste-cards div{display:grid;grid-template-rows:1fr auto auto;gap:.2em;background:#fff;border-radius:.8em;padding:.45em;box-shadow:0 .3em 1em rgba(0,0,0,.06);min-height:0}
  .ste-cards img{border-radius:.55em;min-height:0}
  .ste-cards b{font-weight:800;font-size:.9em}
  .ste-cards small{color:#8a837a;font-size:.75em}
</style>
