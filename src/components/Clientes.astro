---
// Faixa de logos dos sites criados pela MKT Center (abaixo do hero), limitada à largura do site.
// Logos em public/clientes/ (originais em referencia/clientes/).
type Cliente = { nome: string; url: string; logo: string; w: number; h: number };
const clientes: Cliente[] = [
  { nome: 'Nexcabos', url: 'https://nexcabos.com.br/', logo: 'nexcabos', w: 320, h: 91 },
  { nome: 'Eletro EPI', url: 'https://eletroepi.com.br/', logo: 'eletroepi', w: 320, h: 69 },
  { nome: 'Igreja Ortodoxa Grega no Brasil', url: 'https://igrejaortodoxagregabrasil.com.br/', logo: 'igreja-ortodoxa', w: 284, h: 96 },
  { nome: 'Rollerport', url: 'https://rollerport.com.br/', logo: 'rollerport', w: 141, h: 96 },
  { nome: 'Sanremax', url: 'https://sanremax.com.br/', logo: 'sanremax', w: 320, h: 82 },
  { nome: 'Kimax', url: 'https://www.kimax.com.br/', logo: 'kimax', w: 196, h: 96 },
  { nome: 'Pugas News', url: 'https://pugasnews.com.br/', logo: 'pugas-news', w: 248, h: 96 },
  { nome: 'Rádio Conexão Católica', url: 'https://www.radioconexaocatolica.com.br/', logo: 'radio-conexao-catolica', w: 275, h: 96 },
  { nome: 'Pousada São José de Anchieta', url: 'https://pousadasaojosedeanchieta.com.br/', logo: 'pousada-anchieta', w: 320, h: 65 },
  { nome: 'Nano Dev', url: 'https://www.nanodev.com.br/', logo: 'nanodev', w: 320, h: 82 },
];
---
<section class="cl" aria-labelledby="cl-tit">
  <div class="wrap cl-cab">
    <div class="cl-txt">
      <h2 id="cl-tit" class="cl-tit">Marcas que já estão <span>no digital com a MKT</span></h2>
    </div>
  </div>

  <div class="wrap"><div class="cl-faixa">
    {[0, 1].map((copia) => (
      <ul class="cl-trilho" aria-hidden={copia === 1 ? 'true' : undefined}>
        {clientes.map((c) => (
          <li>
            <a class="cl-card" href={c.url} target="_blank" rel="noopener" tabindex={copia === 1 ? -1 : undefined} title={`${c.nome} · site criado pela MKT Center`}>
              <img src={`/clientes/${c.logo}.webp`} alt={copia === 0 ? c.nome : ''} width={c.w} height={c.h} loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div></div>
</section>

<style>
  .cl{background:var(--surface);padding:48px 0 52px;border-bottom:1px solid var(--line)}
  .cl-cab{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:24px}
  .cl-ey{display:inline-flex;align-items:center;gap:8px;color:var(--orange-text);font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .cl-ey::before{content:'';width:22px;height:2px;background:var(--orange);transform:skewX(-35deg)}
  .cl-tit{font-size:clamp(28px,3.2vw,38px);line-height:.95;margin:0;color:var(--ink)}
  .cl-tit span{color:var(--orange-text)}
  .cl-ver{flex:none;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 20px;border-radius:999px;border:1px solid var(--line-strong);color:var(--ink);font-weight:700;font-size:14px;text-decoration:none;transition:border-color .2s,background .2s}
  .cl-ver:hover{border-color:var(--orange);background:#fff}
  .cl-ver span{color:var(--orange-text);transition:transform .2s}
  .cl-ver:hover span{transform:translateX(3px)}

  /* carrossel limitado à largura do site (1140px) */
  .cl-faixa{display:flex;overflow:hidden;padding:8px 0 16px;mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
  .cl-trilho{flex:none;display:flex;align-items:center;gap:16px;padding-right:16px;list-style:none;margin:0;animation:cl-rolar 48s linear infinite}
  .cl-faixa:hover .cl-trilho{animation-play-state:paused}
  @keyframes cl-rolar{to{transform:translateX(-100%)}}
  .cl li{flex:none}
  .cl-card{position:relative;display:grid;place-items:center;width:200px;height:92px;padding:16px 22px;border-radius:var(--radius-lg);background:#fff;border:1px solid var(--line);box-shadow:0 2px 6px rgba(22,26,32,.05);transition:transform .3s cubic-bezier(.2,.8,.2,1),box-shadow .3s,border-color .3s}
  .cl-card img{display:block;width:100%;height:100%;min-height:0;object-fit:contain;filter:grayscale(1) contrast(1.05);opacity:.6;transition:filter .3s,opacity .3s}
  .cl-card:hover,.cl-card:focus-visible{transform:translateY(-4px);border-color:var(--orange);box-shadow:0 8px 14px -8px rgba(255,105,0,.5)}
  .cl-card:hover img,.cl-card:focus-visible img{filter:none;opacity:1}

  @media(max-width:767px){
    .cl{padding:36px 0 40px}
    .cl-cab{flex-direction:column;align-items:center;text-align:center;gap:16px;margin-bottom:18px}
    .cl-tit{font-size:30px}
    .cl-trilho{gap:12px;padding-right:12px;animation-duration:36s}
    .cl-card{width:150px;height:72px;padding:12px 16px}
  }
  @media (prefers-reduced-motion: reduce){
    .cl-faixa{mask-image:none;-webkit-mask-image:none;justify-content:center}
    .cl-trilho{animation:none;flex-wrap:wrap;justify-content:center;gap:12px;padding:0}
    .cl-trilho[aria-hidden]{display:none}
  }
</style>
