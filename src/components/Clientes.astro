---
// Faixa de logos dos sites criados pela MKT Center (abaixo do hero), limitada à largura do site.
// Logos em public/clientes/ (originais em referencia/clientes/).
type Cliente = { nome: string; url: string; logo: string; w: number; h: number };
const clientes: Cliente[] = [
  { nome: 'Nexcabos', url: 'https://nexcabos.com.br/', logo: 'nexcabos', w: 320, h: 91 },
  { nome: 'Eletro EPI', url: 'https://eletroepi.com.br/', logo: 'eletroepi', w: 320, h: 69 },
  { nome: 'Igreja Ortodoxa Grega no Brasil', url: 'https://igrejaortodoxagregabrasil.com.br/', logo: 'igreja-ortodoxa', w: 284, h: 96 },
  { nome: 'Rollerport', url: 'https://rollerport.com.br/', logo: 'rollerport', w: 141, h: 96 },
  { nome: 'Sanremax', url: 'https://sanremax.com.br/', logo: 'sanremax', w: 320, h: 82 },
  { nome: 'Kimax', url: 'https://www.kimax.com.br/', logo: 'kimax', w: 196, h: 96 },
  { nome: 'Pugas News', url: 'https://pugasnews.com.br/', logo: 'pugas-news', w: 248, h: 96 },
  { nome: 'Rádio Conexão Católica', url: 'https://www.radioconexaocatolica.com.br/', logo: 'radio-conexao-catolica', w: 275, h: 96 },
  { nome: 'Pousada São José de Anchieta', url: 'https://pousadasaojosedeanchieta.com.br/', logo: 'pousada-anchieta', w: 320, h: 65 },
  { nome: 'Nano Dev', url: 'https://www.nanodev.com.br/', logo: 'nanodev', w: 320, h: 82 },
];
---
<section class="cl" id="clientes" aria-label="Marcas que já estão no digital com a MKT">
  <div class="wrap"><div class="cl-faixa">
    {[0, 1].map((copia) => (
      <ul class="cl-trilho" aria-hidden={copia === 1 ? 'true' : undefined}>
        {clientes.map((c) => (
          <li>
            <a class={c.logo === 'kimax' ? 'cl-card cl-cor' : 'cl-card'} href={c.url} target="_blank" rel="noopener" tabindex={copia === 1 ? -1 : undefined} aria-hidden={copia === 1 ? "true" : undefined} title={`${c.nome} · site criado pela MKT Center`}>
              <img src={`/clientes/${c.logo}.webp`} alt={copia === 0 ? c.nome : ''} width={c.w} height={c.h} loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div></div>
</section>

<style>
  .cl{background:transparent;scroll-margin-top:72px}

  /* carrossel limitado à largura do site (1140px) */
  .cl-faixa{display:flex;overflow:hidden;padding:8px 0 16px;mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
  .cl-trilho{flex:none;display:flex;align-items:center;gap:56px;padding-right:56px;list-style:none;margin:0;animation:cl-rolar 110s linear infinite}
  .cl-faixa:hover .cl-trilho{animation-play-state:paused}
  @keyframes cl-rolar{to{transform:translateX(-100%)}}
  .cl li{flex:none}
  .cl-card{display:grid;place-items:center;width:190px;height:72px;padding:8px 14px;border-radius:14px;transition:background .3s}
  .cl-card img{display:block;width:100%;height:100%;min-height:0;object-fit:contain;filter:grayscale(1) brightness(0) invert(1);opacity:.38;transition:opacity .3s,filter .3s}
  .cl-cor img{filter:grayscale(1) contrast(1.2);opacity:.5}
  /* ao passar o mouse ou tocar: logo colorida oficial */
  .cl-card:hover img,.cl-card:focus-visible img,.cl-card:active img{filter:none;opacity:1}

  @media(max-width:767px){
    .cl-trilho{gap:36px;padding-right:36px;animation-duration:80s}
    .cl-card{width:140px;height:56px}
  }
  @media (prefers-reduced-motion: reduce){
    .cl-faixa{mask-image:none;-webkit-mask-image:none;justify-content:center}
    .cl-trilho{animation:none;flex-wrap:wrap;justify-content:center;gap:12px;padding:0}
    .cl-trilho[aria-hidden]{display:none}
  }
</style>
