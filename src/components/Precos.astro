---
// Seção "Nossos preços" (abaixo de "Por que a MKT Center"): cards de planos com preço, descrição,
// itens incluídos e botão para o WhatsApp. Valores informados pelo cliente.
import { waLink } from '../config';
type Plano = { nome: string; selo?: string; de: string; preco: string; per?: string; desc: string; itens: string[] };
const planos: Plano[] = [
  { nome: 'Landing Page', selo: 'Entrada', de: 'A partir de', preco: 'R$ 300', desc: 'Página direta para divulgar um produto, serviço ou campanha.', itens: ['Página única', 'Botão de WhatsApp e formulário', 'Pensada para celular'] },
  { nome: 'Site Institucional', de: 'A partir de', preco: 'R$ 600', desc: 'Presença completa para pequenas empresas e profissionais.', itens: ['Até 4 páginas', 'WhatsApp, formulário e mapa', 'Pronto para o Google'] },
  { nome: 'Site Profissional', selo: 'Mais completo', de: 'A partir de', preco: 'R$ 1.000', desc: 'Estrutura completa para posicionamento e geração de contatos.', itens: ['Mais páginas e seções', 'SEO e Analytics', 'Integrações'] },
  { nome: 'Gestão de Redes Sociais', selo: 'Mensal', de: 'A partir de', preco: 'R$ 400', per: '/mês', desc: 'Sua marca presente e ativa nas redes todos os meses.', itens: ['Planejamento de conteúdo', 'Publicações nas redes', 'Acompanhamento de resultados'] },
  { nome: 'Edição de Vídeos', de: 'A partir de', preco: 'R$ 50', per: '/vídeo', desc: 'Vídeos editados para Reels, Stories e anúncios.', itens: ['Cortes e legendas', 'Formato para cada rede', 'Entrega pronta para postar'] },
  { nome: 'Criação de Posts', de: 'A partir de', preco: 'R$ 30', per: '/card', desc: 'Cards com a identidade da sua marca para as redes.', itens: ['Arte com a sua marca', 'Feed e Stories', 'Texto da publicação'] },
  { nome: 'Sistemas e Aplicativos', selo: 'Sob medida', de: 'Valor', preco: 'Sob consulta', desc: 'Orçamento combinado conforme o projeto e as funcionalidades.', itens: ['Aplicativos e sistemas web', 'Painéis e integrações', 'Proposta personalizada'] },
];
---
<section class="pr" id="precos">
  <div class="wrap">
    <span class="eyebrow">Investimento</span>
    <div class="pr-cab">
      <h2>Nossos preços</h2>
      <div class="pr-setas">
        <button type="button" class="pr-seta" data-dir="-1" aria-label="Planos anteriores"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button>
        <button type="button" class="pr-seta" data-dir="1" aria-label="Próximos planos"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button>
      </div>
    </div>
    <div class="pr-grid" tabindex="0" aria-label="Planos (role para o lado)">
      {planos.map((p) => (
        <article class="pr-card">
          <div class="pr-top"><h3>{p.nome}</h3>{p.selo && <span class="pr-selo">{p.selo}</span>}</div>
          <p class="pr-preco"><small>{p.de}</small>{p.preco}{p.per && <em>{p.per}</em>}</p>
          <p class="pr-desc">{p.desc}</p>
          <ul>{p.itens.map((i) => <li>{i}</li>)}</ul>
          <a class="pr-bt" href={waLink(`Olá! Quero saber mais sobre: ${p.nome}.`)} target="_blank" rel="noopener">Falar sobre este plano
            <svg viewBox="0 0 32 32" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm5.9 15.7c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.7-.4z" /></svg>
          </a>
        </article>
      ))}
    </div>
    <div class="pr-fim">
      <a class="btn btn-primary" href={waLink('Olá! Quero falar sobre o meu projeto.')} target="_blank" rel="noopener">Falar sobre meu projeto
        <svg viewBox="0 0 32 32" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm5.9 15.7c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.7-.4z" /></svg>
      </a>
      <a class="btn pr-ghost" href="/contato/">Enviar briefing <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .pr-cab{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:24px}
  .pr-cab h2{margin:0}
  .pr-setas{display:flex;gap:8px}
  .pr-seta{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.04);color:#fff;cursor:pointer;transition:border-color .2s,background .2s,opacity .2s}
  .pr-seta:hover{border-color:#ff6900;background:rgba(255,105,0,.15)}
  .pr-seta:disabled{opacity:.3;cursor:default;border-color:rgba(255,255,255,.18);background:transparent}
  /* carrossel numa linha: rola para o lado (com o dedo, o mouse ou as setas) */
  .pr-grid{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:4px 2px 18px;scrollbar-width:thin;scrollbar-color:#ff6900 rgba(255,255,255,.06);outline:none}
  .pr-grid::-webkit-scrollbar{height:6px}
  .pr-grid::-webkit-scrollbar-thumb{background:#ff6900;border-radius:9px}
  .pr-grid::-webkit-scrollbar-track{background:rgba(255,255,255,.06);border-radius:9px}
  .pr-card{flex:0 0 calc((100% - 48px) / 4);scroll-snap-align:start}
  @media(max-width:1023px){.pr-card{flex-basis:calc((100% - 16px) / 2)}}
  @media(max-width:639px){.pr-card{flex-basis:84%}.pr-cab{justify-content:center}.pr-setas{display:none}}
  .pr-card{position:relative;display:flex;flex-direction:column;padding:24px 22px 22px;border-radius:var(--radius-lg);overflow:hidden;text-align:left;
    background:linear-gradient(160deg,rgba(28,29,33,.85),rgba(12,13,15,.9));border:1px solid rgba(255,255,255,.08);box-shadow:0 20px 40px -24px rgba(0,0,0,.9);transition:border-color .3s,transform .3s}
  .pr-card::before{content:'';position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg,#ff6900,#ffb35c)}
  .pr-card:hover{border-color:rgba(255,105,0,.45);transform:translateY(-4px)}
  .pr-top{display:flex;align-items:center;flex-wrap:wrap;gap:10px}
  .pr-top h3{font-family:var(--ff-txt);text-transform:none;font-size:17px;font-weight:700;color:#fff}
  .pr-selo{padding:4px 10px;border-radius:99px;background:linear-gradient(90deg,#ff6900,#ffb35c);color:#141006;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .pr-preco em{font-style:normal;font-size:18px;margin-left:2px}
  .pr-preco small{display:block;font-family:var(--ff-txt);font-weight:600;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#aeb4bd;-webkit-text-fill-color:#aeb4bd;margin-bottom:2px}
  .pr-preco{margin-top:12px;font-family:var(--ff-tit);font-weight:800;font-size:32px;line-height:1.05;white-space:nowrap;background:linear-gradient(90deg,#ff8a24,#ffc993);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .pr-desc{margin-top:10px;color:#aeb4bd;font-size:14px;line-height:21px}
  .pr-card ul{list-style:none;margin:14px 0 20px;padding:0;display:grid;gap:8px}
  .pr-card li{position:relative;padding-left:16px;font-size:14px;color:#e4e6ea}
  .pr-card li::before{content:'';position:absolute;left:0;top:9px;width:6px;height:6px;border-radius:50%;background:#ff6900}
  .pr-bt{margin-top:auto;align-self:flex-start;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 20px;border-radius:99px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.04);color:#fff;font-weight:700;font-size:14px;text-decoration:none;transition:border-color .2s,background .2s}
  .pr-bt:hover{border-color:#ff6900;background:rgba(255,105,0,.12)}
  .pr-fim{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:32px}
  .pr-ghost{border-color:#5b616b;color:#fff;background:transparent}
  .pr-ghost:hover{border-color:#fff}
  @media(max-width:767px){.pr-card{text-align:left}.pr-fim .btn{width:100%}}
</style>

<script>
  document.querySelectorAll<HTMLElement>('#precos').forEach((sec) => {
    const trilho = sec.querySelector<HTMLElement>('.pr-grid')!;
    const setas = sec.querySelectorAll<HTMLButtonElement>('.pr-seta');
    const passo = () => (trilho.querySelector<HTMLElement>('.pr-card')?.offsetWidth || 280) + 16;
    setas.forEach((b) => b.addEventListener('click', () => trilho.scrollBy({ left: Number(b.dataset.dir) * passo(), behavior: 'smooth' })));
    const atualizar = () => {
      setas[0].disabled = trilho.scrollLeft < 4;
      setas[1].disabled = trilho.scrollLeft + trilho.clientWidth >= trilho.scrollWidth - 4;
    };
    trilho.addEventListener('scroll', atualizar, { passive: true });
    addEventListener('resize', atualizar);
    atualizar();
  });
</script>
