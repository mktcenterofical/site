---
const path = Astro.url.pathname;
const itens: [string, string, string][] = [
  ['/', '🏠', 'Início'],
  ['/#servicos', '🧩', 'Serviços'],
  ['/portfolio/', '🗂️', 'Portfólio'],
  ['/contato/', '✉️', 'Contato'],
];
---
<nav class="tab" aria-label="Navegação rápida">
  {itens.map(([u, i, n]) => (
    <a href={u} aria-current={path === u ? 'page' : undefined}><span aria-hidden="true">{i}</span>{n}</a>
  ))}
</nav>
<style>
  .tab{position:fixed;bottom:0;left:0;right:0;z-index:60;display:grid;grid-template-columns:repeat(4,1fr);background:var(--grafite);border-top:1px solid var(--linha);height:64px}
  .tab a{display:grid;place-items:center;align-content:center;gap:2px;font-size:.72rem;text-decoration:none;color:var(--prata)}
  .tab a span{font-size:1.2rem}
  .tab a[aria-current]{color:var(--laranja)}
  @media(min-width:1180px){.tab{display:none}}
</style>
