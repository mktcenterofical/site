---
// Rodapé minimalista: marca + colunas de links + contato, assinatura gigante "MKT CENTER" e linha final.
import { config, waLink } from '../config';
import FaixaCTA from './FaixaCTA.astro';
const ano = new Date().getFullYear();
const paginas: [string, string][] = [
  ['/', 'Início'], ['/quem-somos/', 'Sobre'], ['/portfolio/', 'Portfólio'], ['/contato/', 'Contato'],
];
const servicos: [string, string][] = [
  ['/criacao-de-sites/', 'Sites'], ['/loja-virtual/', 'Lojas virtuais'], ['/aplicativos-e-sistemas/', 'Apps e sistemas'],
  ['/videos/', 'Vídeos'], ['/trafego-e-seo/', 'Tráfego e SEO'], ['/marketing-politico/', 'Marketing político'],
];
const redes: [string, string, string][] = [
  ['Instagram', 'https://www.instagram.com/mktcenteroficial/', '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/>'],
  ['Facebook', 'https://www.facebook.com/mktcenteroficial', '<path d="M15 3h-2.5A4.5 4.5 0 0 0 8 7.5V10H5.5v4H8v7h4v-7h3l.5-4H12V8a1 1 0 0 1 1-1h2z"/>'],
  ['LinkedIn', 'https://www.linkedin.com/in/mktcenteroficial', '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>'],
  ['YouTube', 'https://www.youtube.com/@mktcenteroficial', '<rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 5 3-5 3z" fill="currentColor"/>'],
  ['TikTok', 'https://www.tiktok.com/@mktcenteroficial', '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.1 4.2 5 4.5"/>'],
];
const wa = '<path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.7-.4z"/>';
---
<footer class="rd">
  <FaixaCTA />
  <div class="wrap rd-in">
    <div class="rd-topo">
      <div class="rd-marca">
        <a href="/" aria-label="MKT Center, página inicial"><img src="/logo-escuro.webp" alt="MKT Center Marketing Digital" width="201" height="32" loading="lazy" /></a>
        <p>Sites, lojas, apps, vídeos e campanhas que levam o cliente direto para o seu WhatsApp.</p>
        <a class="rd-wa" href={waLink()} target="_blank" rel="noopener">
          <svg viewBox="0 0 32 32" width="18" height="18" fill="currentColor" aria-hidden="true" set:html={wa} />
          Falar no WhatsApp <span aria-hidden="true">↗</span>
        </a>
        <div class="rd-redes">
          {redes.map(([n, u, d]) => (
            <a href={u} target="_blank" rel="noopener" aria-label={n} title={n}><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={d} /></a>
          ))}
        </div>
      </div>
      <nav class="rd-col" aria-label="Páginas">
        <h2>Navegação</h2>
        {paginas.map(([u, n]) => <a href={u}>{n}</a>)}
      </nav>
      <nav class="rd-col" aria-label="Serviços">
        <h2>Serviços</h2>
        {servicos.map(([u, n]) => <a href={u}>{n}</a>)}
      </nav>
      <div class="rd-col">
        <h2>Contato</h2>
        <a href={`mailto:${config.email}`}>{config.email}</a>
        <a href={waLink()} target="_blank" rel="noopener">{config.telefone}</a>
        <span>{config.horario}</span>
        <span>{config.cidade}</span>
      </div>
    </div>


    <div class="rd-base">
      <span>© {ano} {config.nome} · CNPJ {config.cnpj}</span>
      <a href="/politica-de-privacidade/">Política de privacidade</a>
      <a href="/termos/">Termos de uso</a>
      <a href="#" class="rd-topo-bt">Voltar ao topo <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .rd{position:relative;margin-top:24px;padding:0 0 24px;background:linear-gradient(180deg,rgba(9,10,12,0),rgba(9,10,12,.85) 30%);overflow:hidden}
  .rd-in{padding-top:56px}
  .rd-topo{display:grid;gap:40px 32px;grid-template-columns:1fr}
  @media(min-width:768px){.rd-topo{grid-template-columns:1.6fr 1fr 1fr 1.2fr}}
  .rd-marca img{height:28px;width:auto}
  .rd-marca p{margin-top:16px;max-width:34ch;color:#aeb4bd;font-size:15px;line-height:1.55}
  .rd-wa{display:inline-flex;align-items:center;gap:8px;margin-top:20px;padding:10px 18px;border-radius:999px;border:1px solid rgba(37,211,102,.4);background:rgba(37,211,102,.08);color:#fff;font-size:14px;font-weight:700;text-decoration:none;transition:background .2s,border-color .2s}
  .rd-wa svg{color:#25d366}
  .rd-wa:hover{background:rgba(37,211,102,.16);border-color:#25d366}
  .rd-col{display:flex;flex-direction:column;gap:10px;min-width:0}
  .rd-col h2{margin:0 0 6px;font-family:var(--ff-txt);text-transform:uppercase;font-size:12px;font-weight:700;letter-spacing:.16em;color:#ff8a24}
  .rd-col a,.rd-col span{color:#c3c8cf;font-size:15px;text-decoration:none;overflow-wrap:anywhere;width:fit-content;max-width:100%;transition:color .2s}
  .rd-col a{position:relative}
  .rd-col a::after{content:'';position:absolute;left:0;right:0;bottom:-2px;height:1px;background:#ff6900;transform:scaleX(0);transform-origin:left;transition:transform .3s}
  .rd-col a:hover{color:#fff}
  .rd-col a:hover::after{transform:scaleX(1)}

  .rd-redes{display:flex;gap:10px;margin-top:16px}
  .rd-redes a{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,.12);color:#c3c8cf;transition:color .2s,border-color .2s,background .2s,transform .2s}
  .rd-redes a:hover{color:#fff;border-color:#ff6900;background:rgba(255,105,0,.12);transform:translateY(-2px)}

  .rd-base{margin-top:44px;display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;padding-top:20px;border-top:1px solid rgba(255,255,255,.07);color:#8a9099;font-size:13px}
  .rd-base a{color:#8a9099;text-decoration:none;transition:color .2s}
  .rd-base a:hover{color:#fff}
  .rd-topo-bt{margin-left:auto}

  .rd-col a[href^="mailto"]{overflow-wrap:normal;white-space:nowrap}

  /* tablet: marca numa faixa (texto à esquerda, WhatsApp e redes à direita) e as 3 colunas embaixo */
  @media(min-width:768px) and (max-width:1023px){
    .rd-topo{grid-template-columns:repeat(3,1fr);gap:36px 24px}
    .rd-marca{grid-column:1 / -1;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;column-gap:32px;align-items:center;
      padding-bottom:32px;border-bottom:1px solid rgba(255,255,255,.07)}
    .rd-marca>a:first-child{grid-column:1}
    .rd-marca p{grid-column:1;margin-top:12px;max-width:44ch}
    .rd-wa{grid-column:2;grid-row:1;margin:0;justify-self:end}
    .rd-redes{grid-column:2;grid-row:2;margin-top:12px;justify-self:end}
    .rd-base{padding-right:72px}
  }

  /* celular: marca centralizada e cada bloco (Navegação, Serviços, Contato) numa grade de 2 colunas iguais,
     tudo alinhado na mesma margem esquerda, com linhas finas entre os blocos */
  @media(max-width:767px){
    .rd-in{padding-top:40px}
    .rd-topo{grid-template-columns:1fr;gap:0}
    .rd-marca{display:flex;flex-direction:column;align-items:center;text-align:center;padding-bottom:28px}
    .rd-marca p{margin-inline:auto;font-size:14px}
    .rd-redes{justify-content:center}
    .rd-col{display:grid;grid-template-columns:1fr;gap:12px;padding:22px 4px;border-top:1px solid rgba(255,255,255,.07);text-align:left}
    .rd-col h2{grid-column:1 / -1;margin:0 0 2px}
    .rd-col a,.rd-col span{font-size:14px;width:auto}
    .rd-col a[href^="mailto"]{grid-column:1 / -1}
    .rd-base{margin-top:8px;justify-content:center;gap:8px 18px;text-align:center;padding-top:20px}
    .rd-base>span{flex-basis:100%}
    .rd-topo-bt{margin-left:0}
  }
</style>
