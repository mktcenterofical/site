---
// Seção cinematográfica abaixo do hero (componente "sunset skyline hero" enviado pelo cliente, adaptado).
// A rolagem avança e volta o vídeo da janela com a cidade; quando o vídeo acaba, MKT CENTER surge e o
// recorte do skyline aparece por cima, deixando os prédios na frente das letras.
// Sem travar a página: a seção é alta e o palco fica "sticky" enquanto ela passa.
// Vídeo e recorte: assets de demonstração do componente original (public/cena/, originais em referencia/).
---
<section class="sp" id="sp" aria-label="Seus projetos com a MKT Center">
  <div class="sp-palco">
    <video class="sp-video" src="/cena/cidade.mp4" poster="/cena/inicio.webp" muted playsinline preload="auto" aria-hidden="true"></video>
    <div class="sp-marca" aria-hidden="true"><span>MKT</span> <span>CENTER</span></div>
    <img class="sp-skyline" src="/cena/skyline.webp" alt="" width="1672" height="941" aria-hidden="true" loading="lazy" decoding="async" />
    <div class="sp-veu" aria-hidden="true"></div>
    <h2 class="sp-titulo">Seus projetos com a <span class="sr">MKT Center</span></h2>
    <div class="sp-dica" aria-hidden="true"><span>Role</span><svg viewBox="0 0 14 18" width="14" height="18"><path d="M7 1v16M2 12l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
    <div class="sp-barra" aria-hidden="true"><i></i></div>
  </div>
</section>

<style>
  .sp{position:relative;height:224vh;background:#1a0f0a;padding:0}
  .sp-palco{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;isolation:isolate;background:#1a0f0a}
  .sp-video,.sp-skyline{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;max-width:none}
  .sp-skyline{z-index:2;opacity:0;pointer-events:none}
  .sp-marca{position:absolute;inset:0;z-index:1;display:flex;align-items:center;justify-content:center;gap:.22em;padding:0 6% 20vh;font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:clamp(70px,15vw,250px);line-height:.88;color:#fff4e8;text-shadow:0 8px 60px rgba(0,0,0,.45);opacity:0;pointer-events:none;white-space:nowrap}
  .sp-marca span:first-child{color:#ff8a24}
  .sp-veu{position:absolute;inset:0;z-index:3;pointer-events:none;background:linear-gradient(180deg,rgba(26,15,10,.35),rgba(26,15,10,0) 30%,rgba(26,15,10,.15) 70%,rgba(26,15,10,.55))}
  .sp-titulo{position:absolute;left:0;right:0;top:50%;z-index:4;margin:0;padding:0 16px;transform:translateY(-50%);text-align:center;font-size:clamp(36px,6vw,92px);line-height:.95;color:#fff4e8;text-shadow:0 4px 30px rgba(0,0,0,.55);pointer-events:none;will-change:transform,opacity}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .sp-dica{position:absolute;left:50%;bottom:clamp(20px,6vh,48px);z-index:4;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;color:rgba(255,244,232,.75);font-size:12px;font-weight:700;letter-spacing:.3em;text-transform:uppercase;transition:opacity .4s}
  .sp-dica svg{animation:sp-pula 1.6s ease-in-out infinite}
  @keyframes sp-pula{0%,100%{transform:translateY(0);opacity:.5}50%{transform:translateY(5px);opacity:1}}
  .sp-barra{position:absolute;left:0;right:0;bottom:0;height:2px;z-index:4;background:rgba(255,244,232,.12)}
  .sp-barra i{display:block;height:100%;background:linear-gradient(90deg,#ff6900,#ffb35c);transform:scaleX(0);transform-origin:left}

  @media(max-width:640px){
    .sp{height:182vh}
    .sp-marca{flex-direction:column;gap:0;font-size:clamp(76px,26vw,140px);padding-bottom:26vh}
  }
  @media (prefers-reduced-motion: reduce){
    .sp{height:auto}
    .sp-palco{position:relative}
    .sp-dica{display:none}
  }
</style>

<script>
  const sec = document.getElementById('sp')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends Element>(s: string) => sec.querySelector<T>(s)!;
  const video = $<HTMLVideoElement>('.sp-video');
  const marca = $<HTMLElement>('.sp-marca');
  const skyline = $<HTMLImageElement>('.sp-skyline');
  const titulo = $<HTMLElement>('.sp-titulo');
  const dica = $<HTMLElement>('.sp-dica');
  const barra = $<HTMLElement>('.sp-barra i');
  const c = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  // pontos da rolagem (mesmos do componente original)
  const FIM_VIDEO = .78, MARCA_INI = .8, MARCA_FIM = .93, SKY_INI = .85, SKY_FIM = .96;

  // busca de quadro sem empilhar pedidos: guarda o último enquanto o vídeo ainda está buscando
  let duracao = 0, buscando = false, pendente: number | null = null;
  video.addEventListener('loadedmetadata', () => (duracao = video.duration || 0));
  video.addEventListener('seeked', () => { buscando = false; if (pendente !== null) { const t = pendente; pendente = null; irPara(t); } });
  function irPara(t: number) {
    if (buscando) { pendente = t; return; }
    if (Math.abs(video.currentTime - t) < .01) return;
    buscando = true; video.currentTime = t;
  }

  function pintar(p: number) {
    if (duracao) irPara(c(p / FIM_VIDEO) * (duracao - .05));
    // a frase fica no centro e sobe quando a marca chega, formando "SEUS PROJETOS COM A / MKT CENTER"
    const sobe = c((p - .7) / .2);
    const desloc = innerWidth <= 640 ? 36 : 24;
    titulo.style.transform = `translateY(calc(-50% - ${sobe * desloc}vh)) scale(${1 - sobe * .4})`;
    const m = c((p - MARCA_INI) / (MARCA_FIM - MARCA_INI));
    marca.style.opacity = String(m);
    marca.style.transform = `translateY(${(1 - m) * 16}px) scale(${.98 + m * .02})`;
    marca.style.filter = `blur(${(1 - m) * 6}px)`;
    marca.style.letterSpacing = `${(1 - m) * .25}em`;
    skyline.style.opacity = String(c((p - SKY_INI) / (SKY_FIM - SKY_INI)));
    dica.style.opacity = p > .02 ? '0' : '1';
    barra.style.transform = `scaleX(${p})`;
  }

  // ?cena=1 mostra a cena parada num ponto (útil para apresentar e testar)
  const cena = new URLSearchParams(location.search).get('cena');
  if (reduce || cena) {
    const p = cena ? Number(cena) : 1;
    video.addEventListener('loadedmetadata', () => pintar(p), { once: true });
    pintar(p);
  } else {
    let alvo = 0, atual = 0, ativo = false, raf = 0;
    const medir = () => {
      const r = sec.getBoundingClientRect();
      alvo = c(-r.top / (r.height - innerHeight));
      ativo = r.top < innerHeight && r.bottom > 0;
      if (ativo && !raf) raf = requestAnimationFrame(quadro);
    };
    function quadro() {
      atual += (alvo - atual) * .18;
      if (Math.abs(alvo - atual) < .0005) atual = alvo;
      pintar(atual);
      raf = ativo && atual !== alvo ? requestAnimationFrame(quadro) : 0;
    }
    addEventListener('scroll', medir, { passive: true });
    addEventListener('resize', medir);
    pintar(0);
    medir();
  }
</script>
