---
// Seção cinematográfica abaixo do hero: skyline de São Paulo em vetor (Ponte Estaiada e Obelisco do Ibirapuera).
// Comandada pela rolagem (seção alta + palco "sticky"): o pôr do sol escurece, as janelas acendem e a frase
// "SEUS PROJETOS COM A" se completa com MKT CENTER surgindo por trás dos prédios.
// Inspirada no componente "sunset skyline hero" enviado pelo cliente, recriada sem vídeo e sem travar a página.

// gerador pseudoaleatório fixo, para o desenho sair sempre igual
function rng(seed: number) {
  return () => { seed |= 0; seed = (seed + 0x6d2b79f5) | 0; let t = Math.imul(seed ^ (seed >>> 15), 1 | seed); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
}
const BASE = 780;
const OBELISCO = 620, PONTE = 975;

// prédios do fundo (mais altos e apagados)
const r1 = rng(7);
const fundo: { x: number; w: number; h: number }[] = [];
for (let x = -20; x < 1620; ) { const w = 38 + r1() * 70; fundo.push({ x, w, h: 150 + r1() * 260 }); x += w - 4; }

// prédios da frente: mais baixos perto da ponte e do obelisco, para os dois aparecerem contra o céu
const r2 = rng(42);
const frente: { x: number; w: number; h: number }[] = [];
for (let x = -20; x < 1620; ) {
  const w = 34 + r2() * 64;
  const meio = x + w / 2;
  let h = 70 + r2() * 230;
  if (Math.abs(meio - PONTE) < 230) h = Math.min(h, 34 + r2() * 26);
  if (Math.abs(meio - OBELISCO) < 70) h = Math.min(h, 60);
  else if (Math.abs(meio - 800) < 520) h = Math.min(h, 70 + r2() * 90); // centro mais baixo: a marca aparece por cima
  frente.push({ x, w, h });
  x += w + (r2() < .25 ? 6 : 0);
}

// janelas que acendem com a rolagem
const r3 = rng(99);
const janelas: { x: number; y: number; t: number }[] = [];
for (const p of frente) {
  if (p.h < 90) continue;
  for (let y = BASE - p.h + 14; y < BASE - 10; y += 16) {
    for (let x = p.x + 8; x < p.x + p.w - 10; x += 13) {
      if (r3() < .42) janelas.push({ x, y, t: +(0.25 + r3() * .6).toFixed(3) });
    }
  }
}

// cabos da Ponte Estaiada: do mastro em X até o tabuleiro, em leque
const cabos: [number, number, number, number][] = [];
for (let i = 0; i < 9; i++) {
  const y = 360 + i * 24;
  cabos.push([PONTE - 6 + i * 1.2, y, PONTE - 300 + i * 30, 742 - i * 2]);
  cabos.push([PONTE + 6 - i * 1.2, y, PONTE + 300 - i * 30, 742 - i * 2]);
}
---
<section class="sp" id="sp" aria-label="Seus projetos com a MKT Center">
  <div class="sp-palco">
    <svg class="sp-svg sp-tras" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <linearGradient id="sp-dia" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#2a1a2e" />
          <stop offset=".45" stop-color="#b8461a" />
          <stop offset=".75" stop-color="#ff8a24" />
          <stop offset="1" stop-color="#ffcf8a" />
        </linearGradient>
        <linearGradient id="sp-noite" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#05060a" />
          <stop offset=".6" stop-color="#0d0f16" />
          <stop offset="1" stop-color="#2a1608" />
        </linearGradient>
        <radialGradient id="sp-sol" cx=".5" cy=".5" r=".5">
          <stop offset="0" stop-color="#fff1d6" />
          <stop offset=".35" stop-color="#ffb35c" />
          <stop offset="1" stop-color="#ff6900" stop-opacity="0" />
        </radialGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#sp-dia)" />
      <rect class="sp-noite" width="1600" height="900" fill="url(#sp-noite)" opacity="0" />
      <g class="sp-sol"><circle cx="800" cy="0" r="260" fill="url(#sp-sol)" opacity=".7" /><circle cx="800" cy="0" r="86" fill="#ffe2b0" /></g>
      <g class="sp-fundo" fill="#4a2414">
        {fundo.map((p) => <rect x={p.x} y={BASE - p.h} width={p.w} height={p.h + 10} />)}
      </g>
    </svg>

    <div class="sp-marca" aria-hidden="true"><span>MKT</span> <span>CENTER</span></div>

    <svg class="sp-svg sp-frente" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <linearGradient id="sp-rio" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#1a0f08" />
          <stop offset="1" stop-color="#050506" />
        </linearGradient>
      </defs>
      <g fill="#0b0806">
        {frente.map((p) => <rect x={p.x} y={BASE - p.h} width={p.w} height={p.h + 2} />)}
        <!-- Obelisco do Ibirapuera -->
        <rect x={OBELISCO - 34} y={BASE - 22} width="68" height="24" />
        <polygon points={`${OBELISCO - 19},${BASE - 22} ${OBELISCO + 19},${BASE - 22} ${OBELISCO + 10},300 ${OBELISCO - 10},300`} />
        <polygon points={`${OBELISCO - 10},300 ${OBELISCO + 10},300 ${OBELISCO},262`} />
        <!-- Ponte Estaiada: tabuleiros curvos, mastro em X e cabos -->
        <path d={`M ${PONTE - 380} 752 Q ${PONTE} 712 ${PONTE + 380} 752 L ${PONTE + 380} 764 Q ${PONTE} 726 ${PONTE - 380} 764 Z`} />
        <path d={`M ${PONTE - 330} 770 Q ${PONTE} 738 ${PONTE + 330} 770 L ${PONTE + 330} 780 Q ${PONTE} 750 ${PONTE - 330} 780 Z`} />
        <polygon points={`${PONTE - 70},${BASE} ${PONTE - 52},${BASE} ${PONTE + 12},330 ${PONTE},330`} />
        <polygon points={`${PONTE + 70},${BASE} ${PONTE + 52},${BASE} ${PONTE - 12},330 ${PONTE},330`} />
        <polygon points={`${PONTE - 8},336 ${PONTE + 8},336 ${PONTE + 3},286 ${PONTE - 3},286`} />
      </g>
      <g stroke="#0b0806" stroke-width="2.2">
        {cabos.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
      </g>
      <g class="sp-janelas" fill="#ffb35c">
        {janelas.map((j) => <rect x={j.x} y={j.y} width="6" height="8" data-t={j.t} opacity="0" />)}
      </g>
      <rect y={BASE} width="1600" height={900 - BASE} fill="url(#sp-rio)" />
      <g class="sp-reflexo" fill="#ff8a24" opacity=".35">
        <rect x="660" y="800" width="280" height="2" /><rect x="700" y="816" width="200" height="2" /><rect x="740" y="834" width="120" height="2" />
      </g>
      <g class="sp-luzes" fill="#ffd9a6" opacity="0">
        <circle cx={PONTE} cy="290" r="4" /><circle cx={OBELISCO} cy="266" r="3" />
      </g>
    </svg>

    <div class="sp-veu" aria-hidden="true"></div>
    <h2 class="sp-titulo">Seus projetos com a <span class="sr">MKT Center</span></h2>
    <div class="sp-dica" aria-hidden="true"><span>Role</span><svg viewBox="0 0 14 18" width="14" height="18"><path d="M7 1v16M2 12l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
    <div class="sp-barra" aria-hidden="true"><i></i></div>
  </div>
</section>

<style>
  .sp{position:relative;height:320vh;background:#05060a;padding:0}
  .sp-palco{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;isolation:isolate}
  .sp-svg{position:absolute;inset:0;width:100%;height:100%;display:block}
  .sp-frente{z-index:2;transform-origin:50% 100%}
  .sp-marca{position:absolute;left:0;right:0;bottom:24vh;z-index:1;display:flex;justify-content:center;gap:.25em;font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:clamp(80px,17vw,300px);line-height:.85;color:#fff4e8;text-shadow:0 10px 60px rgba(0,0,0,.45);opacity:0;pointer-events:none;white-space:nowrap}
  .sp-marca span:first-child{color:#ff8a24}
  .sp-veu{position:absolute;inset:0;z-index:3;pointer-events:none;background:linear-gradient(180deg,rgba(9,10,12,.65),rgba(9,10,12,0) 32%,rgba(9,10,12,0) 70%,rgba(9,10,12,.75))}
  .sp-titulo{position:absolute;left:0;right:0;top:50%;z-index:4;margin:0;padding:0 16px;transform:translateY(-50%);text-align:center;font-size:clamp(40px,7vw,104px);line-height:.92;color:#fff4e8;text-shadow:0 6px 40px rgba(0,0,0,.55);pointer-events:none;will-change:transform}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .sp-dica{position:absolute;left:50%;bottom:28px;z-index:4;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;color:rgba(255,244,232,.75);font-size:12px;font-weight:700;letter-spacing:.3em;text-transform:uppercase;transition:opacity .4s}
  .sp-dica svg{animation:sp-pula 1.6s ease-in-out infinite}
  @keyframes sp-pula{0%,100%{transform:translateY(0);opacity:.5}50%{transform:translateY(5px);opacity:1}}
  .sp-barra{position:absolute;left:0;right:0;bottom:0;height:2px;z-index:4;background:rgba(255,244,232,.12)}
  .sp-barra i{display:block;height:100%;background:linear-gradient(90deg,#ff6900,#ffb35c);transform:scaleX(0);transform-origin:left}

  @media(max-width:767px){
    .sp{height:260vh}
    .sp-marca{flex-direction:column;align-items:center;gap:0;bottom:20vh;font-size:clamp(84px,30vw,150px)}
  }
  @media (prefers-reduced-motion: reduce){
    .sp{height:auto}
    .sp-palco{position:relative}
    .sp-dica{display:none}
  }
</style>

<script>
  const sec = document.getElementById('sp')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const $ = <T extends Element>(s: string) => sec.querySelector<T>(s)!;
  const noite = $<SVGRectElement>('.sp-noite');
  const sol = $<SVGGElement>('.sp-sol');
  const fundo = $<SVGGElement>('.sp-fundo');
  const frente = $<SVGSVGElement>('.sp-frente');
  const marca = $<HTMLElement>('.sp-marca');
  const titulo = $<HTMLElement>('.sp-titulo');
  const dica = $<HTMLElement>('.sp-dica');
  const barra = $<HTMLElement>('.sp-barra i');
  const luzes = $<SVGGElement>('.sp-luzes');
  const reflexo = $<SVGGElement>('.sp-reflexo');
  const janelas = Array.from(sec.querySelectorAll<SVGRectElement>('.sp-janelas rect')).map((el) => ({ el, t: Number(el.dataset.t), on: false }));
  const c = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

  function pintar(p: number) {
    noite.setAttribute('opacity', String(c(p * 1.15) * .92));
    sol.setAttribute('transform', `translate(0 ${560 + p * 300})`);
    sol.setAttribute('opacity', String(1 - c(p * 1.3) * .85));
    fundo.setAttribute('fill', p > .55 ? '#1c120d' : '#4a2414');
    fundo.style.opacity = String(1 - c(p) * .35);
    frente.style.transform = `scale(${1.06 - p * .06})`;
    reflexo.setAttribute('opacity', String(.35 * (1 - p) + .15));
    luzes.setAttribute('opacity', String(c((p - .6) / .2)));
    for (const j of janelas) { const on = p > j.t; if (on !== j.on) { j.on = on; j.el.setAttribute('opacity', on ? '.9' : '0'); } }

    // frase: começa grande no centro e sobe para dar lugar à marca
    const sobe = c((p - .3) / .35);
    titulo.style.transform = `translateY(calc(-50% - ${sobe * 26}vh)) scale(${1 - sobe * .45})`;
    // MKT CENTER surge por trás dos prédios
    const m = c((p - .48) / .35);
    marca.style.opacity = String(m);
    marca.style.transform = `translateY(${(1 - m) * 40}px) scale(${.96 + m * .04})`;
    marca.style.filter = `blur(${(1 - m) * 8}px)`;
    marca.style.letterSpacing = `${(1 - m) * .2}em`;
    dica.style.opacity = p > .02 ? '0' : '1';
    barra.style.transform = `scaleX(${p})`;
  }

  // ?cena=0.7 mostra a cena parada num ponto (útil para apresentar e testar)
  const cena = new URLSearchParams(location.search).get('cena');
  if (reduce || cena) {
    pintar(cena ? Number(cena) : 1);
  } else {
    let alvo = 0, atual = 0, ativo = false, raf = 0;
    const medir = () => {
      const r = sec.getBoundingClientRect();
      alvo = c(-r.top / (r.height - innerHeight));
      ativo = r.top < innerHeight && r.bottom > 0;
      if (ativo && !raf) raf = requestAnimationFrame(quadro);
    };
    function quadro() {
      atual += (alvo - atual) * .14;
      if (Math.abs(alvo - atual) < .0005) atual = alvo;
      pintar(atual);
      raf = ativo && atual !== alvo ? requestAnimationFrame(quadro) : 0;
    }
    addEventListener('scroll', medir, { passive: true });
    addEventListener('resize', medir);
    pintar(0);
    medir();
  }
</script>
