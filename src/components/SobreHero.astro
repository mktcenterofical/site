---
// Primeira seção da página Quem somos, no estilo do hero da home.
// Esquerda: título e a história (desde 2013). Direita: "linha da evolução" animada — anéis orbitais
// com as fases da MKT (lojas → sites → redes → vídeos → design → IA) girando em volta de um núcleo de IA.
import { waLink } from '../config';
import Icon from './Icon.astro';
const fases = [
  { ano: '2013', t: 'Lojas virtuais', i: 'cart' },
  { ano: '', t: 'Sites institucionais', i: 'globe' },
  { ano: '', t: 'Redes sociais', i: 'message' },
  { ano: '', t: 'Edição de vídeos', i: 'video' },
  { ano: '', t: 'Web design', i: 'star' },
  { ano: 'Hoje', t: 'IA, apps e sistemas', i: 'smartphone' },
];
---
<section class="sb" id="historia">
  <div class="wrap sb-in">
    <div class="sb-txt">
      <span class="eyebrow">Quem somos</span>
      <h1 class="sb-h1">
        <span>Evoluindo</span>
        <span class="sb-or">desde 2013.</span>
      </h1>
      <p class="sb-lead">Há mais de 10 anos evoluímos junto com a tecnologia. A MKT Center nasceu em 2013 criando <b>lojas virtuais</b>, quando o e-commerce no Brasil ainda engatinhava, mas já mostrava uma força gigantesca.</p>
      <p class="sb-lead">A cada nova fase da tecnologia, buscamos capacitação e conhecimento: vieram os <b>sites institucionais</b>, as <b>redes sociais</b>, a <b>edição de vídeos</b> e o <b>web design</b>. Hoje somos especialistas em desenvolvimento web em várias frentes e usamos <b>inteligência artificial</b> para criar de sites a aplicativos e sistemas complexos.</p>
      <div class="acoes">
        <a class="btn btn-primary" href={waLink('Olá! Conheci a história da MKT Center e quero conversar sobre um projeto.')} target="_blank" rel="noopener">Quero conversar</a>
        <a class="btn sb-ghost" href="/portfolio/">Ver portfólio</a>
      </div>
      <ul class="sb-stats">
        <li><b>2013</b><small>ano de fundação</small></li>
        <li><b>10+</b><small>anos no digital</small></li>
        <li><b>IA</b><small>no dia a dia</small></li>
      </ul>
    </div>

    <div class="sb-arte" aria-hidden="true">
      <div class="sb-luz"></div>
      <div class="sb-anel a1"></div><div class="sb-anel a2"></div><div class="sb-anel a3"></div>
      <svg class="sb-raios" viewBox="0 0 400 400">
        {fases.map((_, k) => { const a = (k / fases.length) * Math.PI * 2 - Math.PI / 2; return <line x1="200" y1="200" x2={(200 + Math.cos(a) * 160).toFixed(1)} y2={(200 + Math.sin(a) * 160).toFixed(1)} />; })}
      </svg>
      <div class="sb-orbita">
        {fases.map((f, k) => (
          <div class="sb-no" style={`--k:${k};--n:${fases.length}`} data-k={k}>
            <div class="sb-no-in">
              <span class="sb-ic"><Icon name={f.i} size={20} /></span>
              <b>{f.t}</b>{f.ano && <em>{f.ano}</em>}
            </div>
          </div>
        ))}
      </div>
      <div class="sb-nucleo">
        <span class="sb-pulso"></span><span class="sb-pulso p2"></span>
        <div class="sb-chip">
          <svg viewBox="0 0 64 64"><g fill="none" stroke="#ffb35c" stroke-width="2.4" stroke-linecap="round">{[16, 26, 38, 48].map((v) => <><path d={`M${v} 8v8M${v} 48v8M8 ${v}h8M48 ${v}h8`} /></>)}</g><rect x="16" y="16" width="32" height="32" rx="7" fill="#141006" stroke="#ff8a24" stroke-width="2.4" /><text x="32" y="38" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="800" font-size="17" fill="#ffb35c">IA</text></svg>
        </div>
      </div>
      <div class="sb-fase"><small>Fase</small><b class="sb-fase-t">Lojas virtuais</b></div>
    </div>
  </div>
</section>

<style>
  .sb{padding:40px 0 48px}
  .sb-in{display:grid;gap:40px;align-items:center}
  @media(min-width:1024px){.sb-in{grid-template-columns:1fr 1fr;gap:48px}}
  .sb-h1{display:flex;flex-direction:column;font-size:clamp(42px,5vw,72px);line-height:.92;letter-spacing:-.02em;margin:0}
  .sb-or{background:linear-gradient(180deg,#ff8a24,#ff6900);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .sb-lead{color:#aeb4bd;font-size:17px;line-height:1.6;max-width:56ch;margin-top:18px}
  .sb-lead b{color:#fff;font-weight:600}
  .sb-ghost{border-color:#5b616b;color:#fff;background:transparent}
  .sb-ghost:hover{border-color:#fff}
  .sb-stats{list-style:none;display:flex;gap:32px;margin:32px 0 0;padding:0}
  .sb-stats b{display:block;font-family:var(--ff-tit);font-weight:800;font-size:38px;line-height:1;color:#fff}
  .sb-stats small{color:#aeb4bd;font-size:13px}

  /* ---------- órbita da evolução ---------- */
  .sb-arte{position:relative;width:min(100%,520px);aspect-ratio:1;margin:0 auto 56px;container-type:inline-size}
  .sb-luz{position:absolute;inset:18%;border-radius:50%;background:radial-gradient(closest-side,rgba(255,105,0,.35),transparent);filter:blur(10px)}
  .sb-anel{position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.08)}
  .sb-anel.a1{inset:8%;border-style:dashed;border-color:rgba(255,138,36,.25);animation:sb-gira 60s linear infinite}
  .sb-anel.a2{inset:24%;border-color:rgba(255,255,255,.06)}
  .sb-anel.a3{inset:36%;border-color:rgba(255,138,36,.35);box-shadow:0 0 30px -6px rgba(255,105,0,.6) inset}
  .sb-raios{position:absolute;inset:0;width:100%;height:100%}
  .sb-raios line{stroke:rgba(255,138,36,.22);stroke-width:1;stroke-dasharray:3 5;animation:sb-traco 2s linear infinite}
  @keyframes sb-traco{to{stroke-dashoffset:-16}}
  .sb-orbita{position:absolute;inset:0;animation:sb-gira 48s linear infinite}
  @keyframes sb-gira{to{transform:rotate(360deg)}}
  .sb-no{position:absolute;left:50%;top:50%;width:0;height:0;transform:rotate(calc(360deg / var(--n) * var(--k))) translateY(-40cqw)}
  .sb-no-in{position:absolute;left:0;top:0;transform:translate(-50%,-50%) rotate(calc(-360deg / var(--n) * var(--k)));animation:sb-contra 48s linear infinite;display:flex;flex-direction:column;align-items:center;gap:1cqw;width:24cqw;text-align:center}
  @keyframes sb-contra{to{rotate:-360deg}}
  .sb-ic{display:grid;place-items:center;width:11cqw;height:11cqw;border-radius:3cqw;color:#ffb35c;
    background:linear-gradient(150deg,rgba(255,255,255,.18),rgba(255,255,255,.04) 50%,rgba(255,138,36,.15));border:1px solid rgba(255,255,255,.25);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.4),0 0 18px -4px rgba(255,105,0,.6);transition:transform .4s,box-shadow .4s,background .4s}
  .sb-no-in b{font-size:clamp(10px,2.6cqw,13px);font-weight:700;color:#c3c8cf;line-height:1.15;transition:color .4s}
  .sb-no-in em{font-style:normal;font-family:var(--ff-tit);font-weight:800;font-size:clamp(12px,3.2cqw,16px);color:#ff8a24}
  .sb-no.on .sb-ic{transform:scale(1.18);background:linear-gradient(150deg,#ffb35c,#ff6900);color:#141006;box-shadow:0 0 30px rgba(255,105,0,.9)}
  .sb-no.on b{color:#fff}

  .sb-nucleo{position:absolute;left:50%;top:50%;width:22cqw;height:22cqw;transform:translate(-50%,-50%)}
  .sb-chip{position:relative;width:100%;height:100%;filter:drop-shadow(0 0 18px rgba(255,105,0,.8));animation:sb-bate 2.4s ease-in-out infinite}
  .sb-chip svg{width:100%;height:100%}
  @keyframes sb-bate{50%{transform:scale(1.06)}}
  .sb-pulso{position:absolute;inset:0;border-radius:50%;border:2px solid #ff8a24;opacity:0;animation:sb-pulso 3s ease-out infinite}
  .sb-pulso.p2{animation-delay:1.5s}
  @keyframes sb-pulso{0%{transform:scale(.6);opacity:.9}100%{transform:scale(2.2);opacity:0}}

  .sb-fase{position:absolute;left:50%;bottom:-13%;transform:translateX(-50%);display:flex;align-items:center;gap:10px;padding:8px 16px;border-radius:999px;background:rgba(17,19,23,.9);border:1px solid rgba(255,255,255,.12);white-space:nowrap}
  .sb-fase small{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8a9099}
  .sb-fase b{font-size:14px;color:#ffb35c}

  @media(max-width:1023px){
    .sb-txt{display:flex;flex-direction:column;align-items:center;text-align:center}
    .sb-h1{align-items:center}
    .sb-lead{margin-inline:auto}
    .sb .acoes,.sb-stats{justify-content:center}
  }
  @media(max-width:767px){.sb-h1{font-size:40px}.sb-stats{gap:20px}}
  @media (prefers-reduced-motion: reduce){.sb-orbita,.sb-no-in,.sb-anel,.sb-raios line,.sb-chip,.sb-pulso{animation:none}}
</style>

<script>
  // destaca uma fase por vez, em ordem (da origem em 2013 até a IA de hoje)
  const raiz = document.getElementById('historia');
  if (raiz) {
    const nos = Array.from(raiz.querySelectorAll<HTMLElement>('.sb-no'));
    const rotulo = raiz.querySelector<HTMLElement>('.sb-fase-t')!;
    let k = 0;
    const marcar = () => {
      nos.forEach((n, j) => n.classList.toggle('on', j === k));
      rotulo.textContent = nos[k].querySelector('b')?.textContent || '';
      k = (k + 1) % nos.length;
    };
    marcar();
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(marcar, 1800);
  }
</script>
