---
// Primeira seção da página Quem somos — mesmo modelo do hero da home.
// Esquerda: título curto + história + botões + números. Direita: "evolução visual" de 2013 até hoje:
// um aparelho que muda de forma a cada era (monitor antigo → notebook → celular → tablet → monitor atual)
// e mostra um site/app no estilo visual daquela época. Linha do tempo clicável embaixo. ?era=0..4 abre numa era.
import { waLink } from '../config';
const eras = [
  { id: 'e2013', ano: '2013', nome: 'Lojas virtuais' },
  { id: 'e2016', ano: '2016', nome: 'Sites institucionais' },
  { id: 'e2019', ano: '2019', nome: 'Redes sociais' },
  { id: 'e2022', ano: '2022', nome: 'Vídeos e design' },
  { id: 'hoje', ano: 'Hoje', nome: 'IA, apps e sistemas' },
];
---
<section class="sb" id="historia" data-eras={JSON.stringify(eras.map((e) => [e.id, e.nome]))}>
  <div class="wrap sb-in">
    <div class="sb-txt">
      <span class="eyebrow sb-ey sb-r">Quem somos</span>
      <h1 class="sb-h1"><span class="sb-line"><span class="sb-w">Evoluindo</span></span><span class="sb-line"><span class="sb-w sb-or">desde</span> <span class="sb-w sb-or">2013.</span></span></h1>
      <p class="sb-lead sb-r">Há mais de 10 anos evoluímos junto com a tecnologia. A MKT Center nasceu em 2013 criando <b>lojas virtuais</b>, quando o e-commerce no Brasil ainda engatinhava, mas já mostrava uma força gigantesca.</p>
      <p class="sb-lead sb-r">A cada nova fase, buscamos capacitação: vieram os <b>sites institucionais</b>, as <b>redes sociais</b>, a <b>edição de vídeos</b> e o <b>web design</b>. Hoje usamos <b>inteligência artificial</b> para criar de sites a aplicativos e sistemas complexos.</p>
      <div class="acoes sb-r">
        <a class="btn btn-primary" href={waLink('Olá! Conheci a história da MKT Center e quero conversar sobre um projeto.')} target="_blank" rel="noopener">Quero conversar</a>
        <a class="btn sb-ghost" href="/portfolio/">Ver portfólio</a>
      </div>
      <ul class="sb-stats sb-r">
        <li><b>2013</b><small>ano de fundação</small></li>
        <li><b>10+</b><small>anos no digital</small></li>
        <li><b>IA</b><small>no dia a dia</small></li>
      </ul>
    </div>

    <div class="ev" data-era="e2013">
      <div class="ev-palco" aria-hidden="true">
        <div class="ev-luz"></div>
        <div class="ev-dev">
          <div class="ev-tela">
            <div class="ev-c c2013">
              <div class="o-top"><b>MegaShop</b><span>Busca: <i></i> <u>OK</u></span></div>
              <div class="o-menu"><a>Home</a><a>Produtos</a><a>Promoções</a><a>Contato</a></div>
              <div class="o-marq"><span>FRETE GRÁTIS acima de R$ 99!!! Parcele em até 12x sem juros!!!</span></div>
              <div class="o-grid">
                {['pao', 'bolo', 'croissant'].map((p) => <div><img src={`/mock/${p}.webp`} alt="" width="320" height="220" decoding="async" /><a>Produto</a><b>R$ 29,90</b><u>Comprar</u></div>)}
              </div>
              <div class="o-rod">© 2013 · Melhor visualizado em 1024x768</div>
            </div>
            <div class="ev-c c2016">
              <div class="f-nav"><b>Pão Dourado</b><span>Início</span><span>Sobre</span><span>Contato</span></div>
              <div class="f-hero"><img src="/mock/padaria.webp" alt="" width="640" height="400" decoding="async" /><div><strong>Tradição em cada pão</strong><em>Saiba mais</em></div></div>
              <div class="f-cols"><div><i></i><span></span><span></span></div><div><i></i><span></span><span></span></div><div><i></i><span></span><span></span></div></div>
            </div>
            <div class="ev-c c2019">
              <div class="s-top"><b>suaempresa</b><span>♡ ✈</span></div>
              <div class="s-stories">{[1, 2, 3, 4].map(() => <i></i>)}</div>
              <div class="s-post"><div class="s-autor"><i></i><b>suaempresa</b></div><img src="/mock/croissant.webp" alt="" width="320" height="220" decoding="async" /><div class="s-acoes">♥ 1.284 curtidas</div></div>
            </div>
            <div class="ev-c c2022">
              <div class="v-player"><img src="/mock/cafe.webp" alt="" width="480" height="240" decoding="async" /><span class="v-play">▶</span><b class="v-leg">Café da manhã -20%</b></div>
              <div class="v-trilhas"><div class="v-t t1"><i></i><i></i><i></i></div><div class="v-t t2"><i></i><i></i></div><div class="v-t t3"><i></i></div><span class="v-cab"></span></div>
            </div>
            <div class="ev-c choje">
              <aside class="h-side"><b>◆ Gestão IA</b><span class="on">Painel</span><span>Pedidos</span><span>Clientes</span><span>Assistente</span></aside>
              <div class="h-main">
                <div class="h-kpis"><div><small>Vendas</small><b>R$ 48k</b></div><div><small>Leads</small><b>312</b></div><div><small>Conversão</small><b>6,4%</b></div></div>
                <div class="h-ia"><span class="h-bot">IA</span><p class="h-dig">Criei 3 campanhas e um relatório da semana.</p></div>
                <div class="h-graf">{[30, 45, 38, 60, 55, 78, 92].map((v) => <i style={`height:${v}%`}></i>)}</div>
              </div>
            </div>
            <span class="ev-brilho"></span>
          </div>
          <div class="ev-pe"></div><div class="ev-base"></div><div class="ev-teclado"></div>
        </div>
        <div class="ev-selo"><small>Era</small><b class="ev-selo-t">2013 · Lojas virtuais</b></div>
      </div>
      <div class="ev-linha" role="tablist" aria-label="Linha do tempo">
        <span class="ev-trilho"><i class="ev-progresso"></i></span>
        {eras.map((e, i) => (
          <button type="button" role="tab" data-i={i} class={i === 0 ? 'on' : ''}><span class="ev-ponto"></span><b>{e.ano}</b><small>{e.nome}</small></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .sb{padding:56px 0 48px}
  .sb-in{display:grid;gap:40px;align-items:center}
  @media(min-width:1024px){.sb-in{grid-template-columns:1fr 1.15fr;gap:32px}}
  .sb-ey{font-size:12px;letter-spacing:.14em}
  .sb-h1{display:flex;flex-direction:column;font-size:clamp(46px,5.6vw,76px);line-height:.9;letter-spacing:-.02em;margin:0}
  .sb-line{display:block;overflow:hidden;padding-bottom:.04em}
  .sb-w{display:inline-block}
  .sb-or{background:linear-gradient(180deg,#ff8a24,#ff6900);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .sb-lead{color:#aeb4bd;font-size:18px;line-height:28px;max-width:52ch;margin-top:20px}
  .sb-lead b{color:#fff;font-weight:600}
  .sb-ghost{border-color:#5b616b;color:#fff;background:transparent}
  .sb-ghost:hover{border-color:#fff}
  .sb-stats{list-style:none;display:flex;gap:28px;margin:40px 0 0;padding:0;flex-wrap:wrap}
  .sb-stats b{display:block;font-family:var(--ff-tit);font-weight:800;font-size:40px;line-height:1;color:#fff}
  .sb-stats small{color:#aeb4bd;font-size:14px}

  .ev{display:flex;flex-direction:column;align-items:center;width:100%}
  .ev-palco{position:relative;width:min(100%,600px);aspect-ratio:1/.78;perspective:1400px;container-type:inline-size}
  .ev-luz{position:absolute;left:12%;right:12%;top:12%;bottom:6%;border-radius:50%;background:radial-gradient(closest-side,rgba(255,105,0,.3),transparent);filter:blur(12px)}
  .ev-dev{--ease:cubic-bezier(.7,0,.2,1);position:absolute;left:calc((100% - var(--w)) / 2);top:var(--t);width:var(--w);height:var(--h);transform:rotateY(-8deg) rotateX(3deg);
    transition:left .9s var(--ease),top .9s var(--ease),width .9s var(--ease),height .9s var(--ease)}
  .ev-tela{position:absolute;inset:0;overflow:hidden;border-radius:var(--r);border:var(--borda) solid var(--moldura);background:#fff;
    box-shadow:0 0 0 1px rgba(255,255,255,.08),0 4cqw 8cqw -2cqw rgba(0,0,0,.9),0 0 6cqw -2cqw rgba(255,105,0,.45);
    transition:border-radius .9s var(--ease),border-width .9s var(--ease),border-color .9s}
  .ev-brilho{position:absolute;inset:0;pointer-events:none;background:linear-gradient(118deg,rgba(255,255,255,.14),rgba(255,255,255,0) 38%)}
  .ev-pe,.ev-base,.ev-teclado{position:absolute;left:50%;transform:translateX(-50%);opacity:0;transition:opacity .4s}
  .ev-pe{top:100%;width:16%;height:10cqw;background:linear-gradient(90deg,#7a7e85,#d9dce0 50%,#7a7e85);clip-path:polygon(25% 0,75% 0,90% 100%,10% 100%)}
  .ev-base{top:calc(100% + 10cqw);width:36%;height:1.6cqw;border-radius:1cqw 1cqw 2cqw 2cqw;background:linear-gradient(180deg,#e4e6ea,#8d9198)}
  .ev-teclado{top:100%;width:116%;height:2.6cqw;border-radius:.4cqw .4cqw 2cqw 2cqw;background:linear-gradient(180deg,#9a9ea5,#3a3d44)}

  .ev[data-era="e2013"] .ev-dev{--w:66%;--h:58%;--t:6%;--r:1.4cqw;--borda:3.4cqw;--moldura:#d8d2c2}
  .ev[data-era="e2013"] .ev-pe{opacity:1;background:linear-gradient(90deg,#b9b2a0,#e8e2d2 50%,#b9b2a0)}
  .ev[data-era="e2013"] .ev-base{opacity:1;background:linear-gradient(180deg,#e8e2d2,#a8a190)}
  .ev[data-era="e2016"] .ev-dev{--w:80%;--h:56%;--t:14%;--r:1.4cqw;--borda:1.2cqw;--moldura:#1b1c20}
  .ev[data-era="e2016"] .ev-teclado{opacity:1}
  .ev[data-era="e2019"] .ev-dev{--w:30%;--h:92%;--t:2%;--r:5cqw;--borda:1.2cqw;--moldura:#111214}
  .ev[data-era="e2022"] .ev-dev{--w:56%;--h:86%;--t:4%;--r:3cqw;--borda:1.6cqw;--moldura:#141518}
  .ev[data-era="hoje"] .ev-dev{--w:88%;--h:62%;--t:4%;--r:1.4cqw;--borda:.9cqw;--moldura:#0c0d10}
  .ev[data-era="hoje"] .ev-pe,.ev[data-era="hoje"] .ev-base{opacity:1}

  .ev-c{position:absolute;inset:0;opacity:0;transform:scale(.97);transition:opacity .5s,transform .5s;display:flex;flex-direction:column;text-align:left;overflow:hidden}
  .ev[data-era="e2013"] .c2013,.ev[data-era="e2016"] .c2016,.ev[data-era="e2019"] .c2019,.ev[data-era="e2022"] .c2022,.ev[data-era="hoje"] .choje{opacity:1;transform:none;transition-delay:.55s}
  .ev-c img{display:block;width:100%;height:100%;object-fit:cover}

  .c2013{background:#f2f2f2;font-family:Verdana,Tahoma,sans-serif;font-size:1.55cqw;color:#222}
  .o-top{display:flex;justify-content:space-between;align-items:center;padding:1cqw 1.6cqw;background:linear-gradient(180deg,#4f7fc0,#1f4f96);color:#fff}
  .o-top b{font-family:'Comic Sans MS','Trebuchet MS',sans-serif;font-size:2.6cqw;text-shadow:1px 1px 0 #000}
  .o-top i{display:inline-block;width:10cqw;height:2cqw;background:#fff;border:1px inset #999;vertical-align:middle}
  .o-top u{text-decoration:none;padding:0 .8cqw;background:linear-gradient(#eee,#bbb);color:#000;border:1px outset #ccc}
  .o-menu{display:flex;gap:2cqw;padding:.6cqw 1.6cqw;background:#dcdcdc;border-bottom:1px solid #999}
  .o-menu a{color:#00c;text-decoration:underline}
  .o-marq{overflow:hidden;white-space:nowrap;background:#ffff99;color:#c00;font-weight:bold;padding:.4cqw 0}
  .o-marq span{display:inline-block;padding-left:100%;animation:ev-marq 8s linear infinite}
  @keyframes ev-marq{to{transform:translateX(-100%)}}
  .o-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2cqw;padding:1.4cqw 1.6cqw;flex:1;min-height:0}
  .o-grid div{display:flex;flex-direction:column;gap:.4cqw;padding:.6cqw;background:#fff;border:1px solid #bbb;min-height:0}
  .o-grid img{flex:1;min-height:0;border:1px solid #999}
  .o-grid a{color:#00c;text-decoration:underline}
  .o-grid b{color:#c00}
  .o-grid u{text-decoration:none;text-align:center;background:linear-gradient(#ffb347,#e67e00);border:1px outset #f90;color:#fff;font-weight:bold}
  .o-rod{padding:.5cqw 1.6cqw;font-size:1.2cqw;color:#666;background:#dcdcdc}

  .c2016{background:#fff;color:#2d3436;font-family:var(--ff-txt);font-size:1.6cqw}
  .f-nav{display:flex;align-items:center;gap:2.4cqw;padding:1.4cqw 2.4cqw}
  .f-nav b{margin-right:auto;font-size:2.2cqw;color:#e17055}
  .f-hero{position:relative;height:52%;flex:none}
  .f-hero div{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:1.4cqw;background:rgba(0,0,0,.42);color:#fff}
  .f-hero strong{font-size:3.6cqw;font-weight:300;letter-spacing:.05em}
  .f-hero em{font-style:normal;padding:.8cqw 2.6cqw;background:#e17055;font-size:1.5cqw;text-transform:uppercase;letter-spacing:.1em}
  .f-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:2.4cqw;padding:2.4cqw}
  .f-cols div{display:flex;flex-direction:column;align-items:center;gap:.8cqw}
  .f-cols i{width:5cqw;height:5cqw;border-radius:50%;background:#e17055}
  .f-cols span{height:.9cqw;width:80%;background:#dfe6e9}

  .c2019{background:#fff;color:#262626;font-family:var(--ff-txt);font-size:2.3cqw}
  .s-top{display:flex;justify-content:space-between;padding:4cqw 2.6cqw 1.6cqw;font-size:2.6cqw}
  .s-stories{display:flex;gap:1.6cqw;padding:0 2.6cqw 2cqw;border-bottom:1px solid #eee}
  .s-stories i{width:6.4cqw;height:6.4cqw;border-radius:50%;background:conic-gradient(#feda75,#fa7e1e,#d62976,#962fbf,#feda75);box-shadow:inset 0 0 0 .5cqw #fff}
  .s-autor{display:flex;align-items:center;gap:1.4cqw;padding:1.6cqw 2.6cqw}
  .s-autor i{width:4.4cqw;height:4.4cqw;border-radius:50%;background:#ff6900}
  .s-post{flex:1;display:flex;flex-direction:column;min-height:0}
  .s-post img{flex:1;min-height:0}
  .s-acoes{padding:1.6cqw 2.6cqw;font-weight:700}

  .c2022{background:#141518;color:#fff;font-family:var(--ff-txt);font-size:2cqw;padding:2.4cqw;gap:2cqw}
  .v-player{position:relative;flex:1;min-height:0;border-radius:1.4cqw;overflow:hidden}
  .v-play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:8cqw;height:8cqw;border-radius:50%;display:grid;place-items:center;background:rgba(255,105,0,.9);color:#141006;font-size:3cqw}
  .v-leg{position:absolute;left:0;right:0;bottom:2cqw;text-align:center;font-family:var(--ff-tit);text-transform:uppercase;font-size:3.6cqw;text-shadow:0 2px 8px #000}
  .v-trilhas{position:relative;display:grid;gap:1cqw;padding:1.4cqw;border-radius:1.2cqw;background:#0c0d10}
  .v-t{display:flex;gap:.6cqw;height:3cqw}
  .v-t i{flex:1;border-radius:.4cqw;background:#3a3d44}
  .v-t.t1 i{background:linear-gradient(90deg,#ff6900,#ffb35c)}
  .v-t.t2 i{background:#3d7cff}
  .v-t.t3 i{background:#3ddc97;flex:.6}
  .v-cab{position:absolute;top:0;bottom:0;left:30%;width:2px;background:#fff;box-shadow:0 0 6px #fff;animation:ev-cab 3s linear infinite}
  @keyframes ev-cab{from{left:4%}to{left:96%}}

  .choje{flex-direction:row;background:#0d0e11;color:#fff;font-family:var(--ff-txt);font-size:1.4cqw}
  .h-side{width:20%;display:flex;flex-direction:column;gap:.8cqw;padding:1.6cqw 1.2cqw;background:#111317;color:#8a9099}
  .h-side b{color:#ff8a24;margin-bottom:1cqw}
  .h-side span{padding:.5cqw .8cqw;border-radius:.6cqw}
  .h-side .on{background:rgba(255,105,0,.15);color:#fff}
  .h-main{flex:1;display:flex;flex-direction:column;gap:1.4cqw;padding:1.6cqw}
  .h-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:1cqw}
  .h-kpis div{padding:1cqw;border-radius:1cqw;background:#16181c;border:1px solid #23262c}
  .h-kpis small{display:block;color:#8a9099}
  .h-kpis b{font-family:var(--ff-tit);font-size:2.6cqw}
  .h-ia{display:flex;gap:1cqw;align-items:center;padding:1.2cqw;border-radius:1cqw;background:linear-gradient(90deg,rgba(255,105,0,.18),rgba(255,105,0,.04));border:1px solid rgba(255,138,36,.4)}
  .h-bot{flex:none;display:grid;place-items:center;width:3.4cqw;height:3.4cqw;border-radius:50%;background:#ff6900;color:#141006;font-weight:800;font-size:1.3cqw}
  .h-dig{margin:0;overflow:hidden;white-space:nowrap;border-right:2px solid #ff8a24;max-width:0}
  .ev[data-era="hoje"] .h-dig{animation:ev-dig 2.4s steps(42) .9s forwards}
  @keyframes ev-dig{to{max-width:100%}}
  .h-graf{flex:1;display:flex;align-items:flex-end;gap:1cqw;min-height:0;padding:1cqw;border-radius:1cqw;background:#111317}
  .h-graf i{flex:1;border-radius:.4cqw .4cqw 0 0;background:linear-gradient(180deg,#ffb35c,#ff6900);box-shadow:0 0 1.2cqw rgba(255,105,0,.5)}

  .ev-selo{position:absolute;left:0;bottom:0;display:flex;flex-direction:column;padding:1.4cqw 2.2cqw;border-radius:1.6cqw;background:rgba(17,19,23,.92);border:1px solid rgba(255,255,255,.12);box-shadow:0 2cqw 4cqw -1cqw rgba(0,0,0,.8);text-align:left}
  .ev-selo small{font-size:max(10px,1.6cqw);letter-spacing:.14em;text-transform:uppercase;color:#8a9099}
  .ev-selo b{font-size:max(12px,2.2cqw);color:#ffb35c}

  .ev-linha{position:relative;display:grid;grid-template-columns:repeat(5,1fr);width:min(100%,600px);margin-top:28px}
  .ev-trilho{position:absolute;left:10%;right:10%;top:7px;height:2px;background:rgba(255,255,255,.1);border-radius:2px}
  .ev-progresso{display:block;height:100%;width:0;border-radius:inherit;background:linear-gradient(90deg,#ff6900,#ffb35c);box-shadow:0 0 8px #ff6900;transition:width .9s cubic-bezier(.7,0,.2,1)}
  .ev-linha button{position:relative;display:flex;flex-direction:column;align-items:center;gap:6px;background:none;border:0;color:#8a9099;font:inherit;cursor:pointer;padding:0 2px}
  .ev-ponto{width:16px;height:16px;border-radius:50%;background:#16181c;border:2px solid #3a3d44;transition:all .3s}
  .ev-linha b{font-family:var(--ff-tit);font-size:18px;line-height:1;color:#c3c8cf}
  .ev-linha small{font-size:11px;line-height:1.2;text-align:center}
  .ev-linha button.feito .ev-ponto{border-color:#ff6900;background:#ff6900}
  .ev-linha button.on .ev-ponto{border-color:#ffb35c;background:#ff6900;box-shadow:0 0 0 5px rgba(255,105,0,.2),0 0 14px #ff6900}
  .ev-linha button.on b{color:#ff8a24}
  .ev-linha button.on small{color:#fff}

  @media(max-width:1023px){
    .sb-txt{display:flex;flex-direction:column;align-items:center;text-align:center}
    .sb-h1{align-items:center}
    .sb-lead{margin-inline:auto}
    .sb .acoes,.sb-stats{justify-content:center}
  }
  @media(max-width:767px){
    .sb{padding:28px 0 32px}
    .sb-h1{font-size:46px}
    .sb-lead{font-size:16px;line-height:26px}
    .sb-stats{width:100%;gap:0;justify-content:space-between;margin-top:28px}
    .sb-stats li{flex:1;text-align:center}
    .sb-stats b{font-size:32px}
    .ev-linha small{display:none}
  }
  @media (prefers-reduced-motion: reduce){.ev-dev,.ev-tela,.ev-c,.ev-progresso{transition:none}.v-cab,.o-marq span{animation:none}}
</style>

<script>
  import { gsap } from 'gsap';
  // mesma entrada do hero da home: palavras sobem de dentro da linha, depois o resto aparece
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.timeline({ delay: .2 })
      .from('.sb-w', { yPercent: 110, duration: 1.1, stagger: .08, ease: 'expo.out' })
      .from('.sb-r', { y: 24, opacity: 0, duration: .9, stagger: .12, ease: 'power3.out' }, '-=.8')
      .from('.ev', { y: 60, opacity: 0, duration: 1.4, ease: 'expo.out' }, .3);
  }
  const sec = document.getElementById('historia');
  if (sec) {
    const ev = sec.querySelector<HTMLElement>('.ev')!;
    const eras: [string, string][] = JSON.parse(sec.dataset.eras!);
    const botoes = Array.from(sec.querySelectorAll<HTMLButtonElement>('.ev-linha button'));
    const prog = sec.querySelector<HTMLElement>('.ev-progresso')!;
    const selo = sec.querySelector<HTMLElement>('.ev-selo-t')!;
    let k = 0, timer: number | undefined;
    const ir = (i: number) => {
      k = i;
      ev.dataset.era = eras[i][0];
      botoes.forEach((b, j) => { b.classList.toggle('on', j === i); b.classList.toggle('feito', j < i); b.setAttribute('aria-selected', String(j === i)); });
      prog.style.width = `${(i / (eras.length - 1)) * 100}%`;
      selo.textContent = `${botoes[i].querySelector('b')!.textContent} · ${eras[i][1]}`;
    };
    const ciclo = () => { clearInterval(timer); if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = window.setInterval(() => ir((k + 1) % eras.length), 3600); };
    botoes.forEach((b) => b.addEventListener('click', () => { ir(Number(b.dataset.i)); ciclo(); }));
    const pedido = Number(new URLSearchParams(location.search).get('era'));
    ir(pedido >= 0 && pedido < eras.length ? pedido : 0); ciclo();
  }
</script>
