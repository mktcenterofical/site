---
import { servicos } from '../data/servicos';
import { waLink } from '../config';
const path = Astro.url.pathname;
const atual = (u: string) => (path === u ? 'page' : undefined);
const emServico = servicos.some((s) => path.startsWith(`/${s.slug}/`));
---
<header class="topo">
  <div class="wrap barra">
    <a href="/" class="logo" aria-label="MKT Center, página inicial">MKT<span>CENTER</span></a>
    <nav class="menu" aria-label="Principal">
      <a href="/" aria-current={atual('/')}>Início</a>
      <details class="drop">
        <summary class={emServico ? 'ativo' : ''}>Serviços</summary>
        <div class="dropbox">
          {servicos.map((s) => (
            <a href={`/${s.slug}/`} aria-current={atual(`/${s.slug}/`)}>{s.icone} {s.nome}</a>
          ))}
        </div>
      </details>
      <a href="/portfolio/" aria-current={atual('/portfolio/')}>Portfólio</a>
      <a href="/contato/" aria-current={atual('/contato/')}>Contato</a>
      <a href={waLink()} class="btn btn-primary cta" target="_blank" rel="noopener">Orçamento</a>
    </nav>
  </div>
</header>

<style>
  .topo{position:sticky;top:0;z-index:50;background:rgba(9,10,12,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--linha)}
  .barra{display:flex;align-items:center;justify-content:space-between;height:64px}
  .logo{font-family:var(--ff-tit);font-weight:800;font-size:1.6rem;text-decoration:none;letter-spacing:.02em}
  .logo span{color:var(--laranja);margin-left:4px}
  .menu{display:none;align-items:center;gap:24px}
  .menu > a,.drop summary{text-decoration:none;font-weight:600;color:var(--prata)}
  .menu > a:hover,.menu > a[aria-current],.drop summary.ativo,.drop summary:hover{color:var(--papel)}
  .menu > a[aria-current]{box-shadow:inset 0 -2px var(--laranja)}
  .menu .cta{color:var(--laranja-txt);padding:10px 18px}
  .drop{position:relative;border:0;padding:0}
  .drop summary::after{content:'▾';font-size:.8rem}
  .dropbox{position:absolute;top:36px;left:-16px;background:var(--grafite2);border:1px solid var(--linha);border-radius:12px;padding:8px;min-width:260px;display:grid}
  .dropbox a{padding:10px 12px;border-radius:8px;text-decoration:none}
  .dropbox a:hover,.dropbox a[aria-current]{background:var(--grafite)}
  @media(min-width:900px){.menu{display:flex}}
</style>
