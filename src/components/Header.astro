---
// Cabeçalho minimalista: logo, links em pílula (o ativo ganha contorno) e botão "Fale conosco".
// No celular: logo + botão que abre o menu off-canvas.
import Icon from './Icon.astro';
import { config, waLink } from '../config';
const path = Astro.url.pathname;
const atual = (u: string) => (path === u ? 'page' : undefined);
const links: [string, string, string][] = [
  ['/', 'Início', 'home'],
  ['/quem-somos/', 'Sobre', 'smile'],
  ['/portfolio/', 'Portfólio', 'folder'],
  ['/criacao-de-sites/', 'Sites', 'globe'],
  ['/loja-virtual/', 'Lojas', 'cart'],
  ['/aplicativos-e-sistemas/', 'Apps', 'smartphone'],
  ['/videos/', 'Vídeos', 'video'],
  ['/redes-sociais/', 'Redes', 'trending'],
  ['/marketing-politico/', 'Política', 'landmark'],
];
---
<header class="topo">
  <div class="wrap barra">
    <a href="/" class="logo" aria-label="MKT Center, página inicial">
      <img src="/logo-escuro.webp" alt="MKT Center Marketing Digital" width="201" height="32" fetchpriority="high" />
    </a>
    <nav class="menu" aria-label="Principal">
      {links.map(([u, n]) => <a href={u} aria-current={atual(u)}>{n}</a>)}
    </nav>
    <button class="tema" type="button" aria-label="Trocar para o tema escuro" title="Tema claro/escuro">
      <svg class="t-sol" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="t-lua" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
    <a href="/contato/" class="cta" aria-current={atual('/contato/')}>Fale conosco <span aria-hidden="true">↗</span></a>
    <button class="burger" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="gaveta">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- Menu off-canvas do celular -->
<div class="veu" hidden></div>
<aside id="gaveta" class="gaveta" aria-label="Menu" aria-hidden="true" inert>
  <div class="g-topo">
    <img src="/logo-escuro.webp" alt="MKT Center Marketing Digital" width="176" height="28" loading="lazy" />
    <button class="fechar" type="button" aria-label="Fechar menu">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
  </div>
  <nav class="g-nav" aria-label="Páginas">
    {links.map(([u, n, i]) => (
      <a href={u} aria-current={atual(u)}><span class="g-ic"><Icon name={i} size={18} /></span>{n}</a>
    ))}
    <a href="/contato/" aria-current={atual('/contato/')}><span class="g-ic"><Icon name="mail" size={18} /></span>Contato</a>
  </nav>
  <div class="g-base">
    <a class="btn btn-whatsapp" href={waLink()} target="_blank" rel="noopener">Falar no WhatsApp</a>
    <small>{config.telefone} · {config.horario}</small>
  </div>
</aside>

<style>
  .topo{position:sticky;top:0;z-index:50;background:rgba(9,10,12,.78);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,.06)}
  .barra{display:flex;align-items:center;justify-content:space-between;gap:24px;height:64px}
  .logo{flex:none;display:flex}
  .logo img{height:26px;width:auto}

  .menu{display:none;align-items:center;gap:4px}
  .menu a{padding:7px 16px;border-radius:999px;border:1px solid transparent;color:rgba(255,255,255,.62);font-size:14px;font-weight:500;text-decoration:none;white-space:nowrap;transition:color .2s,border-color .2s}
  .menu a:hover{color:#fff}
  .menu a[aria-current]{color:#fff;border-color:rgba(255,255,255,.35)}

  .tema{display:grid;place-items:center;width:40px;height:40px;flex:none;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:transparent;color:#fff;cursor:pointer;transition:border-color .2s,background .2s}
  .tema:hover{border-color:var(--orange);background:rgba(255,105,0,.12)}
  .t-lua{display:none}
  :global(html[data-theme="light"]) .t-sol{display:none}
  :global(html[data-theme="light"]) .t-lua{display:block}
  .cta{display:none;align-items:center;gap:6px;padding:9px 18px;border-radius:999px;background:linear-gradient(180deg,var(--orange-hot),var(--orange));color:var(--on-orange);box-shadow:var(--shadow-orange);font-size:14px;font-weight:700;text-decoration:none;white-space:nowrap;transition:background .2s,transform .2s}
  .cta:hover{filter:brightness(1.05);transform:translateY(-1px)}
  .cta span{font-size:13px}

  .burger{display:grid;gap:5px;place-content:center;width:44px;height:44px;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:transparent;cursor:pointer}
  .burger span{display:block;width:18px;height:1.5px;border-radius:2px;background:#fff}
  .burger span:nth-child(2){width:12px;justify-self:end}

  @media(min-width:900px){
    .barra{height:72px}
    .logo img{height:28px}
    .menu,.cta{display:flex}
    .burger{display:none}
  }
  @media(min-width:900px) and (max-width:1100px){.menu a{padding:7px 11px;font-size:13px}}

  /* gaveta */
  .veu{position:fixed;inset:0;z-index:90;background:rgba(0,0,0,.55);backdrop-filter:blur(3px);opacity:0;transition:opacity .3s}
  .veu.on{opacity:1}
  .gaveta{position:fixed;top:0;right:0;bottom:0;z-index:100;width:min(86vw,360px);display:flex;flex-direction:column;background:#090a0c;color:#fff;height:100dvh;padding:12px 16px calc(16px + env(safe-area-inset-bottom));overflow:hidden;overscroll-behavior:contain;transform:translateX(100%);transition:transform .35s cubic-bezier(.7,0,.2,1);box-shadow:-20px 0 60px rgba(0,0,0,.5)}
  .gaveta.on{transform:none}
  .g-topo{display:flex;align-items:center;justify-content:space-between;height:44px;margin-bottom:8px}
  .g-topo img{height:26px;width:auto}
  .fechar{width:44px;height:44px;border-radius:999px;border:1px solid rgba(255,255,255,.18);background:transparent;color:#fff;display:grid;place-items:center;cursor:pointer}
  .g-nav{display:grid;gap:2px}
  .g-nav a{display:flex;align-items:center;gap:12px;min-height:clamp(36px,5.6dvh,46px);padding:4px 10px;border-radius:999px;border:1px solid transparent;text-decoration:none;font-size:15px;font-weight:600;color:#c3c8cf}
  .g-nav a[aria-current]{border-color:rgba(255,255,255,.3);color:#fff}
  .g-ic{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:#16171b;color:var(--orange-hot);flex:none}
  .g-base{margin-top:auto;padding-top:12px;display:grid;gap:10px;text-align:center}
  .g-base small{color:#aeb4bd;font-size:13px}
  @media(min-width:900px){.veu,.gaveta{display:none}}
  @media (prefers-reduced-motion: reduce){.gaveta,.veu{transition:none}}
</style>

<script>
  // botão claro/escuro: guarda a escolha e troca o tema na hora
  document.querySelectorAll<HTMLButtonElement>('.tema').forEach((b) => b.addEventListener('click', () => {
    const claro = document.documentElement.dataset.theme !== 'light';
    document.documentElement.dataset.theme = claro ? 'light' : 'dark';
    try { localStorage.setItem('tema', claro ? 'light' : 'dark'); } catch {}
    document.querySelectorAll('.tema').forEach((x) => x.setAttribute('aria-label', claro ? 'Trocar para o tema escuro' : 'Trocar para o tema claro'));
  }));
  const btn = document.querySelector<HTMLButtonElement>('.burger')!;
  const gaveta = document.getElementById('gaveta')!;
  const veu = document.querySelector<HTMLElement>('.veu')!;
  const fechar = gaveta.querySelector<HTMLButtonElement>('.fechar')!;
  function abrir(on: boolean) {
    btn.setAttribute('aria-expanded', String(on));
    gaveta.setAttribute('aria-hidden', String(!on));
    gaveta.toggleAttribute('inert', !on);
    document.documentElement.style.overflow = on ? 'hidden' : '';
    if (on) { veu.hidden = false; requestAnimationFrame(() => { veu.classList.add('on'); gaveta.classList.add('on'); }); fechar.focus(); }
    else { veu.classList.remove('on'); gaveta.classList.remove('on'); setTimeout(() => (veu.hidden = true), 300); btn.focus(); }
  }
  btn.addEventListener('click', () => abrir(true));
  fechar.addEventListener('click', () => abrir(false));
  veu.addEventListener('click', () => abrir(false));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && gaveta.classList.contains('on')) abrir(false); });
  if (location.hash === '#menu') abrir(true);
</script>
