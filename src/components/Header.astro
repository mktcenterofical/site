---
import { waLink } from '../config';
const path = Astro.url.pathname;
const atual = (u: string) => (path === u ? 'page' : undefined);
---
<header class="topo">
  <div class="wrap barra">
    <a href="/" class="logo" aria-label="MKT Center, página inicial">
      <img src="/logo.webp" alt="MKT Marketing Digital" width="144" height="48" fetchpriority="high" />
    </a>
    <nav class="menu" aria-label="Principal">
      <a href="/" aria-current={atual('/')}>Início</a>
      <a href="/#servicos">Serviços</a>
      <a href="/portfolio/" aria-current={atual('/portfolio/')}>Portfólio</a>
      <a href="/contato/" aria-current={atual('/contato/')}>Contato</a>
      <a href={waLink()} class="btn btn-primary cta" target="_blank" rel="noopener">Orçamento</a>
    </nav>
  </div>
</header>

<style>
  .topo{position:sticky;top:0;z-index:50;background:rgba(9,10,12,.88);backdrop-filter:blur(10px);border-bottom:1px solid var(--linha)}
  .barra{display:flex;align-items:center;justify-content:space-between;height:68px}
  .logo img{height:48px;width:auto}
  .menu{display:none;align-items:center;gap:24px}
  .menu > a{text-decoration:none;font-weight:600;color:var(--prata)}
  .menu > a:hover,.menu > a[aria-current]{color:var(--papel)}
  .menu > a[aria-current]{box-shadow:inset 0 -2px var(--laranja)}
  .menu .cta{color:var(--laranja-txt);padding:10px 18px;box-shadow:none}
  @media(min-width:900px){.menu{display:flex}}
</style>
