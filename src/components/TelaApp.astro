---
// Tela fictícia de um aplicativo de delivery ("Sabor Já") usada no celular do hero.
const itens: [string, string, string][] = [
  ['burger', 'Burger da Casa', 'R$ 32,90'],
  ['pizza', 'Pizza Calabresa', 'R$ 54,90'],
];
---
<div class="app">
  <div class="app-status"><b>9:41</b><span class="app-isl"></span><i></i></div>
  <div class="app-top">
    <img src="/mock/pessoa1.webp" alt="" width="96" height="96" loading="lazy" decoding="async" />
    <div><small>Olá, Carla</small><b>Sabor Já</b></div>
    <span class="app-cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/></svg>
      <em class="lj-qtd">2</em>
    </span>
  </div>
  <div class="app-promo"><img src="/mock/cafe.webp" alt="" width="480" height="240" loading="lazy" decoding="async" /><b>Café da manhã<br />-20% hoje</b></div>
  <div class="app-chips"><span class="on">Lanches</span><span>Pizza</span><span>Doces</span></div>
  {itens.map(([img, n, p]) => (
    <div class="app-item"><img src={`/mock/${img}.webp`} alt="" width="160" height="160" loading="lazy" decoding="async" /><div><b>{n}</b><small>{p}</small></div><span class="app-add">+</span></div>
  ))}
  <div class="app-nav"><i class="on"></i><i></i><i></i><i></i></div>
  <div class="lj-toast"><span>✓</span>Pedido enviado</div>
</div>

<style>
  .app{position:absolute;inset:0;display:flex;flex-direction:column;gap:.7em;background:#f6f4f1;color:#17181c;font-size:7.2cqw;line-height:1.2;text-align:left;font-family:var(--ff-txt);overflow:hidden}
  .app img{display:block;width:100%;height:100%;object-fit:cover}
  .app-status{display:flex;align-items:center;justify-content:space-between;padding:.6em 1.1em 0;font-size:.75em}
  .app-isl{width:34%;height:1.5em;border-radius:99px;background:#0b0b0d}
  .app-status i{width:1.7em;height:.75em;border-radius:3px;border:1.5px solid #17181c}
  .app-top{display:flex;align-items:center;gap:.6em;padding:0 1.1em}
  .app-top img{width:2.4em;height:2.4em;border-radius:50%}
  .app-top div{flex:1}
  .app-top small{display:block;color:#6b6f76;font-size:.75em}
  .app-top b{font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:1.25em}
  .app-cart{position:relative;display:grid;place-items:center;width:2.3em;height:2.3em;border-radius:50%;background:#17181c;color:#fff}
  .app-cart svg{width:1.15em;height:1.15em}
  .app-cart em{position:absolute;top:-.35em;right:-.35em;min-width:1.4em;height:1.4em;border-radius:99px;background:#ff6900;color:#141006;font-style:normal;font-weight:800;font-size:.75em;display:grid;place-items:center}
  .app-promo{position:relative;margin:0 1.1em;height:24%;flex:none;border-radius:1em;overflow:hidden}
  .app-promo b{position:absolute;inset:auto 0 0 0;padding:2em .9em .7em;background:linear-gradient(transparent,rgba(0,0,0,.72));color:#fff;font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:1.15em;line-height:1}
  .app-chips{display:flex;gap:.45em;padding:0 1.1em}
  .app-chips span{border-radius:99px;padding:.35em .8em;background:#fff;font-weight:700;font-size:.8em}
  .app-chips span.on{background:#ff6900;color:#141006}
  .app-item{display:flex;align-items:center;gap:.6em;margin:0 1.1em;padding:.45em;border-radius:.9em;background:#fff;box-shadow:0 .2em .8em rgba(0,0,0,.06)}
  .app-item img{width:2.9em;height:2.9em;border-radius:.6em;flex:none}
  .app-item div{flex:1}
  .app-item b{display:block;font-weight:800;font-size:.85em}
  .app-item small{color:#a84300;font-weight:800;font-size:.8em}
  .app-add{display:grid;place-items:center;width:1.6em;height:1.6em;border-radius:50%;background:#ff6900;color:#141006;font-weight:800}
  .app-nav{margin-top:auto;display:flex;justify-content:space-around;padding:.9em 0 1.3em;background:#fff;border-top:1px solid #ece9e5}
  .app-nav i{width:1.3em;height:1.3em;border-radius:.4em;background:#d9d5d0}
  .app-nav i.on{background:#ff6900}
</style>
