---
// Versão celular com cara de app (só < 768px): barra fixa embaixo com Início, Serviços, WhatsApp (botão
// central em destaque), Portfólio e Menu. "Serviços" abre uma gaveta que sobe de baixo (bottom sheet) com os
// serviços em grade; "Menu" abre o menu lateral do Header. Respeita a área segura do iPhone (safe-area).
import Icon from './Icon.astro';
import { waLink } from '../config';
const caminho = Astro.url.pathname;
const ativo = (u: string) => (u === '/' ? caminho === '/' : caminho.startsWith(u));
const servicos: [string, string, string][] = [
  ['/criacao-de-sites/', 'Sites', 'globe'],
  ['/loja-virtual/', 'Lojas', 'cart'],
  ['/aplicativos-e-sistemas/', 'Apps', 'smartphone'],
  ['/videos/', 'Vídeos', 'video'],
  ['/redes-sociais/', 'Redes', 'trending'],
  ['/marketing-politico/', 'Política', 'landmark'],
];
const emServico = servicos.some(([u]) => ativo(u));
const wa = '<path d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.1-.5-.2-.7.1l-1 1.3c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.7 5 2.1.9 3 1 4 .8.7-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5l-.7-.4z"/>';
---
<nav class="ba" aria-label="Navegação do app">
  <a href="/" class:list={['ba-it', { on: ativo('/') }]}><Icon name="home" size={22} /><span>Início</span></a>
  <button type="button" class:list={['ba-it', { on: emServico }]} data-abre="servicos" aria-controls="ba-folha" aria-expanded="false"><Icon name="grid" size={22} /><span>Serviços</span></button>
  <a class="ba-wa" href={waLink()} target="_blank" rel="noopener" aria-label="Falar no WhatsApp">
    <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true" set:html={wa} />
  </a>
  <a href="/portfolio/" class:list={['ba-it', { on: ativo('/portfolio/') }]}><Icon name="folder" size={22} /><span>Portfólio</span></a>
  <button type="button" class="ba-it" data-abre="menu"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" /></svg><span>Menu</span></button>
</nav>

<div class="ba-veu" hidden></div>
<section id="ba-folha" class="ba-folha" aria-label="Serviços" aria-hidden="true" inert>
  <span class="ba-pega" aria-hidden="true"></span>
  <h2>O que você precisa?</h2>
  <div class="ba-grade">
    {servicos.map(([u, n, i]) => (
      <a href={u} class:list={{ on: ativo(u) }}><span class="ba-ic"><Icon name={i} size={22} /></span>{n}</a>
    ))}
  </div>
  <a class="btn btn-primary ba-cta" href="/contato/">Pedir orçamento</a>
</section>

<style>
  .ba,.ba-folha,.ba-veu{display:none}
  @media(max-width:767px){
    /* barra de abas fixa embaixo, como num app */
    .ba{position:fixed;left:0;right:0;bottom:0;z-index:80;display:grid;grid-template-columns:repeat(5,1fr);align-items:end;
      padding:6px 6px calc(6px + env(safe-area-inset-bottom));background:rgba(12,13,16,.92);
      -webkit-backdrop-filter:blur(16px);backdrop-filter:blur(16px);border-top:1px solid rgba(255,255,255,.08);transition:transform .3s}
    .ba-it{display:flex;flex-direction:column;align-items:center;gap:3px;min-height:48px;padding:6px 0 2px;border:0;background:none;color:#8a9099;
      font:600 10.5px var(--ff-txt);text-decoration:none;-webkit-tap-highlight-color:transparent;transition:color .2s,transform .15s}
    .ba-it:active{transform:scale(.92)}
    .ba-it.on{color:#ff8a24}
    .ba-it.on::after{content:'';width:4px;height:4px;margin-top:1px;border-radius:50%;background:#ff6900}
    .ba-wa{justify-self:center;display:grid;place-items:center;width:56px;height:56px;margin-top:-22px;border-radius:50%;background:#25d366;color:#04210f;
      box-shadow:0 0 0 5px #0c0d10,0 10px 24px rgba(37,211,102,.35);-webkit-tap-highlight-color:transparent;transition:transform .15s}
    .ba-wa:active{transform:scale(.92)}

    /* gaveta de serviços que sobe de baixo */
    .ba-veu{display:block;position:fixed;inset:0;z-index:85;background:rgba(0,0,0,.55);opacity:0;transition:opacity .3s}
    .ba-veu[hidden]{display:none}
    .ba-veu.on{opacity:1}
    .ba-folha{display:block;position:fixed;left:0;right:0;bottom:0;z-index:90;padding:10px 16px calc(20px + env(safe-area-inset-bottom));
      border-radius:22px 22px 0 0;background:#111317;border-top:1px solid rgba(255,255,255,.1);box-shadow:0 -20px 50px rgba(0,0,0,.6);
      transform:translateY(105%);visibility:hidden;transition:transform .35s cubic-bezier(.22,.8,.28,1),visibility 0s .35s;touch-action:pan-y}
    .ba-folha.on{transform:none;visibility:visible;transition:transform .35s cubic-bezier(.22,.8,.28,1)}
    .ba-pega{display:block;width:44px;height:5px;margin:0 auto 14px;border-radius:99px;background:rgba(255,255,255,.2)}
    .ba-folha h2{margin:0 0 14px;font-size:22px;text-align:center}
    .ba-grade{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
    .ba-grade a{display:flex;flex-direction:column;align-items:center;gap:8px;padding:14px 6px;border-radius:16px;background:#16181d;border:1px solid rgba(255,255,255,.07);
      color:#e4e6ea;font:600 13px var(--ff-txt);text-decoration:none;-webkit-tap-highlight-color:transparent;transition:transform .15s,border-color .2s}
    .ba-grade a:active{transform:scale(.95)}
    .ba-grade a.on{border-color:rgba(255,105,0,.6)}
    .ba-ic{display:grid;place-items:center;width:44px;height:44px;border-radius:14px;background:rgba(255,105,0,.14);color:#ff8a24}
    .ba-cta{display:flex;width:100%;margin-top:14px}
  }
</style>

<script>
  const folha = document.getElementById('ba-folha');
  const veu = document.querySelector<HTMLElement>('.ba-veu');
  const btServ = document.querySelector<HTMLButtonElement>('.ba [data-abre="servicos"]');
  if (folha && veu && btServ) {
    const abrir = (on: boolean) => {
      btServ.setAttribute('aria-expanded', String(on));
      folha.setAttribute('aria-hidden', String(!on));
      folha.toggleAttribute('inert', !on);
      document.documentElement.style.overflow = on ? 'hidden' : '';
      if (on) { veu.hidden = false; requestAnimationFrame(() => { veu.classList.add('on'); folha.classList.add('on'); }); }
      else { veu.classList.remove('on'); folha.classList.remove('on'); setTimeout(() => (veu.hidden = true), 300); }
    };
    btServ.addEventListener('click', () => abrir(!folha.classList.contains('on')));
    veu.addEventListener('click', () => abrir(false));
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && folha.classList.contains('on')) abrir(false); });
    // arrastar a gaveta para baixo fecha
    let y0 = 0;
    folha.addEventListener('touchstart', (e) => { y0 = e.touches[0].clientY; }, { passive: true });
    folha.addEventListener('touchend', (e) => { if (e.changedTouches[0].clientY - y0 > 60) abrir(false); }, { passive: true });
  }
  // cabeçalho some ao rolar para baixo e volta ao rolar para cima (só no celular)
  const topo = document.querySelector<HTMLElement>('.topo');
  if (topo && matchMedia('(max-width: 767px)').matches) {
    let ultimo = scrollY;
    addEventListener('scroll', () => {
      const y = scrollY;
      topo.classList.toggle('esconde', y > ultimo && y > 120);
      ultimo = y;
    }, { passive: true });
  }
  // "Menu" abre o menu lateral do Header
  document.querySelector('.ba [data-abre="menu"]')?.addEventListener('click', () => document.querySelector<HTMLButtonElement>('.burger')?.click());
</script>
