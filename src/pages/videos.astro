---
// Página "Vídeos" (edição e criação de vídeos). Mesmo modelo das páginas Sites e Lojas:
// hero com o editor de vídeo em código (EditorVideo.astro), tipos com preço real (edição a partir de R$ 50/vídeo),
// antes e depois arrastável, 6 técnicas com demonstração ao vivo, incluso, processo e depoimentos.
import Base from '../layouts/Base.astro';
import HeroCrescimento from '../components/HeroCrescimento.astro';
import EditorVideo from '../components/EditorVideo.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Icon from '../components/Icon.astro';
import { config, waLink } from '../config';

const msg = (p: string) => `Olá! Quero um orçamento de ${p}.`;
const tipos = [
  { nome: 'Edição de Reels e TikTok', de: 'A partir de', preco: 'R$ 50', per: '/vídeo', desc: 'Você grava, nós deixamos o vídeo pronto para prender a atenção e postar.', itens: ['Cortes e ritmo', 'Legendas animadas', 'Trilha e efeitos'], destaque: true },
  { nome: 'Vídeos para anúncios', de: 'Valor', preco: 'Sob consulta', desc: 'Vídeos curtos feitos para vender no Instagram, Facebook e YouTube.', itens: ['Gancho nos 3 primeiros segundos', 'Formatos 9:16, 1:1 e 16:9', 'Chamada para o WhatsApp'] },
  { nome: 'Vídeo institucional', de: 'Valor', preco: 'Sob consulta', desc: 'A história da sua empresa contada em poucos minutos, com cara de cinema.', itens: ['Roteiro com você', 'Gravação e edição', 'Cor e áudio tratados'] },
];
// demonstrações ao vivo (cada uma é uma animação em CSS sobre fotos de public/mock/)
const tecnicas = [
  { id: 'cortes', nome: 'Cortes no ritmo', desc: 'Cenas trocando na batida da música para ninguém pular o vídeo.', fotos: ['live-show', 'fitness2', 'modelo'] },
  { id: 'legendas', nome: 'Legendas animadas', desc: 'A maioria assiste sem som. A legenda segura quem está rolando o feed.', fotos: ['modelo'] },
  { id: 'zoom', nome: 'Zoom dinâmico', desc: 'Aproximações rápidas que dão energia e destacam o que importa.', fotos: ['fitness2'] },
  { id: 'cor', nome: 'Correção de cor', desc: 'Imagem viva e com a mesma cara em todos os vídeos da sua marca.', fotos: ['live-evento'] },
  { id: 'trans', nome: 'Transições', desc: 'Passagens suaves ou impactantes entre uma cena e outra.', fotos: ['live-publico', 'live-show'] },
  { id: 'motion', nome: 'Textos e motion', desc: 'Títulos, preços e chamadas animadas com a identidade da sua marca.', fotos: ['salao'] },
];
// câmeras da transmissão: [foto, nome]
const cams = [['live-missa', 'Altar'], ['live-biblia', 'Leitura'], ['live-publico', 'Fiéis'], ['live-evento', 'Geral']];
const incluso: [string, string, string][] = [
  ['smartphone', 'Formato para cada rede', 'Reels, Stories, TikTok, YouTube e anúncios.'],
  ['message', 'Legendas em português', 'Para quem assiste sem som, que é a maioria.'],
  ['sparkles', 'Cor e áudio tratados', 'Imagem bonita e voz limpa, sem ruído.'],
  ['star', 'Com a sua marca', 'Logo, cores e fontes do seu negócio.'],
  ['rocket', 'Gancho no início e pronto para postar', 'Os primeiros segundos pensados para prender e o arquivo final no tamanho certo de cada rede.'],
];
const etapas = ['Você envia o material ou a ideia', 'Roteiro e estilo combinados', 'Edição e ajustes', 'Entrega pronta para postar'];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Edição e criação de vídeos', description: 'Edição e criação de vídeos para Reels, Stories, TikTok e anúncios.', provider: { '@type': 'ProfessionalService', name: config.nome }, areaServed: 'BR', offers: { '@type': 'Offer', priceCurrency: 'BRL', price: 50 } },
];
---
<Base title="Edição de Vídeos para Reels e TikTok em SP | MKT Center"
  description="Edição de vídeos para Reels, TikTok e anúncios a partir de R$ 50, e transmissão ao vivo de missas, cultos e eventos em São Paulo."
  schema={schema} crumbs={[['Vídeos', '/videos/']]}>
  <HeroCrescimento
    rotulo="Edição de vídeos"
    linhas={[['Vídeos', 'que'], ['prendem', 'em']]}
    destaque="3 segundos."
    texto="Editamos Reels, TikToks, Stories e anúncios com cortes no ritmo, legendas animadas e cor de cinema, para o seu vídeo parar o dedo de quem está rolando o feed."
    bt1={['Quero meus vídeos', waLink(msg('edição de vídeos'))]}
    bt2={['Ver técnicas', '#tecnicas']}
    numeros={[[50, '', 'R$ por vídeo editado'], [4, '', 'formatos: 9:16, 1:1, 4:5 e 16:9']]}
    rolarPara="#tipos"
  >
    <EditorVideo slot="visual" />
  </HeroCrescimento>

  <section id="tipos" class="servicos-topo">
    <div class="wrap">
      <span class="eyebrow">Escolha o seu</span>
      <h2>Tipos de vídeo</h2>
      <div class="st-grid">
        {tipos.map((t) => (
          <article class={`st-card${t.destaque ? ' on' : ''}`}>
            {t.destaque && <span class="st-selo">Mais pedido</span>}
            <h3>{t.nome}</h3>
            <p class="st-preco"><small>{t.de}</small>{t.preco}{t.per && <em>{t.per}</em>}</p>
            <p class="st-desc">{t.desc}</p>
            <ul>{t.itens.map((i) => <li>{i}</li>)}</ul>
            <a class="btn btn-primary st-bt" href={waLink(msg(t.nome))} target="_blank" rel="noopener">Quero este</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- antes e depois: arraste a linha para comparar o material bruto com o vídeo editado -->
  <section>
    <div class="wrap vd-ad-wrap">
      <div class="vd-ad-txt">
        <span class="eyebrow">Antes e depois</span>
        <h2>Do celular para o feed</h2>
        <p class="vd-lead">Arraste a linha e veja a diferença entre o vídeo como foi gravado e o vídeo editado pela MKT Center: cor, enquadramento, legenda e marca.</p>
        <ul class="vd-lista"><li>Cor corrigida e contraste</li><li>Enquadramento vertical</li><li>Legenda e chamada animadas</li></ul>
      </div>
      <div class="vd-ad" id="antes-depois" style="--x:50%">
        <div class="vd-ad-lado vd-depois">
          <img src="/mock/live-show.webp" alt="Vídeo editado: cor viva, legenda e marca" width="480" height="360" loading="lazy" decoding="async" />
          <span class="vd-ad-leg"><span>Hoje tem</span> <b>show ao vivo</b></span>
          <span class="vd-ad-marca">@suamarca</span>
        </div>
        <div class="vd-ad-lado vd-antes">
          <img src="/mock/live-show.webp" alt="Vídeo bruto, sem edição" width="480" height="360" loading="lazy" decoding="async" />
        </div>
        <span class="vd-ad-rot vd-ad-rot--a">Antes</span><span class="vd-ad-rot vd-ad-rot--d">Depois</span>
        <span class="vd-ad-linha"><i>‹ ›</i></span>
        <input type="range" min="0" max="100" value="50" aria-label="Comparar antes e depois" />
      </div>
    </div>
  </section>

  <section id="tecnicas">
    <div class="wrap">
      <span class="eyebrow">Ao vivo</span>
      <h2>Técnicas de edição que usamos</h2>
      <div class="vd-tec">
        {tecnicas.map((t) => (
          <article class="vd-card">
            <div class={`vd-demo vd-${t.id}`} aria-hidden="true">
              {t.fotos.map((f, i) => <img src={`/mock/${f}.webp`} alt="" width="480" height="360" loading="lazy" decoding="async" style={`--i:${i}`} />)}
              {t.id === 'legendas' && <span class="vd-pal"><span>Isso</span> <span>muda</span> <span>tudo</span></span>}
              {t.id === 'motion' && <span class="vd-mo"><b>Promo</b><em>-30%</em></span>}
              {t.id === 'cor' && <span class="vd-cor-linha"></span>}
            </div>
            <h3>{t.nome}</h3>
            <p>{t.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- transmissão ao vivo: mesa de corte multicâmera em código (4 câmeras trocando a cada 3 s, só CSS) -->
  <section id="ao-vivo">
    <div class="wrap tv-wrap">
      <div class="tv-txt">
        <span class="eyebrow">Transmissão ao vivo</span>
        <h2>Missas, cultos e eventos ao vivo</h2>
        <p class="vd-lead">Levamos a sua celebração para quem não pode estar presente. Transmissão com várias câmeras, som direto da mesa e letreiros, no YouTube, Facebook e Instagram ao mesmo tempo.</p>
        <ul class="vd-lista">
          <li>Missas, cultos, casamentos, formaturas e eventos</li>
          <li>Várias câmeras com cortes ao vivo</li>
          <li>Som limpo, direto da mesa de som</li>
          <li>Letreiros com nomes, cânticos e versículos</li>
          <li>Gravação completa para assistir depois</li>
        </ul>
        <a class="btn btn-primary tv-bt" href={waLink(msg('transmissão ao vivo'))} target="_blank" rel="noopener">Quero transmitir ao vivo</a>
      </div>
      <div class="tv" aria-hidden="true">
        <div class="tv-prog">
          {cams.map((c, i) => <img class="tv-cam" src={`/mock/${c[0]}.webp`} alt="" width="480" height="360" loading="lazy" decoding="async" style={`--i:${i}`} />)}
          <span class="tv-vivo"><i></i>AO VIVO</span>
          <span class="tv-tempo">01:12:45</span>
          <span class="tv-gc"><b>Santa Missa</b><em>Transmissão ao vivo · Paróquia</em></span>
          <span class="tv-chat">
            <span>Amém!</span><span>Assistindo daqui de casa</span><span>Glória a Deus</span>
          </span>
        </div>
        <div class="tv-multi">
          {cams.map((c, i) => (
            <span class="tv-mini" style={`--i:${i}`}>
              <img src={`/mock/${c[0]}.webp`} alt="" width="480" height="360" loading="lazy" decoding="async" />
              <small>CAM {i + 1} · {c[1]}</small>
            </span>
          ))}
        </div>
        <div class="tv-redes">
          {['YouTube', 'Facebook', 'Instagram'].map((r) => <span><i></i>{r}</span>)}
          <span class="tv-sinal">Sinal estável</span>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Em todo vídeo</span>
      <h2>O que vem incluso</h2>
      <div class="grid grid-servicos sv-grid">
        {incluso.map(([i, t, d]) => (
          <div class="card"><span class="icone"><Icon name={i} /></span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Passo a passo</span>
      <h2>Como funciona</h2>
      <ol class="etapas">{etapas.map((e) => <li>{e}</li>)}</ol>
    </div>
  </section>

  <Depoimentos />
</Base>

<style>
  /* tipos (mesmo visual das páginas Sites e Lojas) */
  .st-grid{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:768px){.st-grid{grid-template-columns:repeat(3,1fr)}}
  .st-card{position:relative;display:flex;flex-direction:column;padding:26px 24px 24px;border-radius:var(--radius-lg);text-align:left;
    background:linear-gradient(160deg,rgba(28,29,33,.85),rgba(12,13,15,.9));border:1px solid rgba(255,255,255,.08);box-shadow:0 20px 40px -24px rgba(0,0,0,.9);overflow:hidden;transition:transform .3s,border-color .3s}
  .st-card::before{content:'';position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg,#ff6900,#ffb35c)}
  .st-card:hover{transform:translateY(-4px);border-color:rgba(255,105,0,.45)}
  .st-card.on{border-color:rgba(255,105,0,.6);box-shadow:0 0 40px -12px rgba(255,105,0,.6)}
  .st-selo{align-self:flex-start;margin-bottom:10px;padding:4px 10px;border-radius:99px;background:linear-gradient(90deg,#ff6900,#ffb35c);color:#141006;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .st-card h3{font-size:24px}
  .st-preco{margin-top:10px;font-family:var(--ff-tit);font-weight:800;font-size:40px;line-height:1;background:linear-gradient(90deg,#ff8a24,#ffc993);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .st-preco small{display:block;font-family:var(--ff-txt);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#aeb4bd;-webkit-text-fill-color:#aeb4bd;margin-bottom:4px}
  .st-preco em{font-style:normal;font-size:18px;margin-left:2px}
  .st-desc{margin-top:12px;color:#aeb4bd;font-size:15px;line-height:23px}
  .st-card ul{list-style:none;margin:16px 0 22px;padding:0;display:grid;gap:8px}
  .st-card li{position:relative;padding-left:16px;font-size:14px;color:#e4e6ea}
  .st-card li::before{content:'';position:absolute;left:0;top:9px;width:6px;height:6px;border-radius:50%;background:#ff6900}
  .st-bt{margin-top:auto;width:100%}

  /* antes e depois */
  .vd-ad-wrap{display:grid;grid-template-columns:1fr 1.15fr;gap:40px;align-items:center}
  .vd-ad-txt{text-align:left}
  .vd-lead{color:#aeb4bd;font-size:16px;line-height:1.6;margin-top:12px}
  .vd-lista{list-style:none;padding:0;margin:18px 0 0;display:grid;gap:8px}
  .vd-lista li{position:relative;padding-left:18px;color:#e4e6ea}
  .vd-lista li::before{content:'';position:absolute;left:0;top:8px;width:7px;height:7px;border-radius:50%;background:#ff6900}
  .vd-ad{position:relative;aspect-ratio:16/10;border-radius:18px;overflow:hidden;background:#000;box-shadow:0 0 0 1px rgba(255,255,255,.1),0 30px 60px -30px #000;user-select:none;container-type:inline-size}
  .vd-ad-lado{position:absolute;inset:0}
  .vd-ad-lado img{width:100%;height:100%;object-fit:cover}
  .vd-depois img{filter:saturate(1.45) contrast(1.15) brightness(1.05);transform:scale(1.08)}
  .vd-depois::after{content:'';position:absolute;inset:0;background:radial-gradient(120% 90% at 50% 40%,transparent 50%,rgba(0,0,0,.55)),linear-gradient(180deg,transparent 55%,rgba(0,0,0,.6))}
  .vd-antes{clip-path:inset(0 calc(100% - var(--x)) 0 0)}
  .vd-antes img{filter:saturate(.45) contrast(.82) brightness(.88) sepia(.12) blur(.4px)}
  .vd-ad-leg{position:absolute;left:0;right:0;bottom:12%;z-index:1;text-align:center;font:800 6cqw/1 var(--ff-tit);text-transform:uppercase;color:#fff;text-shadow:0 3px 12px rgba(0,0,0,.8)}
  .vd-ad-leg b{color:#ff8a24}
  .vd-ad-marca{position:absolute;right:4%;top:5%;z-index:1;padding:5px 10px;border-radius:99px;background:rgba(0,0,0,.45);color:#fff;font:700 2.4cqw var(--ff-txt)}
  .vd-ad-rot{position:absolute;top:5%;z-index:3;padding:4px 10px;border-radius:99px;font:700 11px var(--ff-txt);letter-spacing:.1em;text-transform:uppercase}
  .vd-ad-rot--a{left:4%;background:rgba(0,0,0,.55);color:#e4e6ea}
  .vd-ad-rot--d{right:4%;top:auto;bottom:5%;background:#ff6900;color:#141006}
  .vd-ad-linha{position:absolute;top:0;bottom:0;left:var(--x);z-index:3;width:2px;margin-left:-1px;background:#fff;box-shadow:0 0 12px rgba(0,0,0,.6);pointer-events:none}
  .vd-ad-linha i{position:absolute;left:50%;top:50%;display:grid;place-items:center;width:42px;height:42px;transform:translate(-50%,-50%);border-radius:50%;background:#ff6900;color:#141006;font:800 16px/1 var(--ff-txt);font-style:normal;box-shadow:0 6px 18px rgba(0,0,0,.5)}
  .vd-ad input{position:absolute;inset:0;z-index:4;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}

  /* técnicas: cada card com uma prévia 9:16 animada */
  .vd-tec{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
  .vd-card{text-align:left}
  .vd-card h3{font-size:18px;margin-top:12px}
  .vd-card p{margin-top:4px;color:#aeb4bd;font-size:13px;line-height:1.5}
  .vd-demo{position:relative;aspect-ratio:9/16;border-radius:14px;overflow:hidden;background:#000;container-type:inline-size;
    box-shadow:0 0 0 1px rgba(255,255,255,.1),0 20px 40px -20px #000;transition:box-shadow .3s}
  .vd-card:hover .vd-demo{box-shadow:0 0 0 1px rgba(255,138,36,.7),0 0 30px -8px rgba(255,105,0,.7)}
  .vd-demo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .vd-demo::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(0,0,0,.55));pointer-events:none}

  .vd-cortes img{opacity:0;animation:vd-tres 2.4s steps(1) infinite;animation-delay:calc(var(--i) * .8s)}
  @keyframes vd-tres{0%{opacity:1}33.33%,100%{opacity:0}}

  .vd-pal{position:absolute;left:6%;right:6%;bottom:16%;z-index:1;display:flex;flex-wrap:wrap;justify-content:center;gap:0 .25em;font:800 14cqw/1.05 var(--ff-tit);text-transform:uppercase;color:#fff;text-shadow:0 2px 8px #000}
  .vd-pal span{animation:vd-pal 2.4s ease-out infinite}
  .vd-pal span:nth-child(2){animation-delay:.4s}
  .vd-pal span:nth-child(3){animation-delay:.8s}
  @keyframes vd-pal{0%{transform:scale(.3);opacity:0}10%{transform:scale(1.2);opacity:1;color:#ff8a24}25%,85%{transform:scale(1);opacity:1;color:#fff}100%{opacity:0}}

  .vd-zoom img{object-position:50% 0;animation:vd-zoom 2.6s cubic-bezier(.7,0,.2,1) infinite}
  @keyframes vd-zoom{0%,30%{transform:scale(1)}40%,75%{transform:scale(1.55)}85%,100%{transform:scale(1)}}

  .vd-cor img{animation:vd-cor 4s ease-in-out infinite}
  .vd-cor-linha{position:absolute;top:0;bottom:0;width:2px;background:#fff;box-shadow:0 0 10px #fff;animation:vd-varre 4s ease-in-out infinite}
  @keyframes vd-cor{0%,15%{filter:saturate(.3) contrast(.8) brightness(.85)}50%,85%{filter:saturate(1.5) contrast(1.15) brightness(1.05)}100%{filter:saturate(.3) contrast(.8) brightness(.85)}}
  @keyframes vd-varre{0%,15%{left:0;opacity:1}50%{left:100%;opacity:1}51%,100%{left:100%;opacity:0}}

  .vd-trans img:nth-child(2){animation:vd-wipe 3s cubic-bezier(.7,0,.3,1) infinite}
  @keyframes vd-wipe{0%,30%{clip-path:circle(0 at 50% 50%)}55%,85%{clip-path:circle(80% at 50% 50%)}100%{clip-path:circle(80% at 50% 50%);opacity:0}}

  .vd-motion img{filter:brightness(.7)}
  .vd-mo{position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px}
  .vd-mo b{font:800 20cqw/1 var(--ff-tit);text-transform:uppercase;color:#fff;animation:vd-entra 3s cubic-bezier(.2,.9,.3,1.3) infinite}
  .vd-mo em{font-style:normal;padding:4px 12px;border-radius:99px;background:#ff6900;color:#141006;font:800 12cqw/1 var(--ff-tit);animation:vd-entra 3s cubic-bezier(.2,.9,.3,1.3) .25s infinite}
  @keyframes vd-entra{0%{transform:translateX(-120%) skewX(-12deg);opacity:0}15%,80%{transform:none;opacity:1}100%{transform:translateX(120%);opacity:0}}

  /* transmissão ao vivo */
  .tv-wrap{display:grid;grid-template-columns:1fr 1.2fr;gap:40px;align-items:center}
  .tv-txt{text-align:left}
  .tv-bt{margin-top:22px}
  .tv{--t:12s;padding:12px;border-radius:18px;background:linear-gradient(160deg,#1d1f24,#0d0e11 60%);border:1px solid rgba(255,255,255,.12);box-shadow:0 40px 80px -30px #000}
  .tv-prog{position:relative;aspect-ratio:16/9;border-radius:12px;overflow:hidden;background:#000;container-type:inline-size}
  .tv-cam{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;animation:tv-vez var(--t) steps(1) infinite;animation-delay:calc(var(--i) * 3s - var(--t))}
  .tv-cam[style="--i:0"]{object-position:50% 60%}
  .tv-prog::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.35),transparent 30%,transparent 60%,rgba(0,0,0,.65))}
  .tv-vivo{position:absolute;left:3%;top:5%;z-index:1;display:flex;align-items:center;gap:6px;padding:4px 10px;border-radius:6px;background:#e5202e;color:#fff;font:800 2.4cqw/1 var(--ff-txt);letter-spacing:.08em}
  .tv-vivo i{width:1.4cqw;height:1.4cqw;border-radius:50%;background:#fff;animation:tv-pisca 1s steps(2) infinite}
  .tv-tempo{position:absolute;left:3%;top:15%;z-index:1;color:#fff;font:600 2cqw var(--ff-txt);opacity:.85}
  .tv-gc{position:absolute;left:3%;bottom:7%;z-index:1;display:flex;flex-direction:column;padding:1.2cqw 2cqw;border-left:4px solid #ff6900;background:rgba(9,10,12,.75);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);animation:tv-gc var(--t) ease-out infinite}
  .tv-gc b{color:#fff;font:800 3.6cqw/1.1 var(--ff-tit);text-transform:uppercase}
  .tv-gc em{font-style:normal;color:#ffb35c;font:600 1.9cqw var(--ff-txt)}
  .tv-chat{position:absolute;right:3%;bottom:7%;z-index:1;display:flex;flex-direction:column;align-items:flex-end;gap:1cqw}
  .tv-chat span{padding:.8cqw 1.8cqw;border-radius:99px;background:rgba(255,255,255,.14);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);color:#fff;font:600 1.9cqw var(--ff-txt);opacity:0;animation:tv-msg 6s ease-out infinite}
  .tv-chat span:nth-child(2){animation-delay:2s}
  .tv-chat span:nth-child(3){animation-delay:4s}
  .tv-multi{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}
