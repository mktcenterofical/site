---
// Página "Apps" (aplicativos e sistemas). Mesmo modelo das páginas Sites, Lojas, Vídeos, Redes e Política:
// hero com imagem de estilo escolhida pelo cliente (public/mock/apps-hero.webp), apps que criamos (projetos com tipo
// "Aplicativo..." ou "Sistema..."), o que podemos criar, preço sob consulta (valor real) e processo.
import Base from '../layouts/Base.astro';
import HeroCrescimento from '../components/HeroCrescimento.astro';
import CardPortfolio from '../components/CardPortfolio.astro';
import Icon from '../components/Icon.astro';
import { projetos } from '../data/projetos';
import { config, waLink } from '../config';

const msg = (p: string) => `Olá! Quero conversar sobre ${p}.`;
const apps = projetos.filter((p) => /aplicativo|sistema/i.test(p.tipo));
const tipos: [string, string, string][] = [
  ['grid', 'Sistemas de gestão', 'Orçamentos, pedidos, produção, estoque e equipe num painel só.'],
  ['trending', 'Painéis de resultados', 'Site, Google e redes sociais em gráficos ao vivo.'],
  ['heart', 'Apps de saúde', 'Diários, lembretes e relatórios para pacientes e equipes.'],
  ['landmark', 'Apps de mandato', 'Canal direto do político com a população da cidade.'],
  ['smartphone', 'Instala no celular', 'Funciona no navegador e vira ícone na tela do celular.'],
  ['wrench', 'Integrações', 'WhatsApp, planilhas, ERP, Google e redes conectados.'],
];
const etapas = ['Conversa e levantamento do que precisa', 'Protótipo das telas para aprovação', 'Desenvolvimento por etapas', 'Treinamento, entrega e suporte'];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Aplicativos e sistemas', serviceType: 'Desenvolvimento de aplicativos e sistemas', provider: { '@type': 'ProfessionalService', name: config.nome }, areaServed: 'BR' }
];
---
<Base title="Aplicativos e Sistemas Sob Medida | MKT Center"
  description="Aplicativos e sistemas sob medida: gestão, painéis de resultados, apps de saúde e de mandato. Veja apps reais e peça sua proposta."
  schema={schema} crumbs={[['Apps', '/aplicativos-e-sistemas/']]}>
  <HeroCrescimento
    rotulo="Aplicativos e sistemas"
    linhas={[['Seu negócio', 'em'], ['app', 'feito']]}
    destaque="sob medida."
    texto="Criamos sistemas de gestão, painéis e aplicativos que abrem no computador e no celular, com login, relatórios e tudo o que a sua rotina precisa."
    bt1={['Quero meu app', waLink(msg('um aplicativo ou sistema'))]}
    bt2={['Ver apps', '#apps']}
    numeros={[[apps.length, '', 'apps e sistemas no ar'], [projetos.length, '', 'projetos no portfólio'], [2013, '', 'no digital desde']]}
    rolarPara="#apps"
  >
    <div slot="visual" class="ap-hero">
      <img src="/mock/apps-hero.webp" alt="Aplicativo no celular com cartões de vidro flutuando" width="900" height="1057" fetchpriority="high" decoding="async" />
    </div>
  </HeroCrescimento>

  <section id="apps" class="servicos-topo">
    <div class="wrap">
      <div class="st-cab">
        <div><span class="eyebrow">Portfólio</span><h2>Apps e sistemas que criamos</h2></div>
        <div class="st-setas"><button type="button" class="st-seta" data-dir="-1" aria-label="Apps anteriores"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button><button type="button" class="st-seta" data-dir="1" aria-label="Próximos apps"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button></div>
      </div>
      <div class="st-pf" id="st-pf" tabindex="0" aria-label="Apps e sistemas (role para o lado)">{apps.map((p) => <CardPortfolio {...p} />)}</div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Sob medida</span>
      <h2>O que podemos criar</h2>
      <div class="grid grid-servicos sv-grid st-inc">
        {tipos.map(([i, t, d]) => (
          <div class="card"><span class="icone"><Icon name={i} /></span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap ap-preco">
      <div>
        <span class="eyebrow">Investimento</span>
        <h2>Valor sob consulta</h2>
        <p class="ap-lead">Cada app é feito para a sua rotina. Depois de uma conversa, você recebe a proposta com telas, prazo e valor.</p>
      </div>
      <a class="btn btn-primary" href={waLink(msg('um aplicativo ou sistema'))} target="_blank" rel="noopener">Pedir proposta no WhatsApp</a>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Passo a passo</span>
      <h2>Como funciona</h2>
      <ol class="etapas">{etapas.map((e) => <li>{e}</li>)}</ol>
    </div>
  </section>

</Base>

<style>
  /* imagem sem fundo (PNG recortado), com a mesma altura da coluna de texto */
  .ap-hero{position:relative;align-self:stretch;min-height:420px}
  .ap-hero img{position:absolute;top:6%;right:0;bottom:6%;left:0;width:100%;height:88%;object-fit:contain;object-position:right center;filter:drop-shadow(0 30px 40px rgba(0,0,0,.7))}
  @media(max-width:1023px){.ap-hero{min-height:0;height:460px;width:100%}.ap-hero img{object-position:center}}
  .st-cab{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px}
  .st-cab h2{margin:0}
  .st-setas{display:flex;gap:8px}
  .st-seta{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.04);color:#fff;cursor:pointer;transition:border-color .2s,background .2s,opacity .2s}
  .st-seta:hover{border-color:#ff6900;background:rgba(255,105,0,.15)}
  .st-seta:disabled{opacity:.3;cursor:default;border-color:rgba(255,255,255,.18);background:transparent}
  /* carrossel: 4 cards no computador, 2 no tablet, 1 e um pedaço no celular */
  .st-pf{display:flex;gap:16px;overflow-x:auto;scroll-behavior:smooth;padding:4px 2px 18px;scrollbar-width:none;outline:none}
  .st-pf::-webkit-scrollbar{display:none}
  .st-pf.encaixe{scroll-snap-type:x mandatory}
  .st-pf>:global(*){flex:0 0 calc((100% - 48px)/4);scroll-snap-align:start}
  .st-pf :global(.pf p){-webkit-line-clamp:2}
  .grid.st-inc{grid-template-columns:repeat(3,1fr);grid-template-areas:none}
  .grid.st-inc>*{grid-area:auto !important;display:block !important}
  .grid.st-inc .icone{margin:0 0 16px !important}
  .ap-preco{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:32px;border-radius:var(--radius-lg);text-align:left;
    background:linear-gradient(160deg,rgba(28,29,33,.85),rgba(12,13,15,.9));border:1px solid rgba(255,105,0,.45);box-shadow:0 0 40px -14px rgba(255,105,0,.5)}
  .ap-preco h2{margin:0}
  .ap-lead{margin-top:10px;max-width:560px;color:#aeb4bd;font-size:16px;line-height:1.6}
  @media(max-width:1023px){.st-pf>:global(*){flex-basis:calc((100% - 16px)/2)}}
  @media(max-width:767px){
    .st-pf>:global(*){flex-basis:80%}.st-cab{justify-content:center;text-align:center}.st-setas{display:none}
    .grid.st-inc{grid-template-columns:1fr 1fr}
    .ap-preco{flex-direction:column;text-align:center;padding:24px 16px}
    .ap-preco .btn{width:100%}
  }
</style>

<script>
  const trilho = document.getElementById('st-pf');
  if (trilho) {
    const setas = document.querySelectorAll<HTMLButtonElement>('.st-seta');
    const passo = () => ((trilho.firstElementChild as HTMLElement)?.offsetWidth || 260) + 16;
    const atualizar = () => {
      setas[0].disabled = trilho.scrollLeft < 4;
      setas[1].disabled = trilho.scrollLeft + trilho.clientWidth >= trilho.scrollWidth - 4;
    };
    const encaixe = () => trilho.classList.add('encaixe'); // scroll-snap só depois da 1ª interação (LCP)
    setas.forEach((b) => b.addEventListener('click', () => { encaixe(); trilho.scrollBy({ left: Number(b.dataset.dir) * passo(), behavior: 'smooth' }); }));
    ['pointerdown', 'touchstart', 'wheel', 'keydown'].forEach((ev) => trilho.addEventListener(ev, encaixe, { once: true, passive: true }));
    trilho.addEventListener('scroll', atualizar, { passive: true });
    addEventListener('resize', atualizar);
    atualizar();
  }
</script>
