---
// Página "Apps" (aplicativos e sistemas). Mesmo modelo das páginas Sites, Lojas, Vídeos, Redes e Política:
// hero com imagem de estilo escolhida pelo cliente (public/mock/apps-hero.webp), apps que criamos (projetos com tipo
// "Aplicativo..." ou "Sistema..."), o que podemos criar, preço sob consulta (valor real), processo e FAQ.
import Base from '../layouts/Base.astro';
import HeroCrescimento from '../components/HeroCrescimento.astro';
import CardPortfolio from '../components/CardPortfolio.astro';
import Icon from '../components/Icon.astro';
import { projetos } from '../data/projetos';
import { config, waLink } from '../config';

const msg = (p: string) => `Olá! Quero conversar sobre ${p}.`;
const apps = projetos.filter((p) => /aplicativo|sistema/i.test(p.tipo));
const tipos: [string, string, string][] = [
  ['grid', 'Sistemas de gestão', 'Orçamentos, pedidos, produção, estoque e equipe num painel só.'],
  ['trending', 'Painéis de resultados', 'Site, Google e redes sociais em gráficos ao vivo.'],
  ['heart', 'Apps de saúde', 'Diários, lembretes e relatórios para pacientes e equipes.'],
  ['landmark', 'Apps de mandato', 'Canal direto do político com a população da cidade.'],
  ['smartphone', 'Instala no celular', 'Funciona no navegador e vira ícone na tela do celular.'],
  ['wrench', 'Integrações', 'WhatsApp, planilhas, ERP, Google e redes conectados.'],
];
const etapas = ['Conversa e levantamento do que precisa', 'Protótipo das telas para aprovação', 'Desenvolvimento por etapas', 'Treinamento, entrega e suporte'];
const faq: [string, string][] = [
  ['Quanto custa um app ou sistema?', 'Depende das telas e funções. O valor é combinado na proposta, depois de entender o projeto.'],
  ['Precisa baixar na loja de aplicativos?', 'Não necessariamente. Fazemos apps que abrem no navegador e podem ser instalados como ícone no celular.'],
  ['O sistema pode ter login e níveis de acesso?', 'Sim. Cada pessoa da equipe entra com seu usuário e vê só o que precisa.'],
];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Aplicativos e sistemas', serviceType: 'Desenvolvimento de aplicativos e sistemas', provider: { '@type': 'ProfessionalService', name: config.nome }, areaServed: 'BR' },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Base title="Aplicativos e Sistemas Sob Medida | MKT Center"
  description="Aplicativos e sistemas sob medida: gestão, painéis de resultados, apps de saúde e de mandato. Veja apps reais e peça sua proposta."
  schema={schema} crumbs={[['Apps', '/aplicativos-e-sistemas/']]}>
  <HeroCrescimento
    rotulo="Aplicativos e sistemas"
    linhas={[['Seu negócio', 'num'], ['app feito', 'sob']]}
    destaque="medida."
    texto="Criamos sistemas de gestão, painéis e aplicativos que abrem no computador e no celular, com login, relatórios e tudo o que a sua rotina precisa."
    bt1={['Quero meu app', waLink(msg('um aplicativo ou sistema'))]}
    bt2={['Ver apps', '#apps']}
    numeros={[[apps.length, '', 'apps e sistemas no ar']]}
    rolarPara="#apps"
  >
    <div slot="visual" class="ap-hero">
      <img src="/mock/apps-hero.webp" alt="Aplicativo no celular com cartões de vidro flutuando" width="900" height="1033" fetchpriority="high" decoding="async" />
    </div>
  </HeroCrescimento>

  <section id="apps" class="servicos-topo">
    <div class="wrap">
      <span class="eyebrow">Portfólio</span>
      <h2>Apps e sistemas que criamos</h2>
      <div class="ap-pf">{apps.map((p) => <CardPortfolio {...p} />)}</div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Sob medida</span>
      <h2>O que podemos criar</h2>
      <div class="grid grid-servicos sv-grid st-inc">
        {tipos.map(([i, t, d]) => (
          <div class="card"><span class="icone"><Icon name={i} /></span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap ap-preco">
      <div>
        <span class="eyebrow">Investimento</span>
        <h2>Valor sob consulta</h2>
        <p class="ap-lead">Cada app é feito para a sua rotina. Depois de uma conversa, você recebe a proposta com telas, prazo e valor.</p>
      </div>
      <a class="btn btn-primary" href={waLink(msg('um aplicativo ou sistema'))} target="_blank" rel="noopener">Pedir proposta no WhatsApp</a>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Passo a passo</span>
      <h2>Como funciona</h2>
      <ol class="etapas">{etapas.map((e) => <li>{e}</li>)}</ol>
    </div>
  </section>

  <section>
    <div class="wrap prose">
      <h2>Perguntas frequentes</h2>
      {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>
</Base>

<style>
  .ap-hero{position:relative;width:100%;max-width:560px;margin:0 0 0 auto}
  .ap-hero::before{content:'';position:absolute;inset:10% 6%;border-radius:50%;background:radial-gradient(closest-side,rgba(255,105,0,.3),transparent);filter:blur(30px)}
  .ap-hero img{position:relative;display:block;width:100%;height:auto;-webkit-mask-image:radial-gradient(62% 58% at 52% 50%,#000 70%,transparent 100%);mask-image:radial-gradient(62% 58% at 52% 50%,#000 70%,transparent 100%)}
  @media(max-width:1023px){.ap-hero{margin:0 auto}}
  .ap-pf{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
  .grid.st-inc{grid-template-columns:repeat(3,1fr);grid-template-areas:none}
  .grid.st-inc>*{grid-area:auto !important;display:block !important}
  .grid.st-inc .icone{margin:0 0 16px !important}
  .ap-preco{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:32px;border-radius:var(--radius-lg);text-align:left;
    background:linear-gradient(160deg,rgba(28,29,33,.85),rgba(12,13,15,.9));border:1px solid rgba(255,105,0,.45);box-shadow:0 0 40px -14px rgba(255,105,0,.5)}
  .ap-preco h2{margin:0}
  .ap-lead{margin-top:10px;max-width:560px;color:#aeb4bd;font-size:16px;line-height:1.6}
  @media(max-width:1023px){.ap-pf{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:767px){
    .ap-pf{grid-template-columns:minmax(0,280px);justify-content:center}
    .grid.st-inc{grid-template-columns:1fr 1fr}
    .ap-preco{flex-direction:column;text-align:center;padding:24px 16px}
    .ap-preco .btn{width:100%}
  }
</style>
