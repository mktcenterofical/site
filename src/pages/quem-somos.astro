---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroCrescimento from '../components/HeroCrescimento.astro';
import { waLink } from '../config';
import { config } from '../config';
const schema = [{ '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Quem somos · MKT Center', about: { '@type': 'ProfessionalService', name: config.nome, foundingDate: '2013' } }];
const valores: [string, string, string][] = [
  ['trending', 'Resultado medido', 'Cada projeto nasce com uma meta: mais contatos, mais vendas ou melhor posição no Google. E a gente mostra os números.'],
  ['message', 'Conversa direta', 'Você fala com quem faz o seu projeto, pelo WhatsApp, sem jargão técnico e sem enrolação.'],
  ['smartphone', 'Celular em primeiro lugar', 'A maioria dos seus clientes chega pelo celular. Por isso tudo é pensado primeiro para a tela pequena.'],
  ['landmark', 'Para todos', 'Atendemos comércio, empresas, profissionais liberais e políticos de todos os partidos, sempre dentro das regras.'],
];
const etapas = ['Entendemos o seu negócio e o seu cliente', 'Mostramos a proposta e o layout antes de começar', 'Criamos, testamos em todos os aparelhos e publicamos', 'Acompanhamos os resultados e ajustamos todo mês'];
---
<Base title="Quem Somos: Agência Digital desde 2013 | MKT Center"
  description="Desde 2013 criando lojas virtuais, sites, redes sociais, vídeos e hoje aplicativos e sistemas com IA. Conheça a história da MKT Center."
  schema={schema}>
  <HeroCrescimento
    rotulo="Quem somos · MKT Center"
    linhas={[['Evoluindo']]}
    destaque="desde 2013."
    texto="Nascemos em 2013 criando lojas virtuais, quando o e-commerce no Brasil ainda engatinhava. Evoluímos para sites institucionais, redes sociais, vídeos e web design, e hoje usamos inteligência artificial para criar de sites a aplicativos e sistemas complexos."
    bt1={['Quero conversar', waLink('Olá! Conheci a história da MKT Center e quero conversar sobre um projeto.')]}
    bt2={['Ver portfólio', '/portfolio/']}
    numeros={[[2013, '', 'ano de fundação'], [10, '+', 'anos no digital'], ['IA', '', 'no dia a dia']]}
    rolarPara="#valores"
  />

  <section class="alt servicos-topo" id="valores">
    <div class="wrap">
      <span class="eyebrow">No que acreditamos</span>
      <h2>Nossos valores</h2>
      <div class="grid grid-4">
        {valores.map(([i, t, d]) => (
          <div class="card"><span class="icone"><Icon name={i} /></span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Como trabalhamos</span>
      <h2>Do briefing ao resultado</h2>
      <ol class="etapas">{etapas.map((e) => <li>{e}</li>)}</ol>
    </div>
  </section>

</Base>

<style>
  .foto{position:relative;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-card)}
  .foto img{width:100%;height:100%;object-fit:cover;aspect-ratio:16/11}
  .selo{position:absolute;left:16px;right:16px;bottom:16px;background:var(--carbon);color:#fff;border-radius:var(--radius-md);padding:14px 18px}
  .selo b{display:block;font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:22px;color:var(--orange-hot)}
  .selo span{font-size:14px;color:#c3c8cf}
</style>
