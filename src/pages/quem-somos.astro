---
import Base from '../layouts/Base.astro';
import FaixaCTA from '../components/FaixaCTA.astro';
import Icon from '../components/Icon.astro';
import { config } from '../config';
const schema = [{ '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Quem somos · MKT Center', about: { '@type': 'ProfessionalService', name: config.nome } }];
const valores: [string, string, string][] = [
  ['trending', 'Resultado medido', 'Cada projeto nasce com uma meta: mais contatos, mais vendas ou melhor posição no Google. E a gente mostra os números.'],
  ['message', 'Conversa direta', 'Você fala com quem faz o seu projeto, pelo WhatsApp, sem jargão técnico e sem enrolação.'],
  ['smartphone', 'Celular em primeiro lugar', 'A maioria dos seus clientes chega pelo celular. Por isso tudo é pensado primeiro para a tela pequena.'],
  ['landmark', 'Para todos', 'Atendemos comércio, empresas, profissionais liberais e políticos de todos os partidos, sempre dentro das regras.'],
];
const etapas = ['Entendemos o seu negócio e o seu cliente', 'Mostramos a proposta e o layout antes de começar', 'Criamos, testamos em todos os aparelhos e publicamos', 'Acompanhamos os resultados e ajustamos todo mês'];
---
<Base title="Quem Somos: Agência de Marketing Digital | MKT Center"
  description="Conheça a MKT Center: agência que une tecnologia e marketing para trazer clientes ao seu negócio. Veja como trabalhamos."
  schema={schema} crumbs={[['Quem somos', '/quem-somos/']]}>
  <section style="padding-top:8px">
    <div class="wrap dois">
      <div>
        <span class="eyebrow">Quem somos</span>
        <h1>Tecnologia e marketing que <span class="destaque">movem negócios</span></h1>
        <p class="lead">A MKT Center é uma agência de marketing digital. Criamos sites, aplicativos, sistemas e lojas virtuais, e cuidamos do tráfego pago, do SEO e do marketing político.</p>
        <p class="lead">Nosso trabalho é simples de explicar: fazer o cliente certo encontrar a sua empresa e chegar até você pelo WhatsApp.</p>
        <div class="acoes"><a class="btn btn-primary" href="/contato/">Quero conversar</a><a class="btn btn-ghost" href="/portfolio/">Ver portfólio</a></div>
      </div>
      <div class="foto">
        <img src="/mock/padaria.webp" alt="Projeto de site para padaria criado pela MKT Center" width="640" height="400" loading="lazy" />
        <div class="selo"><b>Do primeiro contato</b><span>ao site no ar, com você em cada etapa</span></div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <span class="eyebrow">No que acreditamos</span>
      <h2>Nossos valores</h2>
      <div class="grid grid-4">
        {valores.map(([i, t, d]) => (
          <div class="card"><span class="icone"><Icon name={i} /></span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Como trabalhamos</span>
      <h2>Do briefing ao resultado</h2>
      <ol class="etapas">{etapas.map((e) => <li>{e}</li>)}</ol>
    </div>
  </section>

  <FaixaCTA titulo="Vamos fazer o seu negócio crescer?" />
</Base>

<style>
  .foto{position:relative;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-card)}
  .foto img{width:100%;height:100%;object-fit:cover;aspect-ratio:16/11}
  .selo{position:absolute;left:16px;right:16px;bottom:16px;background:var(--carbon);color:#fff;border-radius:var(--radius-md);padding:14px 18px}
  .selo b{display:block;font-family:var(--ff-tit);font-weight:800;text-transform:uppercase;font-size:22px;color:var(--orange-hot)}
  .selo span{font-size:14px;color:#c3c8cf}
</style>
