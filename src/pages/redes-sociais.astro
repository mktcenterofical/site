---
// Página "Redes" (gestão de redes sociais). Mesmo modelo das páginas Sites, Lojas e Vídeos:
// hero com a imagem de referência escolhida pelo cliente (public/mock/redes-perfil.webp, perfil de terceiro: confirmar direito de uso antes do lançamento; PainelRedes.astro fica guardado), planos com preços reais (redes R$ 400/mês,
// post R$ 30/card, vídeo R$ 50), antes e depois do perfil arrastável, 6 entregas com demonstração ao vivo,
// incluso, processo e depoimentos.
import Base from '../layouts/Base.astro';
import HeroCrescimento from '../components/HeroCrescimento.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Icon from '../components/Icon.astro';
import { config, waLink } from '../config';

const msg = (p: string) => `Olá! Quero um orçamento de ${p}.`;
const tipos = [
  { nome: 'Gestão de Redes Sociais', selo: 'Mensal', de: 'A partir de', preco: 'R$ 400', per: '/mês', desc: 'Sua marca presente e ativa todos os meses, sem você se preocupar.', itens: ['Planejamento de conteúdo', 'Publicações nas redes', 'Acompanhamento de resultados'], destaque: true },
  { nome: 'Criação de Posts', de: 'A partir de', preco: 'R$ 30', per: '/card', desc: 'Cards com a identidade da sua marca, prontos para postar.', itens: ['Arte com a sua marca', 'Feed e Stories', 'Texto da publicação'] },
  { nome: 'Edição de Vídeos', de: 'A partir de', preco: 'R$ 50', per: '/vídeo', desc: 'Reels e Stories editados para prender a atenção.', itens: ['Cortes e legendas', 'Formato de cada rede', 'Pronto para postar'] },
  { nome: 'Anúncios nas redes', de: 'Valor', preco: 'Sob consulta', desc: 'Impulsionamento para levar sua marca a quem ainda não conhece você.', itens: ['Público certo da sua região', 'Chamada para o WhatsApp', 'Relatório de resultados'] },
];
// entregas com demonstração ao vivo (animações em CSS)
const entregas = [
  { id: 'post', nome: 'Posts para o feed', desc: 'Artes com a sua cara, que param o dedo de quem está rolando.' },
  { id: 'car', nome: 'Carrosséis', desc: 'Conteúdo em sequência que ensina, convence e é salvo.' },
  { id: 'sto', nome: 'Stories', desc: 'Enquetes, caixinhas e bastidores para conversar todo dia.' },
  { id: 'reel', nome: 'Reels', desc: 'Vídeos curtos que levam a sua marca para muito mais gente.' },
  { id: 'ads', nome: 'Anúncios', desc: 'Posts patrocinados com botão direto para o seu WhatsApp.' },
  { id: 'rel', nome: 'Relatório mensal', desc: 'O que deu certo no mês, explicado sem complicação.' },
];
// antes e depois do perfil: 9 posts soltos x 9 posts planejados (fotos de public/mock/)
const antes = ['burger', 'live-publico', 'salao', 'pizza', 'cafe', 'bone', 'acai', 'live-show', 'bolo'];
const depois: [string, string][] = [
  ['modelo', 'Nova coleção'], ['', 'Dica da semana'], ['fitness2', 'Bastidores'],
  ['', 'Promoção -20%'], ['cafe', 'Nosso espaço'], ['', 'Clientes felizes'],
  ['live-evento', 'Evento'], ['', 'Peça pelo WhatsApp'], ['jaqueta', 'Lançamento'],
];
// carrossel do hero, estilo post do Instagram (imagens escolhidas pelo cliente; perfis de terceiros:
// confirmar direito de uso antes do lançamento)
const slides: [string, number, number][] = [
  ['/mock/redes-perfil.webp', 736, 981], ['/mock/redes-perfil-2.webp', 800, 1000], ['/mock/redes-perfil-3.webp', 736, 920],
  ['/mock/redes-perfil-4.webp', 800, 1422], ['/mock/redes-perfil-5.webp', 784, 1347],
];
const incluso: [string, string, string][] = [
  ['calendar', 'Calendário de conteúdo', 'Você aprova o mês antes de publicar.'],
  ['star', 'Identidade visual', 'Feed bonito e com a mesma cara em todos os posts.'],
  ['message', 'Textos que vendem', 'Legendas curtas com chamada para o WhatsApp.'],
  ['video', 'Reels e Stories', 'Vídeos e bastidores para aparecer mais.'],
  ['trending', 'Relatório mensal e atendimento próximo', 'Alcance, seguidores e contatos do mês, explicados por quem cuida da sua marca.'],
];
const etapas = ['Conversa sobre a sua marca', 'Planejamento do mês para aprovação', 'Criação e publicação', 'Relatório e ajustes'];
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Gestão de redes sociais', serviceType: 'Gestão de redes sociais', provider: { '@type': 'ProfessionalService', name: config.nome }, areaServed: 'BR',
    offers: { '@type': 'Offer', priceCurrency: 'BRL', price: 400, description: 'Gestão de redes sociais a partir de R$ 400 por mês' } },
];
---
<Base title="Gestão de Redes Sociais - Planos a partir de R$ 400/mês | MKT Center"
  description="Fortaleça sua marca nas redes sociais com planejamento de conteúdo e gestão profissional. Conheça os planos da MKT Center para sua empresa."
  schema={schema} crumbs={[['Redes', '/redes-sociais/']]}>
  <HeroCrescimento
    rotulo="Redes sociais"
    linhas={[['Sua marca', 'ativa']]}
    destaque="sem você parar."
    texto="Planejamos, criamos e publicamos os posts, Reels e Stories da sua empresa, e transformamos seguidores em mensagens no seu WhatsApp."
    bt1={['Quero cuidar das redes', waLink(msg('gestão de redes sociais'))]}
    bt2={['Ver planos', '#tipos']}
    numeros={[[400, '', 'R$ por mês'], [30, '', 'R$ por post']]}
    rolarPara="#tipos"
  >
    <div slot="visual" class="rd-ig" id="rd-ig">
      <div class="rd-ig-cab">
        <span class="rd-ig-av"><img src="/icon-192.png" alt="" width="192" height="192" /></span>
        <span class="rd-ig-nome"><b>mktcenteroficial</b><small>São Paulo, SP</small></span>
        <span class="rd-ig-seguir">Seguir</span>
        <span class="rd-ig-mais" aria-hidden="true"><i></i><i></i><i></i></span>
      </div>
      <div class="rd-ig-trilho">
        {slides.map(([src, w, h], i) => (
          <img src={src} alt={`Exemplo de perfil nas redes sociais ${i + 1}`} width={w} height={h} decoding="async" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} />
        ))}
      </div>
      <button type="button" class="rd-ig-seta" data-dir="-1" aria-label="Imagem anterior">‹</button>
      <button type="button" class="rd-ig-seta" data-dir="1" aria-label="Próxima imagem">›</button>
      <div class="rd-ig-rod" aria-hidden="true">
        <span class="rd-ig-acoes">
          <span class="rd-ig-like"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3.4 5 7 5c2 0 3.4 1.1 5 3 1.6-1.9 3-3 5-3 3.6 0 5.8 3.6 4.5 6.8C19.5 16.4 12 21 12 21z"/></svg></span>
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.6-5.2A8.5 8.5 0 1 1 21 12z"/></svg>
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 3 9.5 14.5M22 3l-7 19-5.5-7.5L2 9z"/></svg>
        </span>
        <span class="rd-ig-pontos">{slides.map((_, i) => <i class={i === 0 ? 'on' : ''}></i>)}</span>
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rd-ig-salvar"><path d="M6 3h12v18l-6-4.5L6 21z"/></svg>
      </div>
      <div class="rd-ig-leg">
        <p class="rd-ig-curt"><svg viewBox="0 0 24 24" width="14" height="14" fill="#ed4956"><path d="M12 21s-7.5-4.6-9.5-9.2C1.2 8.6 3.4 5 7 5c2 0 3.4 1.1 5 3 1.6-1.9 3-3 5-3 3.6 0 5.8 3.6 4.5 6.8C19.5 16.4 12 21 12 21z"/></svg> Curtido por clientes e <b>outras pessoas</b></p>
        <p><b>mktcenteroficial</b> Perfis que vendem, todos os dias. <span>#redessociais #marketingdigital</span></p>
        <small>há 5 minutos</small>
      </div>
    </div>
  </HeroCrescimento>

  <section id="tipos" class="servicos-topo">
    <div class="wrap">
      <span class="eyebrow">Escolha o seu</span>
      <h2>Planos para as redes</h2>
      <div class="st-grid">
        {tipos.map((t) => (
          <article class={`st-card${t.destaque ? ' on' : ''}`}>
            {t.selo && <span class="st-selo">{t.selo}</span>}
            <h3>{t.nome}</h3>
            <p class="st-preco"><small>{t.de}</small>{t.preco}{t.per && <em>{t.per}</em>}</p>
            <p class="st-desc">{t.desc}</p>
            <ul>{t.itens.map((i) => <li>{i}</li>)}</ul>
            <a class="btn btn-primary st-bt" href={waLink(msg(t.nome))} target="_blank" rel="noopener">Quero este</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- antes e depois do perfil: arraste a linha -->
  <section>
    <div class="wrap vd-ad-wrap">
      <div class="vd-ad-txt">
        <span class="eyebrow">Antes e depois</span>
        <h2>Do perfil parado ao perfil que vende</h2>
        <p class="vd-lead">Arraste a linha e compare: posts soltos, sem padrão, contra um feed planejado, com a cara da sua marca e chamadas para o WhatsApp.</p>
        <ul class="vd-lista"><li>Cores e fontes da sua marca</li><li>Conteúdo variado e planejado</li><li>Chamada para ação em cada post</li></ul>
      </div>
      <div class="rd-ad" id="antes-depois" style="--x:50%">
        <div class="rd-perfil rd-depois">
          <div class="rd-topo"><i></i><span><b>suamarca</b><small>Sua empresa · Sua cidade</small><em>Peça pelo WhatsApp</em></span></div>
          <div class="rd-grade">
            {depois.map(([f, t], i) => (
              <span class={f ? 'rd-p' : `rd-p rd-p--txt rd-t${i % 3}`}>
                {f && <img src={`/mock/${f}.webp`} alt="" width="320" height="320" loading="lazy" decoding="async" />}
                <b>{t}</b>
              </span>
            ))}
          </div>
        </div>
        <div class="rd-perfil rd-antes">
          <div class="rd-topo"><i></i><span><b>suamarca</b><small>sem descrição</small></span></div>
          <div class="rd-grade">
            {antes.map((f) => <span class="rd-p"><img src={`/mock/${f}.webp`} alt="" width="320" height="320" loading="lazy" decoding="async" /></span>)}
          </div>
        </div>
        <span class="vd-ad-rot vd-ad-rot--a">Antes</span><span class="vd-ad-rot vd-ad-rot--d">Depois</span>
        <span class="vd-ad-linha"><i>‹ ›</i></span>
        <input type="range" min="0" max="100" value="50" aria-label="Comparar antes e depois do perfil" />
      </div>
    </div>
  </section>

  <section id="entregas">
    <div class="wrap">
      <span class="eyebrow">Ao vivo</span>
      <h2>O que entregamos</h2>
      <div class="vd-tec">
        {entregas.map((t) => (
          <article class="vd-card">
            <div class={`vd-demo rd-${t.id}`} aria-hidden="true">
              {t.id === 'post' && <><img src="/mock/modelo.webp" alt="" width="320" height="360" loading="lazy" decoding="async" /><span class="rd-faixa">Nova coleção</span><span class="rd-cora"></span></>}
              {t.id === 'car' && <><span class="rd-slides"><span class="rd-s1">5 dicas</span><span class="rd-s2"><b>1</b>Fotos com luz natural</span><span class="rd-s3"><b>2</b>Preço sempre visível</span><span class="rd-s1">Salve este post</span></span><span class="rd-pontos"><i></i><i></i><i></i><i></i></span></>}
              {t.id === 'sto' && <><img src="/mock/cafe.webp" alt="" width="480" height="240" loading="lazy" decoding="async" /><span class="rd-barras"><i></i><i></i><i></i></span><span class="rd-enq"><b>Qual você prefere?</b><span><i class="rd-a">Café</i><i class="rd-b">Cappuccino</i></span></span></>}
              {t.id === 'reel' && <>{['live-show', 'fitness2', 'modelo'].map((f, i) => <img class="rd-cl" src={`/mock/${f}.webp`} alt="" width="320" height="360" loading="lazy" decoding="async" style={`--i:${i}`} />)}<span class="rd-play"></span><span class="rd-lat"><i></i><i></i><i></i></span></>}
              {t.id === 'ads' && <><img src="/mock/burger.webp" alt="" width="160" height="160" loading="lazy" decoding="async" /><span class="rd-pat">Patrocinado</span><span class="rd-cta">Enviar mensagem no WhatsApp</span><span class="rd-dedo"></span></>}
              {t.id === 'rel' && <><span class="rd-graf"><b>Resultado do mês</b>{[38, 52, 46, 70, 88].map((h, i) => <i style={`--h:${h}%;--i:${i}`}></i>)}<small>Alcance · Seguidores · Mensagens</small></span></>}
            </div>
            <h3>{t.nome}</h3>
            <p>{t.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Em toda gestão</span>
      <h2>O que vem incluso</h2>
      <div class="grid grid-servicos sv-grid">
        {incluso.map(([i, t, d]) => (
          <div class="card"><span class="icone"><Icon name={i} /></span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Passo a passo</span>
      <h2>Como funciona</h2>
      <ol class="etapas">{etapas.map((e) => <li>{e}</li>)}</ol>
    </div>
  </section>

  <Depoimentos />
</Base>

<style>
  /* carrossel do hero dentro de uma moldura real de post do Instagram (branca), alinhada à direita do site */
  .rd-ig{position:relative;width:100%;max-width:500px;margin:0 0 0 auto;padding:0 0 14px;border-radius:10px;overflow:hidden;background:#fff;color:#262626;
    box-shadow:0 30px 60px -24px rgba(0,0,0,.9),0 0 70px -20px rgba(255,105,0,.5)}
  .rd-ig-cab{display:flex;align-items:center;gap:10px;padding:9px 12px}
  .rd-ig-av{flex:none;width:38px;height:38px;padding:2px;border-radius:50%;background:conic-gradient(#feda75,#fa7e1e,#d62976,#962fbf,#4f5bd5,#feda75)}
  .rd-ig-av img{display:block;width:100%;height:100%;border-radius:50%;border:2px solid #fff;background:#090a0c;object-fit:cover}
  .rd-ig-nome{display:flex;flex-direction:column;min-width:0}
  .rd-ig-nome b{font:700 14px var(--ff-txt);color:#262626}
  .rd-ig-nome small{font:400 12px var(--ff-txt);color:#737373}
  .rd-ig-seguir{margin-left:auto;padding:6px 16px;border-radius:8px;background:#0095f6;color:#fff;font:600 13px var(--ff-txt)}
  .rd-ig-mais{display:flex;gap:3px;padding:0 2px}
  .rd-ig-mais i{width:4px;height:4px;border-radius:50%;background:#262626}
  .rd-ig-trilho{display:flex;overflow-x:auto;aspect-ratio:15/13;background:#efefef;scrollbar-width:none;scroll-behavior:smooth}
  .rd-ig-trilho::-webkit-scrollbar{display:none}
  .rd-ig-trilho.encaixe{scroll-snap-type:x mandatory}
  .rd-ig-trilho img{flex:0 0 100%;width:100%;height:100%;object-fit:cover;object-position:50% 25%;scroll-snap-align:center}
  .rd-ig-seta{position:absolute;top:calc(62px + (100% - 62px - 150px) / 2);z-index:2;display:grid;place-items:center;width:30px;height:30px;margin-top:-15px;border:0;border-radius:50%;background:rgba(255,255,255,.9);color:#262626;font:700 20px/1 var(--ff-txt);cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.25);transition:opacity .2s}
  .rd-ig-seta[data-dir="-1"]{left:10px}
  .rd-ig-seta[data-dir="1"]{right:10px}
  .rd-ig-seta:disabled{opacity:0;pointer-events:none}
  .rd-ig-rod{position:relative;display:flex;align-items:center;padding:10px 12px 6px;color:#262626}
  .rd-ig-acoes{display:flex;gap:14px}
  .rd-ig-like{color:#ed4956;animation:rd-ig-like 4s ease-out infinite}
  .rd-ig-like svg{fill:#ed4956}
  @keyframes rd-ig-like{0%,70%,100%{transform:none}78%{transform:scale(1.25)}86%{transform:scale(.95)}}
  .rd-ig-salvar{margin-left:auto}
  .rd-ig-pontos{position:absolute;left:50%;display:flex;gap:4px;transform:translateX(-50%)}
  .rd-ig-pontos i{width:6px;height:6px;border-radius:50%;background:#c7c7c7;transition:background .2s}
  .rd-ig-pontos i.on{background:#0095f6}
  .rd-ig-leg{padding:0 14px;text-align:left}
  .rd-ig-leg p{margin:0 0 3px;font:400 13px/1.35 var(--ff-txt);color:#262626}
  .rd-ig-leg b{font-weight:700}
  .rd-ig-leg span{color:#00376b}
  .rd-ig-curt{display:flex;align-items:center;gap:6px}
  .rd-ig-leg small{font:400 11px var(--ff-txt);color:#737373;text-transform:uppercase;letter-spacing:.02em}
  @media(max-width:1023px){.rd-ig{margin:0 auto}}
  /* planos (mesmo visual das páginas Sites, Lojas e Vídeos) */
  .st-grid{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:768px){.st-grid{grid-template-columns:repeat(2,1fr)}}
  @media(min-width:1024px){.st-grid{grid-template-columns:repeat(4,1fr)}}
  .st-card{position:relative;display:flex;flex-direction:column;padding:24px 20px 20px;border-radius:var(--radius-lg);text-align:left;
    background:linear-gradient(160deg,rgba(28,29,33,.85),rgba(12,13,15,.9));border:1px solid rgba(255,255,255,.08);box-shadow:0 20px 40px -24px rgba(0,0,0,.9);overflow:hidden;transition:transform .3s,border-color .3s}
  .st-card::before{content:'';position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg,#ff6900,#ffb35c)}
  .st-card:hover{transform:translateY(-4px);border-color:rgba(255,105,0,.45)}
  .st-card.on{border-color:rgba(255,105,0,.6);box-shadow:0 0 40px -12px rgba(255,105,0,.6)}
  .st-selo{align-self:flex-start;margin-bottom:10px;padding:4px 10px;border-radius:99px;background:linear-gradient(90deg,#ff6900,#ffb35c);color:#141006;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .st-card h3{font-size:22px}
  .st-preco{margin-top:10px;font-family:var(--ff-tit);font-weight:800;font-size:36px;line-height:1;white-space:nowrap;background:linear-gradient(90deg,#ff8a24,#ffc993);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .st-preco small{display:block;font-family:var(--ff-txt);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#aeb4bd;-webkit-text-fill-color:#aeb4bd;margin-bottom:4px}
  .st-preco em{font-style:normal;font-size:18px;margin-left:2px}
  .st-desc{margin-top:12px;color:#aeb4bd;font-size:14px;line-height:22px}
  .st-card ul{list-style:none;margin:14px 0 20px;padding:0;display:grid;gap:8px}
  .st-card li{position:relative;padding-left:16px;font-size:14px;color:#e4e6ea}
  .st-card li::before{content:'';position:absolute;left:0;top:9px;width:6px;height:6px;border-radius:50%;background:#ff6900}
  .st-bt{margin-top:auto;width:100%}

  /* antes e depois (texto) */
  .vd-ad-wrap{display:grid;grid-template-columns:1fr 1.15fr;gap:40px;align-items:center}
  .vd-ad-txt{text-align:left}
  .vd-lead{color:#aeb4bd;font-size:16px;line-height:1.6;margin-top:12px}
  .vd-lista{list-style:none;padding:0;margin:18px 0 0;display:grid;gap:8px}
  .vd-lista li{position:relative;padding-left:18px;color:#e4e6ea}
  .vd-lista li::before{content:'';position:absolute;left:0;top:8px;width:7px;height:7px;border-radius:50%;background:#ff6900}
  .vd-ad-rot{position:absolute;top:3%;z-index:3;padding:4px 10px;border-radius:99px;font:700 11px var(--ff-txt);letter-spacing:.1em;text-transform:uppercase}
  .vd-ad-rot--a{left:3%;background:rgba(0,0,0,.7);color:#e4e6ea}
  .vd-ad-rot--d{right:3%;background:#ff6900;color:#141006}
  .vd-ad-linha{position:absolute;top:0;bottom:0;left:var(--x);z-index:3;width:2px;margin-left:-1px;background:#fff;box-shadow:0 0 12px rgba(0,0,0,.6);pointer-events:none}
  .vd-ad-linha i{position:absolute;left:50%;top:50%;display:grid;place-items:center;width:42px;height:42px;transform:translate(-50%,-50%);border-radius:50%;background:#ff6900;color:#141006;font:800 16px/1 var(--ff-txt);font-style:normal;box-shadow:0 6px 18px rgba(0,0,0,.5)}

  /* antes e depois: dois perfis do Instagram sobrepostos */
  .rd-ad{position:relative;max-width:520px;width:100%;margin:0 auto;border-radius:18px;overflow:hidden;background:#000;user-select:none;container-type:inline-size;
    box-shadow:0 0 0 1px rgba(255,255,255,.1),0 30px 60px -30px #000}
  .rd-perfil{padding:12cqw 3cqw 3cqw;background:#000}
  .rd-antes{position:absolute;inset:0;clip-path:inset(0 calc(100% - var(--x)) 0 0)}
  .rd-topo{display:flex;align-items:center;gap:4cqw;margin-bottom:3cqw}
  .rd-topo i{flex:none;width:16cqw;height:16cqw;border-radius:50%;background:#333}
  .rd-depois .rd-topo i{background:radial-gradient(circle,#090a0c 0 52%,transparent 54%),conic-gradient(#ff6900,#ffb35c,#e5202e,#ff6900)}
  .rd-topo span{display:flex;flex-direction:column;gap:.6cqw;min-width:0}
  .rd-topo b{color:#fff;font:700 4cqw var(--ff-txt)}
