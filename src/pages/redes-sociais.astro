<script>
  // carrossel do hero: setas, arraste, pontos e troca sozinha a cada 4 s (para quando a pessoa interage)
  const ig = document.getElementById('rd-ig');
  if (ig) {
    const trilho = ig.querySelector<HTMLElement>('.rd-ig-trilho')!;
    const setas = ig.querySelectorAll<HTMLButtonElement>('.rd-ig-seta');
    const pontos = ig.querySelectorAll('.rd-ig-pontos i');
    const total = pontos.length;
    const atual = () => Math.round(trilho.scrollLeft / trilho.clientWidth);
    const ir = (i: number) => trilho.scrollTo({ left: ((i + total) % total) * trilho.clientWidth });
    const atualizar = () => {
      const i = atual();
      pontos.forEach((p, j) => p.classList.toggle('on', j === i));
      setas[0].disabled = i === 0;
      setas[1].disabled = i === total - 1;
    };
    let timer = 0;
    const parar = () => { clearInterval(timer); trilho.classList.add('encaixe'); };
    setas.forEach((b) => b.addEventListener('click', () => { parar(); ir(atual() + Number(b.dataset.dir)); }));
    ['pointerdown', 'touchstart', 'wheel'].forEach((ev) => trilho.addEventListener(ev, parar, { once: true, passive: true }));
    trilho.addEventListener('scroll', atualizar, { passive: true });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) timer = window.setInterval(() => ir(atual() + 1), 4000);
    atualizar();
  }

  const ad = document.getElementById('antes-depois');
  const faixa = ad?.querySelector('input');
  if (ad && faixa) faixa.addEventListener('input', () => ad.style.setProperty('--x', `${faixa.value}%`));
</script>
