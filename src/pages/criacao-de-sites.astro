---
// Página "Sites" (criação de sites). Mesmo padrão visual da home: hero com os aparelhos, logos dos
// clientes, tipos de site com os preços reais, o que vem incluso, processo, depoimentos e 6 sites que criamos.
import Base from '../layouts/Base.astro';
import HeroCrescimento from '../components/HeroCrescimento.astro';
import Clientes from '../components/Clientes.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Icon from '../components/Icon.astro';
import CardPortfolio from '../components/CardPortfolio.astro';
import { projetos } from '../data/projetos';
import { config, waLink } from '../config';

const msg = (p: string) => `Olá! Quero um orçamento de ${p}.`;
const tipos = [
  { nome: 'Landing Page', preco: 'R$ 300', desc: 'Uma página direta para divulgar um produto, serviço ou campanha e levar o visitante ao WhatsApp.', itens: ['Página única', 'Botão de WhatsApp e formulário', 'Pensada para celular'] },
  { nome: 'Site Institucional', preco: 'R$ 600', desc: 'Presença completa para pequenas empresas e profissionais: quem você é, o que faz e como falar com você.', itens: ['Até 4 páginas', 'WhatsApp, formulário e mapa', 'Pronto para o Google'], destaque: true },
  { nome: 'Site Profissional', preco: 'R$ 1.000', desc: 'Estrutura maior para posicionar a sua marca e gerar contatos todos os dias.', itens: ['Mais páginas e seções', 'SEO e Analytics', 'Integrações'] },
];
// 5 cards no mesmo bento da home: 3 em cima, 1 comprido + 1 embaixo (o 5º é o comprido)
const incluso: [string, string, string][] = [
  ['smartphone', 'Feito para o celular', 'Abre rápido e funciona bem em qualquer tela.'],
  ['message', 'WhatsApp em um toque', 'Botões que levam o visitante direto para a conversa.'],
  ['trending', 'Pronto para o Google', 'Títulos, descrições e estrutura de SEO desde o início.'],
  ['globe', 'Domínio e HTTPS', 'Ajudamos com o endereço e o cadeado de segurança.'],
  ['star', 'Design com a sua marca e resultados medidos', 'Cores, logo e fotos do seu negócio, sem modelo pronto, e Analytics para você saber quantos contatos chegam.'],
];
const etapas = ['Conversa sobre o seu negócio', 'Proposta e layout para aprovação', 'Desenvolvimento e textos', 'Site no ar e acompanhamento'];
const exemplos = projetos.filter((p) => /institucional/i.test(p.tipo)); // só sites institucionais
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: 'Criação de sites', serviceType: 'Criação de sites', provider: { '@type': 'ProfessionalService', name: config.nome }, areaServed: 'BR',
    offers: tipos.map((t) => ({ '@type': 'Offer', name: t.nome, priceCurrency: 'BRL', price: Number(t.preco.replace(/\D/g, '')) })) }
];
---
<Base title="Criação de Sites em SP a partir de R$ 300 | MKT Center"
  description="Criação de sites profissionais em São Paulo: rápidos no celular e prontos para o Google. Landing page R$ 300 e site institucional R$ 600."
  schema={schema} crumbs={[['Sites', '/criacao-de-sites/']]}>
  <HeroCrescimento
    rotulo="Criação de sites"
    linhas={[['Sites', 'que'], ['trabalham', 'por']]}
    destaque="você 24h."
    texto="Criamos sites leves, bonitos no celular e prontos para o Google, que mostram o que você faz e levam o visitante direto para o seu WhatsApp."
    bt1={['Quero meu site', waLink(msg('um site'))]}
    bt2={['Ver preços', '#tipos']}
    numeros={[[300, '', 'R$ landing page'], [600, '', 'R$ site institucional'], [10, '+', 'anos criando sites']]}
    rolarPara="#tipos"
    sites={{
      desk: { nome: 'Sanremax', dominio: 'sanremax.com.br', tela: '/portfolio/sanremax-desk.webp', w: 800, h: 1778, logo: '/clientes/sanremax.webp' },
      lap: { nome: 'Rádio Conexão Católica', dominio: 'radioconexaocatolica.com.br', tela: '/portfolio/radio-lap.webp', w: 720, h: 1800, logo: '/clientes/radio-conexao-catolica.webp' },
      tab: { nome: 'Pousada Anchieta', dominio: 'Cachoeira Paulista', tela: '/portfolio/pousada-tab.webp', w: 480, h: 2125, logo: '/clientes/pousada-anchieta.webp' },
      cel: { nome: 'Doce Mix', dominio: 'Doce Mix Conveniência', tela: '/portfolio/doceencanto-cel.webp', w: 300, h: 2615, logo: '/portfolio/doceencanto-tab.webp' },
    }}
  />

  <section id="tipos" class="servicos-topo">
    <div class="wrap">
      <span class="eyebrow">Escolha o seu</span>
      <h2>Tipos de site</h2>
      <div class="st-grid">
        {tipos.map((t) => (
          <article class={`st-card${t.destaque ? ' on' : ''}`}>
            {t.destaque && <span class="st-selo">Mais escolhido</span>}
            <h3>{t.nome}</h3>
            <p class="st-preco"><small>A partir de</small>{t.preco}</p>
            <p class="st-desc">{t.desc}</p>
            <ul>{t.itens.map((i) => <li>{i}</li>)}</ul>
            <a class="btn btn-primary st-bt" href={waLink(msg(t.nome))} target="_blank" rel="noopener">Quero este</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Clientes />

  <section>
    <div class="wrap">
      <span class="eyebrow">Em todo site</span>
      <h2>O que vem incluso</h2>
      <div class="grid grid-servicos sv-grid">
        {incluso.map(([i, t, d]) => (
          <div class="card"><span class="icone"><Icon name={i} /></span><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Passo a passo</span>
      <h2>Como funciona</h2>
      <ol class="etapas">{etapas.map((e) => <li>{e}</li>)}</ol>
    </div>
  </section>

  <Depoimentos />

  <section>
    <div class="wrap">
      <div class="st-cab">
        <div><span class="eyebrow">Portfólio</span><h2>Sites institucionais que criamos</h2></div>
        <div class="st-setas"><button type="button" class="st-seta" data-dir="-1" aria-label="Sites anteriores"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg></button><button type="button" class="st-seta" data-dir="1" aria-label="Próximos sites"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></button></div>
      </div>
      <div class="st-pf" id="st-pf" tabindex="0" aria-label="Sites institucionais (role para o lado)">{exemplos.map((p) => <CardPortfolio {...p} />)}</div>
      <p class="st-mais"><a class="btn btn-ghost" href="/portfolio/">Ver todos os projetos</a></p>
    </div>
  </section>
</Base>

<style>
  .st-cab{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:20px}
  .st-cab h2{margin:0}
  .st-setas{display:flex;gap:8px}
  .st-seta{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.04);color:#fff;cursor:pointer;transition:border-color .2s,background .2s,opacity .2s}
  .st-seta:hover{border-color:#ff6900;background:rgba(255,105,0,.15)}
  .st-seta:disabled{opacity:.3;cursor:default;border-color:rgba(255,255,255,.18);background:transparent}
  /* carrossel: 4 cards menores no computador, 2 no tablet, 1 e um pedaço no celular */
  .st-pf{display:flex;gap:16px;overflow-x:auto;scroll-behavior:smooth;padding:4px 2px 18px;scrollbar-width:none;outline:none}
  .st-pf::-webkit-scrollbar{display:none}
  .st-pf.encaixe{scroll-snap-type:x mandatory}
  .st-pf>:global(*){flex:0 0 calc((100% - 48px)/4);scroll-snap-align:start}
  .st-pf :global(.pf p){-webkit-line-clamp:2}
  @media(max-width:1023px){.st-pf>:global(*){flex-basis:calc((100% - 16px)/2)}}
  @media(max-width:767px){.st-pf>:global(*){flex-basis:80%}.st-cab{justify-content:center;text-align:center}.st-setas{display:none}}
  .st-mais{margin-top:24px;text-align:center}
  .st-grid{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:768px){.st-grid{grid-template-columns:repeat(3,1fr)}}
  .st-card{position:relative;display:flex;flex-direction:column;padding:26px 24px 24px;border-radius:var(--radius-lg);text-align:left;
    background:linear-gradient(160deg,rgba(28,29,33,.85),rgba(12,13,15,.9));border:1px solid rgba(255,255,255,.08);box-shadow:0 20px 40px -24px rgba(0,0,0,.9);overflow:hidden;transition:transform .3s,border-color .3s}
  .st-card::before{content:'';position:absolute;left:0;right:0;top:0;height:3px;background:linear-gradient(90deg,#ff6900,#ffb35c)}
  .st-card:hover{transform:translateY(-4px);border-color:rgba(255,105,0,.45)}
  .st-card.on{border-color:rgba(255,105,0,.6);box-shadow:0 0 40px -12px rgba(255,105,0,.6)}
  .st-selo{align-self:flex-start;margin-bottom:10px;padding:4px 10px;border-radius:99px;background:linear-gradient(90deg,#ff6900,#ffb35c);color:#141006;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .st-card h3{font-size:24px}
  .st-preco{margin-top:10px;font-family:var(--ff-tit);font-weight:800;font-size:40px;line-height:1;background:linear-gradient(90deg,#ff8a24,#ffc993);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .st-preco small{display:block;font-family:var(--ff-txt);font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#aeb4bd;-webkit-text-fill-color:#aeb4bd;margin-bottom:4px}
  .st-desc{margin-top:12px;color:#aeb4bd;font-size:15px;line-height:23px}
  .st-card ul{list-style:none;margin:16px 0 22px;padding:0;display:grid;gap:8px}
  .st-card li{position:relative;padding-left:16px;font-size:14px;color:#e4e6ea}
  .st-card li::before{content:'';position:absolute;left:0;top:9px;width:6px;height:6px;border-radius:50%;background:#ff6900}
  .st-bt{margin-top:auto;width:100%}
  @media(max-width:767px){.st-card{text-align:center}.st-card li{text-align:left}.st-selo{align-self:center}}
</style>

<script>
  const trilho = document.getElementById('st-pf');
  if (trilho) {
    const setas = document.querySelectorAll<HTMLButtonElement>('.st-seta');
    const passo = () => ((trilho.firstElementChild as HTMLElement)?.offsetWidth || 260) + 16;
    const atualizar = () => {
      setas[0].disabled = trilho.scrollLeft < 4;
      setas[1].disabled = trilho.scrollLeft + trilho.clientWidth >= trilho.scrollWidth - 4;
    };
    const encaixe = () => trilho.classList.add('encaixe'); // scroll-snap só depois da 1ª interação (LCP)
    setas.forEach((b) => b.addEventListener('click', () => { encaixe(); trilho.scrollBy({ left: Number(b.dataset.dir) * passo(), behavior: 'smooth' }); }));
    ['pointerdown', 'touchstart', 'wheel', 'keydown'].forEach((ev) => trilho.addEventListener(ev, encaixe, { once: true, passive: true }));
    trilho.addEventListener('scroll', atualizar, { passive: true });
    addEventListener('resize', atualizar);
    atualizar();
  }
</script>
