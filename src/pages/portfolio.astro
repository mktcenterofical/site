    lap: ['/portfolio/nanodev-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/nanodev-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Roberto Pires', tipo: 'Marketing político', url: 'https://robertopires.com.br/',
    descricao: 'Site de candidatura a vereador na Zona Leste de SP, com biografia, propostas de cidades inteligentes e redes sociais.',
    lap: ['/portfolio/robertopires-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/robertopires-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Kimax Institucional', tipo: 'Site institucional', url: 'https://institucional.kimax.com.br/', logo: '/clientes/kimax.webp',
    descricao: 'Site institucional da Kimax, fabricante de produtos de limpeza, com linha de produtos, fornecimento e contato.',
    lap: ['/portfolio/kimaxinst-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/kimaxinst-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Peça Peça', tipo: 'Loja virtual', url: 'https://www.pecapeca.com.br/',
    descricao: 'Loja virtual de máquinas de costura, máquinas de corte, patchwork, agulhas e acessórios, com avaliações de clientes.',
    lap: ['/portfolio/pecapeca-lap.webp', 720, 905] as [string, number, number],
    cel: ['/portfolio/pecapeca-cel.webp', 300, 2028] as [string, number, number],
  },
  {
    nome: 'Doce Mix Conveniência', tipo: 'Loja virtual', url: 'https://doce-encanto-nu.vercel.app/',
    descricao: 'Loja de doces, balas, salgadinhos, sorvetes e bebidas: o cliente escolhe pelo celular e finaliza o pedido no WhatsApp.',
    lap: ['/portfolio/doceencanto-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/doceencanto-cel.webp', 300, 2615] as [string, number, number],
  },
];
---
<Base title="Portfólio de Sites e Projetos | MKT Center"
  description="Veja sites, lojas virtuais, aplicativos e campanhas feitos pela MKT Center. Peça o seu orçamento pelo WhatsApp."
  schema={schema} crumbs={[['Portfólio', '/portfolio/']]}>
  <HeroCrescimento
    rotulo="Portfólio · MKT Center"
    linhas={[['Projetos', 'que']]}
    destaque="geram resultado."
    texto="Sites, lojas virtuais, aplicativos, sistemas e campanhas criados para negócios reais. Cada projeto nasce de um desafio do cliente e termina com resultado na tela."
    bt1={['Quero um projeto assim', waLink('Olá! Vi o portfólio da MKT Center e quero um projeto assim.')]}
    bt2={['Ver projetos', '#projetos']}
    numeros={[[10, '', 'sites de clientes no ar'], [6, '', 'serviços'], [2013, '', 'desde']]}
    rolarPara="#projetos"
    sites={{
      desk: { nome: 'Kimax', dominio: 'kimax.com.br', tela: '/portfolio/kimax-desk.webp', w: 800, h: 1778, logo: '/clientes/kimax.webp' },
      lap: { nome: 'Pousada Anchieta', dominio: 'Cachoeira Paulista', tela: '/portfolio/pousada-lap.webp', w: 720, h: 1800, logo: '/clientes/pousada-anchieta.webp' },
      tab: { nome: 'Pugas News', dominio: 'pugasnews.com.br', tela: '/portfolio/pugas-tab.webp', w: 480, h: 2125, logo: '/clientes/pugas-news.webp' },
      cel: { nome: 'NanoDev', dominio: 'nanodev.com.br', tela: '/portfolio/nanodev-cel.webp', w: 300, h: 2615, logo: '/clientes/nanodev.webp' },
    }}
  />
  <section class="alt servicos-topo" id="projetos">
    <div class="wrap">
      <span class="eyebrow pf-ey">Nossos projetos</span>
      <h2 class="pf-h2">Sites que criamos</h2>
      <div class="pf-grade">
        {projetos.map((p) => <CardPortfolio {...p} />)}
      </div>
    </div>
  </section>
  <Precos />
</Base>

<style>
  .pf-ey,.pf-h2{text-align:left}
  .pf-h2{margin-bottom:24px}
  .pf-grade{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
  @media(max-width:1023px){.pf-grade{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:767px){.pf-grade{grid-template-columns:minmax(0,280px);justify-content:center}}
</style>
