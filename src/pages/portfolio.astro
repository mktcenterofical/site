---
import Base from '../layouts/Base.astro';
import HeroCrescimento from '../components/HeroCrescimento.astro';
import CardPortfolio from '../components/CardPortfolio.astro';
import Precos from '../components/Precos.astro';
import { waLink } from '../config';
import { projetos } from '../data/projetos';
const schema = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Portfólio MKT Center' }];
---
<Base title="Portfólio Digital - Sites, Lojas Virtuais e Aplicativos | MKT Center"
  description="Veja projetos digitais desenvolvidos pela MKT Center, incluindo sites profissionais, lojas virtuais e outras soluções para diferentes necessidades."
  schema={schema} crumbs={[['Portfólio', '/portfolio/']]}>
  <HeroCrescimento
    rotulo="Portfólio · MKT Center"
    linhas={[['Projetos', 'que']]}
    destaque="geram resultado."
    texto="Sites, lojas virtuais, aplicativos, sistemas e campanhas criados para negócios reais. Cada projeto nasce de um desafio do cliente e termina com resultado na tela."
    bt1={['Quero um projeto assim', waLink('Olá! Vi o portfólio da MKT Center e quero um projeto assim.')]}
    bt2={['Ver projetos', '#projetos']}
    numeros={[[10, '', 'sites de clientes no ar'], [6, '', 'serviços'], [2013, '', 'desde']]}
    rolarPara="#projetos"
    sites={{
      desk: { nome: 'Kimax', dominio: 'kimax.com.br', tela: '/portfolio/kimax-desk.webp', w: 800, h: 1778, logo: '/clientes/kimax.webp' },
      lap: { nome: 'Pousada Anchieta', dominio: 'Cachoeira Paulista', tela: '/portfolio/pousada-lap.webp', w: 720, h: 1800, logo: '/clientes/pousada-anchieta.webp' },
      tab: { nome: 'Pugas News', dominio: 'pugasnews.com.br', tela: '/portfolio/pugas-tab.webp', w: 480, h: 2125, logo: '/clientes/pugas-news.webp' },
      cel: { nome: 'NanoDev', dominio: 'nanodev.com.br', tela: '/portfolio/nanodev-cel.webp', w: 300, h: 2615, logo: '/clientes/nanodev.webp' },
    }}
  />
  <section class="alt servicos-topo" id="projetos">
    <div class="wrap">
      <span class="eyebrow pf-ey">Nossos projetos</span>
      <h2 class="pf-h2">Sites que criamos</h2>
      <div class="pf-grade">
        {projetos.map((p) => <CardPortfolio {...p} />)}
      </div>
    </div>
  </section>
  <Precos />
</Base>

<style>
  .pf-ey,.pf-h2{text-align:left}
  .pf-h2{margin-bottom:24px}
  .pf-grade{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
  @media(max-width:1023px){.pf-grade{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:767px){.pf-grade{grid-template-columns:minmax(0,280px);justify-content:center}}
</style>
