---
import Base from '../layouts/Base.astro';
import HeroCrescimento from '../components/HeroCrescimento.astro';
import CardPortfolio from '../components/CardPortfolio.astro';
import Precos from '../components/Precos.astro';
import { waLink } from '../config';
const schema = [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Portfólio MKT Center' }];
// sites reais criados pela MKT Center (prints em public/portfolio/)
const projetos = [
  {
    nome: 'RollerPort', tipo: 'Site institucional', url: 'https://rollerport.com.br/', logo: '/clientes/rollerport.webp',
    descricao: 'Site para fábrica de roletes, cavaletes e tambores para transportadores industriais, com catálogo de produtos e pedido de orçamento.',
    lap: ['/portfolio/rollerport-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/rollerport-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Pugas News', tipo: 'Portal de notícias', url: 'https://pugasnews.com.br/', logo: '/clientes/pugas-news.webp',
    descricao: 'Portal de notícias de Itatiba/SP com política, religião, saúde, cidade e utilidades como tempo, mercado, combustível e trânsito.',
    lap: ['/portfolio/pugas-lap.webp', 720, 1550] as [string, number, number],
    cel: ['/portfolio/pugas-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Rádio Conexão Católica', tipo: 'Web rádio', url: 'https://radioconexaocatolica.com.br/', logo: '/clientes/radio-conexao-catolica.webp',
    descricao: 'Web rádio católica 24 horas com player ao vivo, música, oração, liturgia e notícias da Igreja.',
    lap: ['/portfolio/radio-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/radio-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Pousada São José de Anchieta', tipo: 'Site de hospedagem', url: 'https://pousadasaojosedeanchieta.com.br/', logo: '/clientes/pousada-anchieta.webp',
    descricao: 'Pousada em Cachoeira Paulista para grupos nos eventos da Canção Nova, com acomodações, galeria e reserva pelo WhatsApp.',
    lap: ['/portfolio/pousada-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/pousada-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Kimax', tipo: 'Loja virtual', url: 'https://www.kimax.com.br/', logo: '/clientes/kimax.webp',
    descricao: 'Loja virtual de produtos de limpeza de Marília/SP, com vitrine por categoria, carrinho e pagamento por Pix, boleto e cartão.',
    lap: ['/portfolio/kimax-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/kimax-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Sanremax', tipo: 'Site institucional', url: 'https://sanremax.com.br/', logo: '/clientes/sanremax.webp',
    descricao: 'Site para representação comercial de rótulos BOPP, sleeves e adesivos, com áreas de atuação e o projeto de reciclagem Ecoflora.',
    lap: ['/portfolio/sanremax-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/sanremax-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Eletro Epi', tipo: 'Site institucional', url: 'https://eletroepi.com.br/', logo: '/clientes/eletroepi.webp',
    descricao: 'Site para revenda de materiais elétricos, com automação, SPDA e aterramento, catálogos e pedido de orçamento.',
    lap: ['/portfolio/eletroepi-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/eletroepi-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Nexcabos', tipo: 'Site institucional', url: 'https://nexcabos.com.br/', logo: '/clientes/nexcabos.webp',
    descricao: 'Site para fábrica de cabos elétricos de Sorocaba/SP, com linha de produtos, catálogo, certificados e pedido de orçamento.',
    lap: ['/portfolio/nexcabos-lap.webp', 720, 1800] as [string, number, number],
    cel: ['/portfolio/nexcabos-cel.webp', 300, 2615] as [string, number, number],
  },
  {
    nome: 'Igreja Ortodoxa Grega', tipo: 'Portal institucional', url: 'https://igrejaortodoxagregabrasil.com.br/', logo: '/clientes/igreja-ortodoxa.webp',
    descricao: 'Portal da Igreja Ortodoxa Grega no Brasil com fé, tradição, Divina Liturgia, comunidades, calendário e formação em português.',
