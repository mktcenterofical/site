---
import Base from '../layouts/Base.astro';
import { servicos, type Servico } from '../data/servicos';
import { config, waLink } from '../config';

export function getStaticPaths() {
  return servicos.filter((s) => !['criacao-de-sites', 'loja-virtual', 'marketing-politico'].includes(s.slug)).map((s) => ({ params: { servico: s.slug }, props: { s } })); // Sites, Lojas e Política têm página própria
}
const { s } = Astro.props as { s: Servico };
// Preços fictícios para apresentação
const tabela: Record<string, [string, string, string][]> = {
  'criacao-de-sites': [['Essencial', 'R$ 1.490', 'Site de 1 página, ideal para começar.'], ['Profissional', 'R$ 2.990', 'Até 6 páginas, blog e SEO local.'], ['Premium', 'R$ 4.990', 'Site completo com integrações e conteúdo.']],
  'aplicativos-e-sistemas': [['MVP', 'R$ 9.900', 'Primeira versão para validar a ideia.'], ['Negócio', 'R$ 19.900', 'App ou sistema completo com painel.'], ['Sob medida', 'Consulte', 'Projetos maiores e integrações.']],
  'loja-virtual': [['Start', 'R$ 2.490', 'Até 50 produtos, Pix e cartão.'], ['Pro', 'R$ 4.490', 'Produtos ilimitados e frete automático.'], ['Plus', 'R$ 7.990', 'Integrações, marketplace e anúncios.']],
  'trafego-e-seo': [['Local', 'R$ 890/mês', 'Google Meu Negócio e 1 campanha.'], ['Crescimento', 'R$ 1.590/mês', 'Google + Meta Ads e relatório mensal.'], ['Performance', 'R$ 2.990/mês', 'Campanhas avançadas e SEO contínuo.']],
  'marketing-politico': [['Pré-campanha', 'R$ 2.500/mês', 'Redes sociais e posicionamento.'], ['Campanha', 'R$ 6.900/mês', 'Site, redes, vídeos e impulsionamento.'], ['Mandato', 'R$ 3.900/mês', 'Comunicação e prestação de contas.']],
};
const planos = tabela[s.slug];
const msg =`Olá! Vim pelo site e quero um orçamento de ${s.nome}.`;
const schema: object[] = [{
  '@context': 'https://schema.org', '@type': 'Service', name: s.nome, description: s.description,
  provider: { '@type': 'ProfessionalService', name: config.nome }, areaServed: 'BR',
}];
if (s.faq.length) schema.push({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: s.faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
});
---
<Base title={s.title} description={s.description} schema={schema} crumbs={[[s.nome, `/${s.slug}/`]]}>
  <section class="hero" style="padding-top:8px">
    <div class="wrap">
      <span class="eyebrow">{s.nome}</span>
      <h1>{s.h1}</h1>
      <p class="lead">{s.intro}</p>
      <div class="acoes">
        <a class="btn btn-primary" href={waLink(msg)} target="_blank" rel="noopener">Pedir orçamento no WhatsApp</a>
        <a class="btn btn-ghost" href="/contato/">Preencher formulário</a>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>O que está incluso</h2>
      <ul class="lista">{s.itens.map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Como funciona</h2>
      <ol class="etapas">{s.etapas.map((e) => <li>{e}</li>)}</ol>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <h2>Investimento</h2>
      <div class="grid grid-planos">
        {planos.map(([nome, preco, desc], i) => (
          <div class="card" style={i === 1 ? 'border-color:var(--laranja)' : ''}>
            {i === 1 && <span class="eyebrow" style="margin:0 0 6px">Mais escolhido</span>}
            <h3>{nome}</h3>
            <p style="font-family:var(--ff-tit);font-size:2.2rem;color:var(--papel);margin-top:4px">{preco}</p>
            <p>{desc}</p>
            <a class={`btn ${i === 1 ? 'btn-primary' : 'btn-ghost'}`} style="margin-top:18px" href={waLink(`Olá! Tenho interesse no plano ${nome} de ${s.nome}.`)} target="_blank" rel="noopener">Quero este</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  {s.faq.length > 0 && (
    <section>
      <div class="wrap prose">
        <h2>Perguntas frequentes</h2>
        {s.faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>
  )}

</Base>
