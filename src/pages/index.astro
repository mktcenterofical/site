---
import Base from '../layouts/Base.astro';
import HeroCrescimento from '../components/HeroCrescimento.astro';
import Clientes from '../components/Clientes.astro';
import SecaoConexao from '../components/SecaoConexao.astro';
import FaixaInvisivel from '../components/FaixaInvisivel.astro';
import PorQue from '../components/PorQue.astro';
import Precos from '../components/Precos.astro';
import Secao10s from '../components/Secao10s.astro';
import Icon from '../components/Icon.astro';
import FaixaCTA from '../components/FaixaCTA.astro';
import { servicos } from '../data/servicos';
import { config, waLink } from '../config';
const schema = [
  { '@context': 'https://schema.org', '@type': 'ProfessionalService', name: config.nome, url: Astro.site!.href, areaServed: 'BR' },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: config.nome, url: Astro.site!.href, inLanguage: 'pt-BR' },
];
---
<Base title="Agência de Marketing Digital | MKT Center"
  description="Agência de marketing digital: criação de sites, apps, lojas virtuais, tráfego pago, SEO e marketing político. Fale no WhatsApp."
  schema={schema}>
  <HeroCrescimento />
  <section id="servicos" class="servicos-topo">
    <div class="wrap">
      <span class="eyebrow">O que fazemos</span>
      <h2>Serviços</h2>
      <div class="grid grid-servicos sv-grid">
        {servicos.map((s) => (
          <a class="card" href={`/${s.slug}/`}>
            <span class="icone"><Icon name={s.icone} /></span>
            <h3>{s.nome}</h3>
            <p>{s.curto}</p>
            <span class="mais">Saiba mais →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Secao10s />
  <Clientes />
  <SecaoConexao />
  <FaixaInvisivel />


  <PorQue />
  <Precos />

  <section class="alt">
    <div class="wrap">
      <span class="eyebrow">Clientes</span>
      <h2>Depoimentos</h2>
      <div class="grid">
        {[
          ['Depois do site novo, os pedidos pelo WhatsApp dobraram em dois meses.', 'Carla Mendes', 'Padaria Pão Dourado'],
          ['A loja virtual ficou simples de usar. Hoje vendo para o estado inteiro.', 'Rafael Souza', 'RS Moda Fitness'],
          ['Equipe atenciosa, entregou no prazo e explicou tudo sem complicação.', 'Dra. Juliana Prado', 'Clínica Sorriso Vivo'],
        ].map(([t, n, e]) => (
          <figure class="card">
            <div style="color:var(--orange);display:flex;gap:2px" role="img" aria-label="5 estrelas">{[1,2,3,4,5].map(() => <Icon name="star" size={18} />)}</div>
            <blockquote style="margin-top:10px">“{t}”</blockquote>
            <figcaption style="margin-top:14px;color:var(--prata)"><strong style="color:var(--papel)">{n}</strong> · {e}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <FaixaCTA />
</Base>
