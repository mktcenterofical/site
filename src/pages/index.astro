---
import Base from '../layouts/Base.astro';
import HeroCrescimento from '../components/HeroCrescimento.astro';
import Clientes from '../components/Clientes.astro';
import SecaoConexao from '../components/SecaoConexao.astro';
import FaixaInvisivel from '../components/FaixaInvisivel.astro';
import PorQue from '../components/PorQue.astro';
import Precos from '../components/Precos.astro';
import Depoimentos from '../components/Depoimentos.astro';
import Secao10s from '../components/Secao10s.astro';
import Icon from '../components/Icon.astro';
import { servicos } from '../data/servicos';
import { config, waLink } from '../config';
const site = Astro.site!.href;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'ProfessionalService', '@id': site + '#empresa',
    name: config.nome, url: site, logo: site + 'icon-512.png', taxID: config.cnpj, image: site + 'og.png',
    description: 'Agência de marketing digital em São Paulo: criação de sites, lojas virtuais, aplicativos, tráfego pago, SEO, redes sociais e marketing político.',
    telephone: '+' + config.whatsapp, email: config.email, priceRange: 'R$',
    address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressRegion: 'SP', addressCountry: 'BR' },
    areaServed: [{ '@type': 'City', name: 'São Paulo' }, { '@type': 'Country', name: 'Brasil' }],
    openingHours: 'Mo-Fr 09:00-18:00',
    hasOfferCatalog: {
      '@type': 'OfferCatalog', name: 'Serviços de marketing digital',
      itemListElement: [
        ['Landing Page', 300], ['Site Institucional', 600], ['Site Profissional', 1000],
        ['Gestão de Redes Sociais', 400], ['Edição de Vídeos', 50], ['Criação de Posts', 30],
      ].map(([n, p]) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: n }, priceSpecification: { '@type': 'PriceSpecification', price: p, priceCurrency: 'BRL', minPrice: p } })),
    },
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': site + '#site', name: 'MKT Center Marketing Digital', alternateName: ['MKT Center', 'MKT Center Marketing'], url: site, inLanguage: 'pt-BR', publisher: { '@id': site + '#empresa' } },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: 'Serviços da MKT Center',
    itemListElement: servicos.map((sv, i) => ({ '@type': 'ListItem', position: i + 1, name: sv.nome, url: site + sv.slug + '/' })),
  },
];
---
<Base title="Agência de Marketing Digital - Estratégias para Empresas em SP | MKT Center"
  description="A MKT Center ajuda empresas a crescer com criação de sites, lojas virtuais, gestão de redes sociais, tráfego pago e estratégias de SEO."
  schema={schema}>
  <HeroCrescimento />
  <section id="servicos" class="servicos-topo">
    <div class="wrap">
      <span class="eyebrow">O que fazemos</span>
      <h2>Serviços</h2>
      <div class="grid grid-servicos sv-grid">
        {servicos.map((s) => (
          <a class="card" href={`/${s.slug}/`}>
            <span class="icone"><Icon name={s.icone} /></span>
            <h3>{s.nome}</h3>
            <p>{s.curto}</p>
            <span class="mais">Saiba mais →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Secao10s />
  <Clientes />
  <SecaoConexao />
  <FaixaInvisivel />


  <PorQue />
  <Precos />

  <Depoimentos />

</Base>
